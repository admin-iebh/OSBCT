{"“bhikkhu":[{"l":"So sakuṇasaṁgho “bhikkhu pattaṁ yācatī","g":"ettha na te sakuṇā bhikkhuno vacanaṁ jānanti.","v":"02VinA02","n":345,"p":152,"s":null,"w":5,"k":["bhikh","pat","s","sakunasamgh","yacat"],"q":1}],"“bhaṇāhī”ti":[{"l":"Manussānaṁ pana “bhaṇāhī”ti vattuṁ vaṭṭatī","g":"ettha uccatare nisinnenapi manussānaṁ bhaṇāhīti visesetvāyeva vattuṁ vaṭṭati, avisesetvā pana na vaṭṭati.","v":"03ViT03","n":150,"p":276,"s":"Ādittapariyāyasuttavaṇṇanā","w":5,"k":["bhanah","manus","p","t","vat","vatat"]}],"“bhikkhaṁ":[{"l":"Nimantiyamāno vā “bhikkhaṁ gahessāmī”ti vadatī","g":"“bhattaṁ gaṇhā”ti nimantiyamāno “na mayhaṁ tava bhattena attho, bhikkhaṁ gahessāmī”ti bhaṇati.","v":"07ViT07","n":null,"p":382,"s":null,"w":5,"k":["bhikh","gahes","nimantiy","t","v","vadat"]}],"“brāhmaṇan":[{"l":"taṁ ahaṁ “brāhmaṇan","g":"vadāmīti.","v":"45KhuA26","n":122,"p":261,"s":null,"w":3,"k":["ah","brah","t"],"q":1}],"“brāhmaṇaṁ":[{"l":"taṁ ahaṁ “brāhmaṇan","g":"vadāmīti.","v":"45KhuA26","n":122,"p":261,"s":null,"w":3,"k":["ah","brah","t"],"q":1}]}