a atthaṅgamo, iti vedanā, iti saññā, iti saṅkhārā, iti viññāṇaṁ, iti viññāṇassa samudayo, iti viññāṇassa atthaṅgamo’ti. Yepi te bhikkhave devā dīghāyukā vaṇṇavanto sukhabahulā uccesu vimānesu ciraṭṭhitikā, tepi tathāgatassa dhammadesanaṁ sutvā yebhuyyena bhayaṁ saṁvegaṁ santāsaṁ āpajjanti ‘aniccāva kira bho mayaṁ samānā niccamhāti amaññimha, addhuvāva -pa- asassatāva kira bho mayaṁ samānā sassatamhāti amaññimha, mayampi kira bho aniccā addhuvā asassatā sakkāyapariyāpannā1’ti”– evaṁ devānaṁ bhayuppatti āgatā.","v":"26VsmT02","n":695,"p":391,"s":"Sambahulasuttantasaṁsandanākathāvaṇṇanā","w":3,"k":["dev","sihopamasut","viy"]}],"sīhānan":[{"l":"sīhānan","g":"sīhasaddo “sīho bhikkhave migarājā”ti-ādīsu2 migarāje āgato.","v":"29KhuA10","n":null,"p":5,"s":null,"w":1,"k":["sih"]}],"sīhānaṁ":[{"l":"sīhānan","g":"sīhasaddo “sīho bhikkhave migarājā”ti-ādīsu2 migarāje āgato.","v":"29KhuA10","n":null,"p":5,"s":null,"w":1,"k":["sih"]}],"sīhānaṁvā":[{"l":"sīhānaṁvā","g":"sīhānaṁ iva.","v":"29KhuA10","n":null,"p":5,"s":null,"w":1,"k":["sihanamv"]},{"l":"sīhānaṁvā","g":"nidassanavacanaṁ8.","v":"29KhuA10","n":null,"p":5,"s":null,"w":1,"k":["sihanamv"]},{"l":"sīhānaṁvā","g":"sīhasadisānaṁ viya.","v":"29KhuA10","n":null,"p":5,"s":null,"w":1,"k":["sihanamv"]}],"sīhānaṁva":[{"l":"sīhānaṁvā","g":"sīhānaṁ iva.","v":"29KhuA10","n":null,"p":5,"s":null,"w":1,"k":["sihanamv"]},{"l":"sīhānaṁvā","g":"nidassanavacanaṁ8.","v":"29KhuA10","n":null,"p":5,"s":null,"w":1,"k":["sihanamv"]},{"l":"sīhānaṁvā","g":"sīhasadisānaṁ viya.","v":"29KhuA10","n":null,"p":5,"s":null,"w":1,"k":["sihanamv"]}],"Sīhānaṁvā":[{"l":"Sīhānaṁvā","g":"ca sambandhe sāmivacanaṁ.","v":"29KhuA10","n":null,"p":5,"s":null,"w":1,"k":["sihanamv"]}],"Sīhānaṁva":[{"l":"Sīhānaṁvā","g":"ca sambandhe sāmivacanaṁ.","v":"29KhuA10","n":null,"p":5,"s":null,"w":1,"k":["sihanamv"]}],"Sīha’ppamatto":[{"l":"Sīha’ppamatto viharā","g":"āyasmato Sīhattherassa gāthā.","v":"29KhuA10","n":null,"p":225,"s":null,"w":2,"k":["siha’pamat","vihar"]}],"sīhaca