{"n’eva":[{"l":"Taṁ pakkamanto n’eva uddhareyya na uddharāpeyyā","g":"attano vā uddharitvā patirūpe ṭhāne na ṭhapeyya, parena vā tathā na kārāpeyya.","v":"05Kankha","n":null,"p":201,"s":null,"w":6,"k":["","n’ev","pakamant","t","udharapey","udharey"]},{"l":"n’eva vūpakāseyyā","g":"na gahetvā gaccheyya.","v":"05Kankha","n":null,"p":344,"s":null,"w":2,"k":["n’ev","vupakasey"]},{"l":"so n’eva taṁ abhisaṅkharotī","g":"Yathā hi cheko bhisakko visavikāraṁ disvā vamanaṁ kāretvā visaṁ ṭhānato cāvetvā upari āropetvā khandhaṁ vā sīsaṁ vā gahetuṁ adatvā visaṁ otāretvā pathaviyaṁ pāteyya, evameva Bhagavā kulaputtassa arūpāvacarajjhāne vaṇṇaṁ kathesi.","v":"13MaA04","n":362,"p":211,"s":"Dhātuvibhaṅgasuttavaṇṇanā","w":4,"k":["abhisankharot","n’ev","s","t"],"h":1},{"l":"n’eva abhisaṅkharotī","g":"nāyūhati na rāsiṁ karoti.","v":"13MaA04","n":362,"p":211,"s":"Dhātuvibhaṅgasuttavaṇṇanā","w":2,"k":["abhisankharot","n’ev"]}],"N’eva":[{"l":"N’eva anuggaṇheyyā","g":"sayaṁ uddesādīhi nānuggaṇheyya.","v":"05Kankha","n":null,"p":344,"s":null,"w":2,"k":["anuganhey","n’ev"]},{"l":"N’eva dāyakato","g":"ettha Vaḍḍhamānavāsiluddako kathetabbo.","v":"13MaA04","n":381,"p":226,"s":"Dakkhiṇāvibhaṅgasuttavaṇṇanā","w":2,"k":["dayakat","n’ev"]}],"N’ānubandheyyā":[{"l":"N’ānubandheyyā","g":"cuṇṇena mattikāya dantakaṭṭhena mukhodakenāti evaṁ tena tena karaṇīyena na upaṭṭhaheyya.","v":"05Kankha","n":null,"p":344,"s":null,"w":1,"k":["n’anubandhey"]}],"N’ānubandheyya":[{"l":"N’ānubandheyyā","g":"cuṇṇena mattikāya dantakaṭṭhena mukhodakenāti evaṁ tena tena karaṇīyena na upaṭṭhaheyya.","v":"05Kankha","n":null,"p":344,"s":null,"w":1,"k":["n’anubandhey"]}],"n’evasaññīnāsaññī":[{"l":"n’evasaññīnāsaññī","g":"iminā aṭṭha n’evasaññīnāsaññīvādā,","v":"13MaA04","n":21,"p":10,"s":"Pañcattayasuttavaṇṇanā","w":1,"k":["n’evasaninas"],"t":1}],"n’evasaññīnāsaññi":[{"l":"n’evasaññīnāsaññī","g":"iminā aṭṭha n’evasaññīnāsaññīvādā,","v":"13MaA04","n":21,"p":10,"s":"Pañcattayasuttavaṇṇanā","w":1,"k":["n’evasaninas"],"t":1}],"N’a