{"hissa":[{"l":"visākhapuṇṇamāyaṁ hissa abhisekamakaṁsū","g":", pubbe katābhisekassapi asokaraññā pesitena anagghena parihārena visākhapuṇṇamāyaṁ puna abhisekamakaṁsūti attho.","v":"01ViT01","n":null,"p":149,"s":null,"w":3,"k":["abhisekamakams","his","visakhapunamay"],"q":1},{"l":"Tathā hissā","g":"imassa “sabbathā vidito”ti etena sambandho.","v":"01ViT01","n":1,"p":195,"s":null,"w":2,"k":["his","tath"]},{"l":"Āvikatā hissa phāsu hotī","g":"kissa phāsu hoti, paṭhamassa jhānassa adhigamāya phāsu hoti, dutiyassa jhānassa adhigamāya phāsu hoti, tatiyassa jhānassa adhigamāya phāsu hoti, catutthassa jhānassa adhigamāya phāsu hoti, jhānānaṁ vimokkhānaṁ samādhīnaṁ samāpattīnaṁ nekkhammānaṁ nissaraṇānaṁ pavivekānaṁ kusalānaṁ dhammānaṁ adhigamāya phāsu hotīti.","v":"03Vin03","n":135,"p":141,"s":null,"w":4,"k":["avikat","his","hot","phas"]},{"l":"na hissa tasmiṁ samaye","g":"Pahīnassa puna appahātabbatāya pakaṭṭhaṁ hānaṁ cajanaṁ samucchindanaṁ pahānaṁ, pahānameva vuttanayena paṭivedhoti pahānapaṭivedho.","v":"13MaT01","n":21,"p":160,"s":"Sabbāsavasuttavaṇṇanā","w":4,"k":["","his","samay","tas"],"q":1,"h":1},{"l":"Yā hissa bhante saddhā","g":"ayaṁ katarasaddhā? Catūhi indriyehi sampayuttā saddhā heṭṭhā kathitāva, ayaṁ pana paccavekkhaṇasaddhā.","v":"16SamA03","n":520,"p":279,"s":"Āpaṇasuttavaṇṇanā","w":4,"k":["bhant","his","sadh","y"]},{"l":"Diṭṭhi hissa bhikkhave pāpikā","g":"yasmā tassa puggalassa diṭṭhi pāpikā lāmikā.","v":"17AnA01","n":306,"p":370,"s":null,"w":4,"k":["bhikhav","dith","his","papik"]},{"l":"Yaṁ hissa","g":"yaṁ cakkhundriyasaṁvaraṁ assa bhikkhuno asaṁvutassa athaketvā apidahitvā viharantassāti attho.","v":"19AnA03","n":58,"p":127,"s":"Āsavasuttavaṇṇanā","w":2,"k":["his","y"],"h":1},{"l":"Yaṁ hissā","g":"yaṁ hi cīvaraṁ piṇḍapātādīsu vā aññataraṁ assa.","v":"19AnA03","n":58,"p":127,"s":"Āsavasuttavaṇṇanā","w":2,"k":["his","y"]},{"l":"Yaṁ hissā","g":"sītādīsu yaṁkiñci ekadhammampi assa.","v":"19AnA03","n":58,"p":127,"s":"Āsavasuttavaṇṇanā","w":2,"k":["his","y"]},{"l":"Yaṁ hissā","g":"hatthi-ādīsu yaṁkiñci ekampi assa.","v":"19AnA03","n":58,"p":127,"s":"Āsavasuttavaṇṇanā","w":2,"k":["his","y"]},{"l":"Yaṁ hissā","g":"etesu vitakkesu yaṁkiñci assa.","v":"19AnA03","n":58,"p":127,"s":"Āsavasuttavaṇṇanā","w":2,"k":["his","y"]},{"l":"Yaṁ hissa","g":"etesu bojjhaṅgesu yaṁkiñci assa.","v":"19AnA03","n":58,"p":127,"s":"Āsavasuttavaṇṇanā","w":2,"k":["his","y"]},{"l":"Na hissa tādisan","g":"na hi assa tādiso, ayameva vā pāṭho.","v":"37KhuA18","n":160,"p":201,"s":null,"w":3,"k":["","his","tadis"]},{"l":"Sā hissa paramā","g":"yā daliddassa sāmikassa daliddakāle sayampi daliddī hutvā taṁ na pariccajati.","v":"38KhuA19","n":80,"p":64,"s":null,"w":3,"k":["his","par","s"]},{"l":"Diṭṭhi hissa pāpikā","g":"kāraṇavissajjanaṁ.","v":"47KhuA28","n":127,"p":46,"s":null,"w":3,"k":["dith","his","papik"]},{"l":"Diṭṭhi hissa pāpikā","g":"yasmā assa puggalassa diṭṭhi pāpikā, tasmā na mahapphalaṁ hotīti attho.","v":"47KhuA28","n":127,"p":46,"s":null,"w":3,"k":["dith","his","papik"]},{"l":"Bījaṁ hissā","g":"assa nimbādikassa bījaṁ.","v":"47KhuA28","n":127,"p":46,"s":null,"w":2,"k":["bij","his"]},{"l":"Yā hissa pubbe avimuttassā","g":"yā tassa khīṇāsavassa pubbe arahattavimuttiyā avimuttassa vimuttāsā1 ahosi, sā paṭippassaddhā, tasmā na evaṁ hoti.","v":"50AbhiA03","n":93,"p":58,"s":null,"w":4,"k":["avimutas","his","pub","y"]}],"hissā":[{"l":"Tathā hissā","g":"imassa “sabbathā vidito”ti etena sambandho.","v":"01ViT01","n":1,"p":195,"s":null,"w":2,"k":["his","tath"]},{"l":"Yaṁ hissā","g":"yaṁ hi cīvaraṁ piṇḍapātādīsu vā aññataraṁ assa.","v":"19AnA03","n":58,"p":127,"s":"Āsavasuttavaṇṇanā","w":2,"k":["his","y"]},{"l":"Yaṁ hissā","g":"sītādīsu yaṁkiñci ekadhammampi assa.","v":"19AnA03","n":58,"p":127,"s":"Āsavasuttavaṇṇanā","w":2,"k":["his","y"]},{"l":"Yaṁ hissā","g":"hatthi-ādīsu yaṁkiñci ekampi assa.","v":"19AnA03","n":58,"p":127,"s":"Āsavasuttavaṇṇanā","w":2,"k":["his","y"]},{"l":"Yaṁ hissā","g":"etesu vitakkesu yaṁkiñci assa.","v":"19AnA03","n":58,"p":127,"s":"Āsavasuttavaṇṇanā","w":2,"k":["his","y"]},{"l":"Bījaṁ hissā","g":"assa nimbādikassa bījaṁ.","v":"47KhuA28","n":127,"p":46,"s":null,"w":2,"k":["bij","his"]}],"hissāmī":[{"l":"Idha hissāmī","g":"imasmiṁyeva ṭhāne jīvitaṁ jahissāmīti.","v":"39KhuA20","n":107,"p":416,"s":null,"w":2,"k":["his","idh"]}],"hissāmi":[{"l":"Idha hissāmī","g":"imasmiṁyeva ṭhāne jīvitaṁ jahissāmīti.","v":"39KhuA20","n":107,"p":416,"s":null,"w":2,"k":["his","idh"]}],"Hissāmā":[{"l":"Hissāmā","g":"jīvitaṁ khippaṁ jahissāma, alaṅkatapāsādoyeva no dārucitako bhavissati.","v":"41KhuA22","n":671,"p":289,"s":null,"w":1,"k":["his"]}],"Hissāma":[{"l":"Hissāmā","g":"jīvitaṁ khippaṁ jahissāma, alaṅkatapāsādoyeva no dārucitako bhavissati.","v":"41KhuA22","n":671,"p":289,"s":null,"w":1,"k":["his"]}]}