{"Ga":[{"l":"Go","g":"hi paññāyetaṁ adhivacanaṁ gacchati atthe bujjhatīti.","v":"11DiT04","n":305,"p":225,"s":"Mahāgovindasutta","w":1,"k":["g"],"q":1},{"l":"Go","g":"hi pathaviyā nāmaṁ, tasmā evamāha.","v":"12MaA03","n":457,"p":297,"s":"Vāseṭṭhasuttavaṇṇanā","w":1,"k":["g"]},{"l":"Go","g":"hi paññāyetaṁ adhivacanaṁ “gacchati atthe bujjhatī”ti katvā.","v":"20AnT03","n":54,"p":118,"s":"Dhammikasuttavaṇṇanā","w":1,"k":["g"]},{"l":"Go","g":"ekassa kira kassakassa rattibhāge niddaṁ okkantassa vaja bhinditvā goṇā palātā, so paccūsasamaye tattha gantvā olokento tesaṁ palātabhāvaṁ ñatvā anupadaṁ gantvā rañño goṇe addasa.","v":"52Vism02","n":793,"p":303,"s":"Sambahulasuttantasaṁsandanā","w":1,"k":["g"]}],"gā":[{"l":"Paripuṇṇacā gā","g":"samattacāgā, uḷārassa mahassa pariyattapariccāgā.","v":"27KhuA08","n":1264,"p":325,"s":null,"w":2,"k":["g","paripunac"]}],"ga":[{"l":"Paripuṇṇacā gā","g":"samattacāgā, uḷārassa mahassa pariyattapariccāgā.","v":"27KhuA08","n":1264,"p":325,"s":null,"w":2,"k":["g","paripunac"]}]}