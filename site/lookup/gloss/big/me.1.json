madayad"]},{"l":"Atha kho asuyeva me purimo bhikkhū","g":"yo purimo bhikkhu tampi piṇḍapātaṁ paṭikkhipitvā samaṇadhammaṁ karoti, soyeva mama dvīsu sūresu sūrataro viya dvīsu paṇḍitesu paṇḍitataro viya ca pujjataro ca pāsaṁsataro ca, dutiyabhikkhuto atirekena pūjanīyo ca pasaṁsanīyo cāti vuttaṁ hoti.","v":"10MaA01","n":30,"p":96,"s":"Dhammadāyādasuttavaṇṇanā","w":6,"k":["","asuyev","ath","bhikh","kh","pur"]},{"l":"tasmātiha me bhikkhave","g":"Kiṁ vuttaṁ hoti, yasmā yo taṁ piṇḍapātaṁ bhuñjitvā samaṇadhammaṁ kareyya, so imehi pañcahi mūlaguṇehi paribāhiro.","v":"10MaA01","n":30,"p":96,"s":"Dhammadāyādasuttavaṇṇanā","w":3,"k":["","bhikhav","tasmatih"],"h":1},{"l":"Evaṁ me sutan","g":"Bhayabheravasuttaṁ.","v":"10MaA01","n":34,"p":113,"s":"Bhayabheravasuttavaṇṇanā","w":3,"k":["","ev","sut"]},{"l":"Tattha ca me brāhmaṇa viharato","g":"tathārūpesu senāsanesu yaṁ yaṁ manussānaṁ āyācana-upahārakaraṇārahaṁ yakkhaṭṭhānaṁ pupphadhūpamaṁsaruhiravasāmedapihakapapphāsasurāmerayādīhi okiṇṇakilinnadharaṇi talaṁ ekanipātaṁ viya yakkharakkhasapisācānaṁ, yaṁ divāpi passantānaṁ hadayaṁ maññe phalati, taṁ ṭhānaṁ sandhāyāha “tattha ca me brāhmaṇa viharato”ti.","v":"10MaA01","n":49,"p":122,"s":"Bhayabheravasuttavaṇṇanā","w":5,"k":["","brah","c","tath","viharat"]},{"l":"āraddhaṁ kho pana me brāhmaṇā","g":"Keci panāhu “imaṁ asammohavihāraṁ sutvā brāhmaṇassa cittamevaṁ uppannaṁ ‘kāya nu kho paṭipadāya imaṁ patto’ti, tassa cittamaññāya imāyāhaṁ paṭipadāya imaṁ uttamaṁ asammohavihāraṁ pattoti dassento evamāhā”ti.","v":"10MaA01","n":51,"p":127,"s":"Bhayabheravasuttavaṇṇanā","w":5,"k":["","aradh","brah","kh","p"],"h":1},{"l":"āraddhaṁ kho pana me brāhmaṇa vīriyaṁ ahosī","g":"brāhmaṇa na mayā ayaṁ uttamo asammohavihāro kusītena muṭṭhassatinā sāraddhakāyena vikkhittacittena vā adhigato, Api ca kho tadadhigamāya āraddhaṁ kho pana me vīriyaṁ ahosi, Bodhimaṇḍe nisinnena mayā caturaṅgavīriyaṁ āraddhaṁ ahosi, paggahitaṁ asithilappavattitanti vuttaṁ hoti.","v":"10MaA01","n":51,"p":127,"s":"Bhayabheravasuttavaṇṇanā","w":7,"k":["","ahos","aradh","brah","kh","p","viriy"]},{"l":"Ayaṁ kho me brāhmaṇā","g":"ayaṁ ca appanāvāro tattha anāgatoti ayameva viseso.","v":"10MaA01","n":52,"p":129,"s":"Bhayabheravasuttavaṇṇanā","w":4,"k":["","ay","brah","kh"]},{"l":"Tassa me evaṁ jānato evaṁ passato","g":"tassa mayhaṁ evaṁ jānantassa evaṁ passantassa.","v":"10MaA01","n":54,"p":131,"s":"Bhayabheravasuttavaṇṇanā","w":6,"k":["","ev","ev","janat","pasat","tas"]},{"l":"Evaṁ me sutaṁ -pa- āyasmā Sāriputto","g":"Anaṅgaṇasuttaṁ.","v":"10MaA01","n":57,"p":142,"s":"Anaṅgaṇasuttavaṇṇanā","w":6,"k":["","ayas","ev","p","sariput","sut"]},{"l":"Atthi me ajjhattaṁ aṅgaṇanti yathābhūtaṁ nappajānātī","g":"mayhaṁ attano cittasantāne kileso atthītipi na jānāti.","v":"10MaA01","n":57,"p":142,"s":"Anaṅgaṇasuttavaṇṇanā","w":6,"k":["","ajhat","anganant","ath","napajanat","yathabhut"]},{"l":"Natthi me ajjhattaṁ aṅgaṇanti yathābhūtaṁ nappajānātī","g":"“mayhaṁ kilesā yena vā tena vā vāritattā natthi, na maggena samūhatattā”ti na jānāti, “te uppajjamānā mahā-anatthaṁ karissanti kakkhaḷā vāḷā visaduṭṭhasallasadisā”ti evaṁ yāthāvasarasatopi na jānāti.","v":"10MaA01","n":57,"p":142,"s":"Anaṅgaṇasuttavaṇṇanā","w":6,"k":["","ajhat","anganant","napajanat","nath","yathabhut"]},{"l":"Evaṁ me sutan","g":"Ākaṅkheyyasuttaṁ.","v":"10MaA01","n":64,"p":158,"s":"Ākaṅkheyyasuttavaṇṇanā","w":3,"k":["","ev","sut"]},{"l":"Evaṁ me sutan","g":"Vatthasuttaṁ.","v":"10MaA01","n":70,"p":170,"s":"Vatthasuttavaṇṇanā","w":3,"k":["","ev","sut"]},{"l":"Evaṁ me sutan","g":"Sallekhasuttaṁ.","v":"10MaA01","n":81,"p":185,"s":"Sallekhasuttavaṇṇanā","w":3,"k":["","ev","sut"]},{"l":"Evaṁ me sutan","g":"Sammādiṭṭhisuttaṁ.","v":"10MaA01","n":89,"p":199,"s":"Sammādiṭṭhisuttavaṇṇanā","w":3,"k":["","ev","sut"]},{"l":"Evaṁ me sutan","g":"Satipaṭṭhānasuttaṁ.","v":"10MaA01","n":105,"p":230,"s":"Satipaṭṭhānasuttavaṇṇanā","w":3,"k":["","ev","sut"]},{"l":"Evaṁ me sutan","g":"Cūḷasīhanādasuttaṁ1.","v":"10MaA01","n":139,"p":307,"s":"Cūḷasīhanādasuttavaṇṇanā"