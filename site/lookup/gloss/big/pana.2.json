.","v":"03ViT03","n":2,"p":456,"s":null,"w":4,"k":["apajat","apat","kay","p"]},{"l":"udāne panā","g":"āraddhaṁ.","v":"03ViT03","n":3,"p":141,"s":null,"w":2,"k":["p","ud"],"q":1,"h":1},{"l":"idaṁ kho pana bhikkhave","g":"Tattha1","v":"03ViT03","n":14,"p":171,"s":"Dhammacakkappavattanasuttavaṇṇanā","w":4,"k":["bhikhav","id","kh","p"],"t":1,"q":1,"h":1},{"l":"idaṁ kho pana bhikkhave dukkhasamudayan","g":"Tattha saṁ-iti ayaṁ saddo “samāgamo sametan”ti-ādīsu saṁyogaṁ dīpeti, u-iti ayaṁ “uppannaṁ uditan”ti-ādīsu uppattiṁ.","v":"03ViT03","n":14,"p":171,"s":"Dhammacakkappavattanasuttavaṇṇanā","w":5,"k":["bhikhav","dukhasamuday","id","kh","p"],"q":1,"h":1},{"l":"idaṁ kho pana bhikkhave dukkhanirodhan","g":"Tattha yasmā ni-saddo abhāvaṁ, rodhasaddo ca cārakaṁ dīpeti, tasmā abhāvo ettha saṁsāracārakasaṅkhātassa dukkharodhassa sabbagatisuññattā, samadhigate vā tasmiṁ saṁsāracārakasaṅkhātassa dukkharodhassa abhāvo hoti tappaṭipakkhattātipi “dukkhanirodhan”ti vuccati.","v":"03ViT03","n":14,"p":171,"s":"Dhammacakkappavattanasuttavaṇṇanā","w":5,"k":["bhikhav","dukhanirodh","id","kh","p"],"q":1,"h":1},{"l":"idaṁ kho pana bhikkhave dukkhanirodhagāminī","g":"Yasmā panetaṁ ariyasaccaṁ dukkhanirodhaṁ gacchati ārammaṇavasena tadabhimukhabhūtattā, paṭipadā ca hoti dukkhanirodhappattiyā, tasmā “dukkhanirodhagāminī paṭipadā”ti vuccati.","v":"03ViT03","n":14,"p":171,"s":"Dhammacakkappavattanasuttavaṇṇanā","w":5,"k":["bhikhav","dukhanirodhag","id","kh","p"],"q":1,"h":1},{"l":"Ñāṇañca pana me dassanaṁ udapādī","g":"adhigataguṇānaṁ yāthāvato dassanasamatthaṁ paccavekkhaṇa ñāṇañca pana me udapādi.","v":"03ViT03","n":16,"p":179,"s":"Dhammacakkappavattanasuttavaṇṇanā","w":5,"k":["","das","nananc","p","udapad"]},{"l":"Imasmiñca pana veyyākaraṇasmin","g":"imasmiṁ niggāthake sutte.","v":"03ViT03","n":16,"p":179,"s":"Dhammacakkappavattanasuttavaṇṇanā","w":3,"k":["imasminc","p","veyakaranas"]},{"l":"tena kho pana samayenā","g":"āraddhaṁ.","v":"03ViT03","n":25,"p":191,"s":"Anattalakkhaṇasuttavaṇṇanā","w":4,"k":["kh","p","samay","t"],"q":1,"h":1},{"l":"tena kho pana samayena sambahulā therā","g":"Citto gahapati tesaṁ āgamanaṁ sutvā addhayojanamattaṁ paccuggantvā te ādāya attano vihāraṁ pavesetvā āgantukavattaṁ katvā “bhante thokaṁ dhammakathaṁ sotukāmomhī”ti dhammasenā patiṁ yāci.","v":"03ViT03","n":33,"p":366,"s":null,"w":6,"k":["kh","p","samay","sambahul","t","ther"],"q":1,"h":1},{"l":"Yadi pana na gaṇhāti na vissajjetī","g":"yadi purimadivase attano na gaṇhāti gahetvā ca na vissajjeti.","v":"03ViT03","n":75,"p":369,"s":null,"w":6,"k":["","","ganhat","p","visajet","yad"]},{"l":"Pabbajja-upasampadadhammantevāsikehi pana -pa- tāva vattaṁ kātabban","g":"pabbajjācariya-upasampadācariyadhammācariyānaṁ etehi yathāvuttavattaṁ kātabbaṁ.","v":"03ViT03","n":80,"p":237,"s":"Ādittapariyāyasuttavaṇṇanā","w":6,"k":["katab","p","p","pabaja-upasampadadhamantevasikeh","tav","vat"]},{"l":"sace panā","g":"Sace hi avisesena nakhapiṭṭhippamāṇaṁ avaḍḍhanakapakkhe ṭhitaṁ vaṭṭeyya, “nivāsanapārupanehi pakatipaṭicchanne ṭhāne”ti padesaniyamaṁ na kareyya, tasmā nivāsanapārupanehi pakatipaṭicchannaṭṭhānato aññattha nakhapiṭṭhippamāṇaṁ avaḍḍhanakapakkhe ṭhitampi na vaṭṭatīti siddhaṁ, nakhapiṭṭhippamāṇato khuddakataraṁ pana avaḍḍhanakapakkhe vaḍḍhanakapakkhe vā ṭhitaṁ hotu, vaṭṭati nakhapiṭṭhippamāṇato khuddakatarassa vaḍḍhanakapakkhe avaḍḍhanakapakkhe vā ṭhitassa mukhādīsuyeva paṭikkhittattā.","v":"03ViT03","n":88,"p":241,"s":"Ādittapariyāyasuttavaṇṇanā","w":2,"k":["p","sac"],"q":1,"h":1},{"l":"ubhayāni kho pana -pa- anubyañjanaso","g":"ettha “sabbopi cāyaṁ pabhedo mātikāṭṭhakathāyaṁ ñātāyaṁ ñāto hotī”ti tīsupi gaṇṭhipadesu vuttaṁ.","v":"03ViT03","n":103,"p":244,"s":"Ādittapariyāyasuttavaṇṇanā","w":5,"k":["anubyanjanas","kh","p","p","ubhay"]},{"l":"āpucchanaṁ pana vattan","g":"vuttaṁ, na pana vattabhedena dukkaṭanti dassanatthaṁ.","v":"03ViT03","n":118,"p":29,"s":null,"w":3,"k":["apuch","p","vat"],"q":1},{"l":"Sattāhaṁ vasissāmī”ti ālayaṁ karontena pana nissayo gahetabbo","g":"“sattāhamattaṁ vasissāmi, kiṁ bhikkhusabhāgatājānanenā”ti janane dhuraṁ nikkhipitvā vasituṁ na labhati, bhikkhusabhāgataṁ upaparikkhitvā nissayo gahetabboti attho.","v":"03ViT03","n":120,"p":265,"s":"Ādittapariyāyasuttavaṇṇanā","w":7,"k":["alay","gahetab","karont","nisay","p","satah","t","vasis"]},{"l":"Sace pana āsāḷīmāse -pa- tattha gantabban","g":"ettha sace so vassūpanāyikāya āsannāya gantukāmo suṇāti “asuko mahāthero āgamissatī”ti, tañce āgameti, vaṭṭati.","v":"03ViT03","n":121,"p":265,"s":"Ādittapariyāyasuttavaṇṇanā","w":6,"k":["asalimas","gantab","p","p","sac","tath"]},{"l":"Bhagavato pana vacanenā","g":"sampajānamusāvāde kiṁ hoti? “Dukkaṭaṁ hotī”ti iminā vacanena.","v":"03ViT03","n":135,"p":269,"s":"Ādittapariyāyasuttavaṇṇanā","w":3,"k":["bhagavat","p","vac"]},{"l":"Paṭibandhituṁ pana na sakkhissantevā","g":"khaṇḍa sīmāya aññātattā na sakkhissanti.","v":"03ViT03","n":144,"p":273,"s":"Ādittapariyāyasuttavaṇṇanā","w":4,"k":["","p","patibandhit","sakhisantev"]},{"l":"Ūnakaṁ pana na vaṭṭatī","g":"idampi udakukkhepasīmāya parisavasena vaḍḍhanato sīmāsambhedasaṅkā siyāti taṁnivāraṇatthameva vuttaṁ.","v":"03ViT03","n":147,"p":274,"s":"Ādittapariyāyasuttavaṇṇanā","w":4,"k":["","p","unak","vatat"]},{"l":"Gacchantiyā pana nāvāya kātuṁ na vaṭṭatī","g":"ettha udakukkhepamanatikkamitvā parivattamānāya kātuṁ vaṭṭatīti veditabbaṁ.","v":"03ViT03","n":147,"p":274,"s":"Ādittapariyāyasuttavaṇṇanā","w":6,"k":["","gachantiy","kat","navay","p","vatat"]},{"l":"Pāṭipadadivasato pana paṭṭhāya dhammasavanatthāya gantabban","g":"pāṭipadadivase ovādaggahaṇatthāya dutiyadivasato paṭṭhāya antarantarā dhammasavanatthāya gantabbaṁ.","v":"03ViT03","n":149,"p":43,"s":null,"w":5,"k":["dhamasavanathay","gantab","p","pathay","patipadadivasat"]},{"l":"Osāretvā pana kathentenā","g":"paṭhamaṁ ussāretvā pacchā atthaṁ kathentena.","v":"03ViT03","n":150,"p":276,"s":"Ādittapariyāyasuttavaṇṇanā","w":3,"k":["kathent","osaretv","p"]},{"l":"Manussānaṁ pana “bhaṇāhī”ti vattuṁ vaṭṭatī","g":"ettha uccatare nisinnenapi manussānaṁ bhaṇāhīti visesetvāyeva vattuṁ vaṭṭati, avisesetvā pana na vaṭṭati.","v":"03ViT03","n":150,"p":276,"s":"Ādittapariyāyasuttavaṇṇanā","w":5,"k":["bhanah","manus","p","t","vat","vatat"]},{"l":"Itarā pana biḷālasaṅkhalikapārisuddhi nāmā","g":"ettha keci vadanti “biḷālasaṅkhalikā baddhāva hoti antogehe eva sampayojanattā, yathā sā na katthaci gacchati, tathā sāpi na gacchatīti adhippāyo. Itarathā visesanaṁ niratthakaṁ hotī”ti.","v":"03ViT03","n":164,"p":278,"s":"Ādittapariyāyasuttavaṇṇanā","w":4,"k":["","bilalasankhalikaparisudh","itar","p"]},{"l":"Ācariyaṁ passissāmī”ti pana gantuṁ labhatī","g":"“agilānampi ācariyaṁ upajjhāyaṁ vā passissāmī”ti sattāhakaraṇīyena gantuṁ labhati.","v":"03ViT03","n":199,"p":282,"s":"Ādittapariyāyasuttavaṇṇanā","w":5,"k":["acariy","gant","labhat","p","pasis","t"]},{"l":"Sace pana naṁ ācariyo “ajja mā gacchā”ti vadati, vaṭṭatī","g":"evaṁ sattāhakaraṇīyena gataṁ antosattāheyeva puna āgacchantaṁ sace ācariyo upajjhāyo vā “ajja mā gacchā”ti vadati, vaṭṭati, sattāhātikkamepi anāpattīti adhippāyo, vassacchedo pana hotiyevāti daṭṭhabbaṁ sattāhassa bahiddhā vītināmitattā.","v":"03ViT03","n":199,"p":282,"s":"Ādittapariyāyasuttavaṇṇanā","w":9,"k":["","","acariy","aj","gach","p","sac","t","vadat","vatat"]},{"l":"Satthe pana vassaṁ upagantuṁ na vaṭṭatī","g":"kuṭikādīnaṁ abhāve1 “idha vassaṁ upemī”ti vacībhedaṁ katvā upagantuṁ na vaṭṭati, ālayakaraṇamatteneva vaṭṭatīti adhippāyo.","v":"03ViT03","n":203,"p":283,"s":"Ādittapariyāyasuttavaṇṇanā","w":6,"k":["","p","sath","upagant","vas","vatat"]},{"l":"Sace pana vuḍḍhataro hotī","g":"sace pavāraṇadāyako bhikkhu vuḍḍhataro hoti.","v":"03ViT03","n":203,"p":288,"s":"Ādittapariyāyasuttavaṇṇanā","w":4,"k":["hot","p","sac","vudhatar"]},{"l":"Ko pana vādo dvīhatīhaṁ vasitvā antosattāhe nivattantassā","g":"vassaṁ upagantvā dvīhatīhaṁ vasitvā sattāhakaraṇīyena gantvā antosattāhe nivattantassa ko pana vādo, kathā eva natthīti adhippāyo.","v":"03ViT03","n":207,"p":285,"s":"Ādittapariyāyasuttavaṇṇanā","w":7,"k":["antosatah","dvihatih","k","nivatantas","p","vad","vasitv"]}]}