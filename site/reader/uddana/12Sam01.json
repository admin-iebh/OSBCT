{"9": [{"label": null, "lines": ["Naḷavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Oghaṁ Nimokkhaṁ Upaneyyaṁ, Accenti Katichindi ca.", "Jāgaraṁ Appaṭividitā, Susammuṭṭhā Mānakāminā.", "Araññe dasamo vutto, vaggo tena pavuccati."], "app": []}], "19": [{"label": null, "lines": ["Nandanavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Nandanā Nandati ceva, Natthiputtasamena ca.", "Khattiyo Saṇamāno ca, Niddātandī ca Dukkaraṁ.", "Hirī Kuṭikā navamo, dasamo vutto Samiddhināti."], "app": []}], "29": [{"label": null, "lines": ["Sattivaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sattiyā Phusati ceva, Jaṭā Manonivāraṇā.", "Arahantena Pajjoto, Sarā Mahaddhanena ca.", "Catucakkena navamaṁ, Eṇijaṅghena te dasāti."], "app": []}], "39": [{"label": null, "lines": ["Satullapakāyikavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sabbhimaccharinā Sādhu, Na santujjhānasaññino.", "Saddhā Samayo Sakalikaṁ, ubho Pajjunnadhītaroti."], "app": []}], "49": [{"label": null, "lines": ["Ādittavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Ādittaṁ Kiṁdadaṁ Annaṁ, Ekamūla-anomiyaṁ.", "Accharāvanaropajetaṁ, Maccharena Ghaṭīkaroti."], "app": []}], "59": [{"label": null, "lines": ["Jarāvaggo chaṭṭho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Jarā Ajarasā Mittaṁ, Vatthu tīṇi Janāni ca.", "Uppatho ca Dutiyo ca, Kavinā pūrito vaggoti."], "app": []}], "69": [{"label": null, "lines": ["Addhavaggo1 sattamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Nāmaṁ Cittañca Taṇhā ca, Saṁyojanañca Bandhanā.", "Abbhāhatuḍḍito Pihito, Icchā Lokena te dasāti."], "app": []}], "80": [{"label": null, "lines": ["Chetvāvaggo aṭṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Chetvā Rathañca Cittañca, Vuṭṭhi Bhītā Najīrati.", "Issaraṁ Kāmaṁ Pātheyyaṁ, Pajjoto Araṇena cāti."], "app": []}, {"label": null, "lines": ["Devatāsaṁyuttaṁ samattaṁ."], "app": []}], "90": [{"label": null, "lines": ["Paṭhamo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Kassapā ca Māgho ca, Māgadho Dāmali Kāmado.", "Pañcālacaṇḍo Tāyano, Candimasūriyena te dasāti."], "app": []}], "100": [{"label": null, "lines": ["Anāthapiṇḍikavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Candimaso1 ca Veṇḍu2 ca, Dīghalaṭṭhi ca Nandano.", "Candano Vāsudatto ca, Subrahmā Kakudhena ca.", "Uttaro navamo vutto, dasamo Anāthapiṇḍikoti."], "app": []}], "110": [{"label": null, "lines": ["Nānātitthiyavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sivo Khemo ca Serī ca, Ghaṭī Jantu ca Rohito.", "Nando Nandivisālo ca, Susimo Nānātitthiyena te dasāti."], "app": []}, {"label": null, "lines": ["Devaputtasaṁyuttaṁ samattaṁ."], "app": []}], "120": [{"label": null, "lines": ["Paṭhamo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Daharo Puriso Jarā, Piyaṁ Attānarakkhito.", "Appakā Aḍḍakaraṇaṁ, Mallikā Yaññabandhananti."], "app": []}], "130": [{"label": null, "lines": ["Dutiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Jaṭilā Pañca rājāno, Doṇapākakurena ca.", "Saṅgāmena dve vuttāni, Mallikā2 dve Appamādena ca.", "Aputtakena dve vuttā, vaggo tena pavuccatīti."], "app": []}], "135": [{"label": null, "lines": ["Tatiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Puggalo Ayyikā Loko, Issattaṁ2 Pabbatūpamā.", "Desitaṁ Buddhaseṭṭhena, imaṁ Kosalapañcakanti."], "app": []}, {"label": null, "lines": ["Kosalasaṁyuttaṁ samattaṁ."], "app": []}], "145": [{"label": null, "lines": ["Paṭhamo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Tapokammañca Nāgo ca, Subhaṁ Pāsena te duve.", "Sappo Supati Nandanaṁ, Āyunā apare duveti."], "app": []}], "155": [{"label": null, "lines": ["Dutiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Pāsāṇo Sīho Sakalikaṁ2, Patirūpañca Mānasaṁ.", "Pattaṁ Āyatanaṁ Piṇḍaṁ, Kassakaṁ Rajjena te dasāti."], "app": []}], "160": [{"label": null, "lines": ["Tatiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sambahulā Samiddhi ca, Godhikaṁ Sattavassāni.", "Dhītaraṁ desitaṁ Buddha, seṭṭhena imaṁ Mārapañcakanti."], "app": []}, {"label": null, "lines": ["Mārasaṁyuttaṁ samattaṁ."], "app": []}], "170": [{"label": null, "lines": ["Bhikkhunīsaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Āḷavikā ca Somā ca, Gotamī Vijayā saha.", "Uppalavaṇṇā ca Cālā, Upacālā Sīsupacālā ca.", "Selā Vajirāya te dasāti."], "app": []}], "180": [{"label": null, "lines": ["Paṭhamo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Āyācanaṁ Gāravo Brahmadevo,", "Bako ca brahmā aparā ca diṭṭhi.", "Pamādakokālikatissako ca,", "Turū ca brahmā aparo ca Kokālikoti."], "app": []}], "185": [{"label": null, "lines": ["Dutiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Brahmāsanaṁ Devadatto, Andhakavindo Aruṇavatī.", "Parinibbānena ca desitaṁ, idaṁ brahmapañcakanti."], "app": []}, {"label": null, "lines": ["Brahmasaṁyuttaṁ samattaṁ2."], "app": []}], "186": [{"label": null, "lines": ["“Namo tassa Bhagavato Arahato Sammāsambuddhassa."], "app": []}, {"label": null, "lines": ["Namo tassa Bhagavato Arahato Sammāsambuddhassa."], "app": []}, {"label": null, "lines": ["Namo tassa Bhagavato Arahato Sammāsambuddhassā”ti."], "app": []}], "195": [{"label": null, "lines": ["Arahantavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dhanañjānī ca Akkosaṁ, Asurindaṁ Bilaṅgikaṁ.", "Ahiṁsakaṁ jaṭā ceva, Suddhikaṁ ceva Aggikā.", "Sundarikaṁ Bahudhītarena ca te dasāti."], "app": []}], "207": [{"label": null, "lines": ["Upāsakavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kasi Udayo Devahito, aññataramahāsālaṁ.", "Mānathaddhaṁ Paccanīkaṁ, Navakammi Kaṭṭhahāraṁ.", "Mātuposakaṁ Bhikkhako, Saṅgāravo ca Khomadussena dvādasāti."], "app": []}, {"label": null, "lines": ["Brāhmaṇasaṁyuttaṁ samattaṁ."], "app": []}], "219": [{"label": null, "lines": ["Vaṅgīsasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Nikkhantaṁ Arati ceva, Pesalā atimaññanā.", "Ānandena Subhāsitā, Sāriputtapavāraṇā.", "Parosahassaṁ Koṇḍañño, Moggallānena Gaggarā.", "Vaṅgīsena dvādasāti."], "app": []}], "233": [{"label": null, "lines": ["Vanasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Vivekaṁ Upaṭṭhānañca, Kassapagottena Sambahulā.", "Ānando Anuruddho ca, Nāgadattañca Kulagharaṇī.", "Vajjiputto ca Vesālī, Sajjhāyena ayoniso.", "Majjhanhikālamhi Pākatindriya-padumapupphena cuddasa bhaveti."], "app": []}], "245": [{"label": null, "lines": ["Yakkhasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Indako Sakka Sūci ca, Maṇibhaddo ca Sānu ca.", "Piyaṅkara Punabbasu Sudatto ca, dve Sukkā Cīra-āḷavīti dvādasa."], "app": []}], "255": [{"label": null, "lines": ["Paṭhamo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Suvīraṁ Susīmaṁ ceva, Dhajaggaṁ Vepacittino.", "Subhāsitaṁ jayaṁ ceva, Kulāvakaṁ Nadubbhiyaṁ.", "Verocana asurindo, isayo Araññakaṁ ceva.", "Isayo ca Samuddakāti."], "app": []}], "265": [{"label": null, "lines": ["Dutiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Devā pana4 tayo vuttā, Daliddañca Rāmaṇeyyakaṁ.", "Yajamānañca Vandanā, tayo Sakkanamassanāti."], "app": []}], "270": [{"label": null, "lines": ["Tatiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Chetvā Dubbaṇṇiya Māyā, Accayena Akodhano.", "Desitaṁ Buddhaseṭṭhena, idaṁ hi Sakkapañcakanti."], "app": []}, {"label": null, "lines": ["Sakkasaṁyuttaṁ samattaṁ."], "app": []}, {"label": null, "lines": ["Sagāthāvaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Devatā Devaputto ca, Rājā Māro ca Bhikkhunī.", "Brahmā Brāhmaṇa Vaṅgīso, Vanayakkhena Vāsavoti."], "app": []}, {"label": null, "lines": ["Sagāthāvaggasaṁyuttapāḷi niṭṭhitā."], "app": []}], "280": [{"label": null, "lines": ["Buddhavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Desanā Vibhaṅgapaṭipadā ca,", "Vipassī Sikhī ca Vessabhū.", "Kakusandho Koṇāgamano Kassapo,", "Mahāsakyamuni ca Gotamoti."], "app": []}], "290": [{"label": null, "lines": ["Āhāravaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Āhāraṁ Phagguno ceva, dve ca Samaṇabrāhmaṇā.", "Kaccānagotta Dhammakathikaṁ, Acelaṁ Timbarukena ca.", "Bālapaṇḍitato ceva, dasamo Paccayena cāti."], "app": []}], "300": [{"label": null, "lines": ["Dasabalavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Dasabalā Upanisā ca, Aññatitthiyabhūmijo.", "Upavāṇo Paccayo Bhikkhu, dve ca Samaṇabrāhmaṇāti."], "app": []}], "310": [{"label": null, "lines": ["Kaḷārakhattiyavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Bhūtamidaṁ Kaḷārañca, duve ca Ñāṇavatthūni.", "Avijjāpaccayā ca dve, Natumhā Cetanā tayoti."], "app": []}], "320": [{"label": null, "lines": ["Gahapativaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Pañcaverabhayā vuttā, Dukkhaṁ Loko ca Ñātikaṁ.", "Aññataraṁ Jāṇussoṇi ca, Lokāyatikena aṭṭhamaṁ.", "Dve Ariyasāvakā vuttā, vaggo tena pavuccatīti."], "app": []}], "330": [{"label": null, "lines": ["Dukkhavaggo chaṭṭho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Parivīmaṁsanupādānaṁ, dve ca Saṁyojanāni ca.", "Mahārukkhena dve vuttā, Taruṇena ca sattamaṁ.", "Nāmarūpañca Viññāṇaṁ, Nidānena ca te dasāti."], "app": []}], "340": [{"label": null, "lines": ["Mahāvaggo sattamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Assutavatā vuttā, Puttamaṁsena cāparaṁ.", "Atthirāgo ca Nagaraṁ, Sammasaṁ Naḷakalāpiyaṁ.", "Kosambī Upayanti ca, dasamo Susimena cāti2."], "app": []}], "342": [{"label": null, "lines": ["Samaṇabrāhmaṇavaggo aṭṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Paccayekādasa vuttā, Catusaccavibhajjanā.", "Samaṇabrāhmaṇavaggo, nidāne bhavati aṭṭhamo."], "app": []}, {"label": "Vagguddānaṁ", "lines": ["Buddho Āhāro Dasabalo, Kaḷāro Gahapatipañcamo.", "Dukkhavaggo Mahāvaggo, aṭṭhamo Samaṇabrāhmaṇoti."], "app": []}], "343": [{"label": null, "lines": ["Antarapeyyālo navamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": [], "app": []}, {"label": null, "lines": ["Suttantā antarapeyyālā niṭṭhitā."], "app": []}, {"label": null, "lines": ["Antarapeyyālesu uddānaṁ samattaṁ."], "app": []}, {"label": null, "lines": ["Nidānasaṁyuttaṁ samattaṁ."], "app": []}], "354": [{"label": null, "lines": ["Abhisamayasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Nakhasikhā Pokkharaṇī, Saṁbhejja-udake ca dve.", "Dve Pathavī dve Samuddā, tayo ca Pabbatūpamāti."], "app": []}], "364": [{"label": null, "lines": ["Nānattavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dhātuphassañca no cetaṁ, Vedanā apare duve.", "Etaṁ Ajjhattapañcakaṁ, Dhātusaññañca no cetaṁ.", "Phassassa apare duve, etaṁ Bāhirapañcakanti."], "app": []}], "370": [{"label": null, "lines": ["Chaṭṭhaṁ."], "app": []}], "376": [{"label": null, "lines": ["Dutiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sattimā Sanidānañca, Giñjakāvasathena ca.", "Hīnādhimutti Caṅkamaṁ, Sagāthā Assaddhasattamaṁ.", "Assaddhamūlakā pañca, cattāro Ahirikamūlakā.", "Anottappamūlakā tīṇi, duve Appassutena ca.", "Kusītaṁ ekakaṁ vuttaṁ, suttantā tīṇi pañcakā.", "Bāvīsati vuttā suttā, dutiyo vaggo pavuccatīti."], "app": []}], "383": [{"label": null, "lines": ["Kammapathavaggo tatiyo."], "app": []}], "393": [{"label": null, "lines": ["Catuttho vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Catasso Pubbe Acariṁ, Nocedaṁ ca Dukkhena ca.", "Abhinandañca Uppādo, tayo Samaṇabrāhmaṇāti."], "app": []}, {"label": null, "lines": ["Dhātusaṁyuttaṁ samattaṁ."], "app": []}], "403": [{"label": null, "lines": ["Dasamaṁ."], "app": []}, {"label": null, "lines": ["Paṭhamo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Tiṇakaṭṭhañca Pathavī, Assu Khīrañca Pabbataṁ.", "Sāsapā Sāvakā Gaṅgā, Daṇḍo ca Puggalena cāti."], "app": []}], "413": [{"label": null, "lines": ["Dasamaṁ."], "app": []}, {"label": null, "lines": ["Dutiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Duggataṁ Sukhitañceva, Tiṁsa Mātāpitena ca.", "Bhātā Bhaginī Putto ca, Dhītā Vepullapabbataṁ."], "app": []}, {"label": null, "lines": ["Anamataggasaṁyuttaṁ samattaṁ."], "app": []}], "426": [{"label": null, "lines": ["Kassapasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Santuṭṭhañca Anottappī, Candūpamaṁ Kulūpakaṁ.", "Jiṇṇaṁ tayo ca Ovādā, Jhānābhiññā Upassayaṁ.", "Cīvaraṁ Paraṁmaraṇaṁ, Saddhammappatirūpakanti."], "app": []}], "436": [{"label": null, "lines": ["Dasamaṁ."], "app": []}, {"label": null, "lines": ["Paṭhamo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dāruṇo Baḷisaṁ Kummaṁ, Dīghalomi ca Mīḷhakaṁ.", "Asani Diddhaṁ Siṅgālaṁ, Verambhena Sagāthakanti."], "app": []}], "439": [{"label": null, "lines": ["Dutiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Pāti dve Suvaṇṇā ca, Siṅgīhi apare duve.", "Pathavī Kiñcikkhajīvitaṁ, Janapadakalyāṇiyā dasāti."], "app": []}], "449": [{"label": null, "lines": ["Tatiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Mātugāmo ca Kalyāṇī, Putto ca Ekadhītu ca.", "Samaṇabrāhmaṇā tīṇi, Chavi Rajju ca Bhikkhunāti."], "app": []}], "454": [{"label": null, "lines": ["Pañcamaṁ."], "app": []}], "457": [{"label": null, "lines": ["Catuttho vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Bhindi Mūlaṁ duve Dhammā, Pakkantaṁ Ratha Mātari.", "Pitā Bhātā ca Bhaginī, Putto Dhītā Pajāpatīti."], "app": []}, {"label": null, "lines": ["Lābhasakkārasaṁyuttaṁ samattaṁ."], "app": []}], "467": [{"label": null, "lines": ["Paṭhamo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Cakkhu Rūpañca Viññāṇaṁ, Samphasso Vedanāya ca.", "Saññā Sañcetanā Taṇhā, Dhātu Khandhena te dasāti."], "app": []}], "471": [{"label": null, "lines": ["Dutiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Cakkhu Rūpañca Viññāṇaṁ, Samphasso Vedanāya ca.", "Saññā Sañcetanā Taṇhā, Dhātu Khandhena te dasa.", "Anusayaṁ Apagatañceva, vaggo tena pavuccatīti."], "app": []}, {"label": null, "lines": ["Rāhulasaṁyuttaṁ samattaṁ."], "app": []}], "481": [{"label": null, "lines": ["Paṭhamo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Aṭṭhi pesi ubho gāvaghātakā,", "Piṇḍo sākuṇiyo nicchavorabbhi.", "Asi sūkariko sattimāgavi,", "Usu kāraṇiko sūci sārathi.", "Yo ca sibbiyati sūcako hi so,", "Aṇḍabhāri ahu gāmakūṭakoti."], "app": []}], "492": [{"label": null, "lines": ["Dutiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kūpe nimuggo hi so pāradāriko,", "Gūthakhādi ahu duṭṭhabrāhmaṇo.", "Nicchavitthi aticārinī ahu,", "Maṅgulitthi ahu ikkhaṇitthikā.", "Okilini sapattaṅgārokiri,", "Sīsacchinno ahu coraghātako.", "Bhikkhu bhikkhunī sikkhamānā,", "Sāmaṇero atha sāmaṇerikā.", "Kassapassa vinayasmiṁ pabbajjaṁ,", "Pāpakammaṁ kariṁsu tāvadeti."], "app": []}], "504": [{"label": null, "lines": ["Opammasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kūṭaṁ Nakhasikhaṁ Kulaṁ, Okkhā Satti Dhanuggaho.", "Āṇi Kaliṅgaro Nāgo, Biḷāro dve Siṅgālakāti."], "app": []}], "508": [{"label": null, "lines": ["Catutthaṁ."], "app": []}], "509": [{"label": null, "lines": ["Pañcamaṁ."], "app": []}], "510": [{"label": null, "lines": ["Chaṭṭhaṁ."], "app": []}], "511": [{"label": null, "lines": ["Sattamaṁ."], "app": []}], "513": [{"label": null, "lines": ["Navamaṁ."], "app": []}], "514": [{"label": null, "lines": ["Dasamaṁ."], "app": []}], "515": [{"label": null, "lines": ["Ekādasamaṁ."], "app": []}], "516": [{"label": null, "lines": ["Dvādasamaṁ."], "app": []}, {"label": null, "lines": ["Bhikkhusaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kolito Upatisso ca, Ghaṭo cāpi pavuccati.", "Navo Sujāto Bhaddi ca, Visākho Nando Tisso ca.", "Theranāmo ca Kappino, Sahāyena ca dvādasāti."], "app": []}, {"label": null, "lines": ["Nidānavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Nidānābhisamayadhātu, Anamataggena Kassapaṁ.", "Sakkārarāhulalakkhaṇo, Opamma Bhikkhunā vaggo."], "app": []}, {"label": null, "lines": ["Dutiyo tena pavuccatīti."], "app": []}, {"label": null, "lines": ["Nidānavaggasaṁyuttapāḷi niṭṭhitā."], "app": []}]}