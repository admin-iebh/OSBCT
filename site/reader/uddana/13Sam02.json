{"10": [{"label": null, "lines": ["Nakulapituvaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Nakulapitā Devadahā, dvepi Hāliddikāni ca.", "Samādhipaṭisallāṇā, Upādāparitassanā duve.", "Atītānāgatapaccuppannā, vaggo tena pavuccati."], "app": []}], "20": [{"label": null, "lines": ["Aniccavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Aniccaṁ Dukkhaṁ Anattā, Yadaniccāpare tayo.", "Hetunāpi tayo vuttā, Ānandena ca te dasāti."], "app": []}], "21": [{"label": null, "lines": ["Paṭhamaṁ."], "app": []}], "31": [{"label": null, "lines": ["Bhāravaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Bhāraṁ Pariññaṁ Abhijānaṁ, Chandarāgaṁ catutthakaṁ.", "Assādā ca tayo vuttā, Abhinandanamaṭṭhamaṁ.", "Uppādaṁ Aghamūlañca, ekādasamo Pabhaṅgūti."], "app": []}], "41": [{"label": null, "lines": ["Natumhākavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Natumhākena dve vuttā, Bhikkhūhi apare duve.", "Ānandena ca dve vuttā, Anudhammehi dve dukāti."], "app": []}], "51": [{"label": null, "lines": ["Attadīpavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Attadīpā Paṭipadā, dve ca honti Aniccatā.", "Samanupassanā Khandhā, dve Soṇā dve Nandikkhayena cāti."], "app": []}, {"label": null, "lines": ["Mūlapaṇṇāsako samatto."], "app": []}], "61": [{"label": null, "lines": ["Majjhimapaṇṇāsakassa upayavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Upayo Bījaṁ Udānaṁ, Upādānaparivattaṁ.", "Sattaṭṭhānaṁ ca Sambuddho, Mañcamahāli Ādittā.", "Vaggo Niruttipathena cāti."], "app": []}], "71": [{"label": null, "lines": ["Arahantavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Upādiyamaññamānā, athābhinandamāno ca.", "Aniccaṁ Dukkhaṁ Anattā ca, Anattanīyaṁ Rajanīyasaṇṭhitaṁ.", "Rādhasurādhena te dasāti."], "app": []}], "75": [{"label": null, "lines": ["Catutthaṁ."], "app": []}], "77": [{"label": null, "lines": ["Chaṭṭhaṁ."], "app": []}], "78": [{"label": null, "lines": ["Sattamaṁ."], "app": []}], "81": [{"label": null, "lines": ["Dasamaṁ."], "app": []}, {"label": null, "lines": ["Khajjanīyavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Assādo dve Samudayā, Arahantehi apare dve.", "Sīho Khajjanī Piṇḍolyaṁ, Pālileyyena Puṇṇamāti."], "app": []}], "91": [{"label": null, "lines": ["Theravaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Ānando Tisso Yamako, Anurādho ca Vakkali.", "Assaji Khemako Channo, Rāhulā apare duve."], "app": []}], "94": [{"label": null, "lines": ["Tatiyaṁ."], "app": []}], "101": [{"label": null, "lines": ["Pupphavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Nadī Pupphañca Pheṇañca, Gomayañca Nakhāsikhaṁ.", "Suddhikaṁ dve ca Gaddulā, Vāsījaṭaṁ aniccatāti."], "app": []}, {"label": null, "lines": ["Majjhimapaṇṇāsako samatto."], "app": []}], "111": [{"label": null, "lines": ["Antavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Anto Dukkhañca Sakkāyo, Pariññeyyā Samaṇā duve.", "Sotāpanno Arahā ca, duve ca Chandappahānāti."], "app": []}], "124": [{"label": null, "lines": ["Dhammakathikavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Avijjā Vijjā dve Kathikā, Bandhanā Paripucchitā duve.", "Saṁyojanaṁ Upādānaṁ, Sīlaṁ Sutavā dve ca Kappenāti."], "app": []}], "134": [{"label": null, "lines": ["Avijjāvaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Samudayadhamme tīṇi, Assādo apare duve.", "Samudaye ca dve vuttā, Koṭṭhike apare tayoti."], "app": []}], "148": [{"label": null, "lines": ["Kukkuḷavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kukkuḷā tayo Aniccena, Dukkhena apare tayo.", "Anattena tayo vuttā, kulaputtena dve dukāti."], "app": []}], "158": [{"label": null, "lines": ["Diṭṭhivaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Ajjhattikaṁ Etaṁmama, So-attā Nocamesiyā.", "Micchāsakkāyattānu dve, Abhinivesā Ānandenāti."], "app": []}, {"label": null, "lines": ["Uparipaṇṇāsako samatto."], "app": []}, {"label": null, "lines": ["Khandhasaṁyuttaṁ samattaṁ."], "app": []}], "168": [{"label": null, "lines": ["Rādhasaṁyuttassa paṭhamo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Māro Satto Bhavanetti, Pariññeyyā Samaṇā duve.", "Sotāpanno Arahā ca, Chandarāgāpare duveti."], "app": []}], "180": [{"label": null, "lines": ["Dutiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Māro ca Māradhammo ca, Aniccena apare duve.", "Dukkhena ca duve vuttā, Anattena1 tatheva ca.", "Khayavayasamudayaṁ, Nirodhadhammena dvādasāti."], "app": []}], "192": [{"label": null, "lines": ["Āyācanavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Māroca Māradhammo ca, Aniccena apare duve.", "Dukkhena ca duve vuttā, Anattena tatheva ca.", "Khayavayasamudayaṁ, Nirodhadhammena dvādasāti."], "app": []}], "204": [{"label": null, "lines": ["Upanisinnavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Māro ca Māradhammo ca, Aniccena apare duve.", "Dukkhena ca duve vuttā, Anattena tatheva ca.", "Khayavayasamudayaṁ, Nirodhadhammena dvādasāti."], "app": []}, {"label": null, "lines": ["Rādhasaṁyuttaṁ samattaṁ."], "app": []}], "222": [{"label": null, "lines": ["Sotāpattivaggo."], "app": []}, {"label": null, "lines": ["Aṭṭhārasaveyyākaraṇaṁ niṭṭhitaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Vātaṁ Etaṁ mama, So attā No ca me siyā.", "Natthi Karoto Hetu ca, Mahādiṭṭhena aṭṭhamaṁ.", "Sassato loko ca, Asassato ca Antavā ca.", "Anantavā ca Taṁ jīvaṁ taṁ sarīranti,", "Aññaṁ jīvaṁ aññaṁ sarīranti ca.", "Hoti tathāgato paraṁ maraṇāti,", "Na hoti tathāgato paraṁ maraṇāti,", "Neva hoti na na hoti tathāgato paraṁ maraṇāti."], "app": []}], "233": [{"label": null, "lines": ["Dutiyapeyyālo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Vātaṁ Etaṁ mama, So attā No ca me siyā.", "Natthi Karoto Hetu ca, Mahādiṭṭhena aṭṭhamaṁ.", "Sassato Asassato ceva, Antānantavā ca vuccati.", "Taṁ jīvaṁ aññaṁ jīvañca, tathāgatena cattāro.", "Rūpī attā hoti Arūpī ca attā hoti,", "Rūpī ca arūpī ca attā hoti.", "Neva rūpī nārūpī attā hoti, Ekantasukhī attā hoti.", "Ekantadukkhī attā hoti, Sukhadukkhī attā hoti.", "Adukkhamasukhī attā hoti, arogo paraṁ maraṇāti.", "Ime chabbīsati suttā, dutiyavārena desitā."], "app": []}], "236": [{"label": null, "lines": ["Tatiyapeyyālo."], "app": []}], "239": [{"label": null, "lines": ["Diṭṭhisaṁyuttaṁ samattaṁ."], "app": []}], "249": [{"label": null, "lines": ["Okkantasaṁyuttaṁ1 samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Cakkhu Rūpañca Viññāṇaṁ, Phasso ca Vedanāya ca.", "Saññā ca Cetanā Taṇhā, Dhātu Khandhena te dasāti."], "app": []}], "259": [{"label": null, "lines": ["Uppādasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Cakkhu Rūpañca Viññāṇaṁ, Phasso ca Vedanāya ca.", "Saññā ca cetanā Taṇhā, Dhātu Khandhena te dasāti."], "app": []}], "269": [{"label": null, "lines": ["Kilesasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Cakkhu Rūpañca Viññāṇaṁ, Phasso ca Vedanāya ca.", "Saññā ca Cetanā Taṇhā, Dhātu Khandhena te dasāti."], "app": []}], "279": [{"label": null, "lines": ["Sāriputtasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Vivekajaṁ Avitakkaṁ, Pīti Upekkhā catutthakaṁ.", "Ākāsañceva Viññāṇaṁ, Ākiñcaṁ Nevasaññinā.", "Nirodho navamo vutto, dasamaṁ Sucimukhī cāti."], "app": []}], "291": [{"label": null, "lines": ["Nāgasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Suddhikaṁ Paṇītataraṁ, caturo ca Uposathā.", "Tassa Sutaṁ caturo ca, Dānūpakārā ca tālīsaṁ.", "Paṇṇāsa piṇḍato suttā, Nāgamhi suppakāsitāti."], "app": []}], "297": [{"label": null, "lines": ["Supaṇṇasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Suddhikaṁ Haranti ceva, Dvayakārī ca caturo.", "Dānūpakārā tālīsaṁ, Supaṇṇe suppakāsitāti."], "app": []}], "303": [{"label": null, "lines": ["Gandhabbakāyasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Suddhikaṁ ca Sucaritaṁ, Dātā hi apare dasa.", "Dānūpakārā satadhā, Gandhabbe suppakāsitāti."], "app": []}], "312": [{"label": null, "lines": ["Sattapaññāsasuttantaṁ niṭṭhitaṁ."], "app": []}, {"label": null, "lines": ["Valāhakasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Suddhikaṁ Sucaritañca, Dānūpakārapaññāsaṁ.", "Sītaṁ Uṇhañca Abbhañca, Vāta Vassavalāhakāti."], "app": []}], "327": [{"label": null, "lines": ["Vacchagottasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Aññāṇā Adassanā ceva, Anabhisamayā Ananubodhā.", "Appaṭivedhā Asallakkhaṇā, Anupalakkhaṇena Appaccupalakkhaṇā.", "Asamapekkhaṇā Appaccupekkhaṇā Appaccakkhakammanti."], "app": []}], "360": [{"label": null, "lines": ["Jhānasaṁyuttaṁ1 samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Samādhi Samāpatti Ṭhiti ca, Vuṭṭhānaṁ Kallitārammaṇena ca.", "Gocarā Abhinīhāro Sakkacca, Sātacca athopi Sappāyanti."], "app": []}, {"label": null, "lines": ["Khandhavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Khandha Rādhasaṁyuttañca, Diṭṭhi Okkanta1 Uppādā.", "Kilesa Sāriputtā ca, Nāgā Supaṇṇa Gandhabbā.", "Valāha Vaccha Jhānanti, Khandhavaggamhi terasāti."], "app": []}, {"label": null, "lines": ["Khandhavaggasaṁyuttapāḷi niṭṭhitā."], "app": []}], "372": [{"label": null, "lines": ["Aniccavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Aniccaṁ Dukkhaṁ Anattā ca, tayo ajjhattabāhirā.", "Yadaniccena tayo vuttā, te te ajjhattabāhirāti."], "app": []}], "382": [{"label": null, "lines": ["Yamakavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sambodhena duve vuttā, Assādena apare duve.", "No cetena duve vuttā, Abhinandena apare duve.", "Uppādena duve vuttā, vaggo tena pavuccatīti."], "app": []}], "392": [{"label": null, "lines": ["Sabbavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sabbaṁ ca dvepi Pahānā, Parijānāpare duve.", "Ādittaṁ Addhabhūtañca, Sāruppā dve ca Sappāyā.", "Vaggo tena pavuccatīti."], "app": []}], "402": [{"label": null, "lines": ["Jātidhammavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Jātijarābyādhimaraṇaṁ, Soko ca Saṁkilesikaṁ.", "Khayavayasamudayaṁ, Nirodhadhammena te dasāti."], "app": []}], "412": [{"label": null, "lines": ["Sabba-aniccavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Aniccaṁ Dukkhaṁ Anattā, Abhiññeyyaṁ Pariññeyyaṁ.", "Pahātabbaṁ Sacchikātabbaṁ, Abhiññeyyapariññeyyaṁ1.", "Upaddutaṁ Upassaṭṭhaṁ, vaggo tena pavuccatīti."], "app": []}, {"label": null, "lines": ["Saḷāyatanavagge paṭhamapaṇṇāsako samatto."], "app": []}], "422": [{"label": null, "lines": ["Avijjāvaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Avijjā Saṁyojanā dve, Āsavena duve vuttā.", "Anusayā apare dve, Pariññā dve Pariyādinnaṁ.", "Vaggo tena pavuccatīti."], "app": []}], "433": [{"label": null, "lines": ["Migajālavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Migajālena dve vuttā, cattāro ca Samiddhinā.", "Upaseno Upavāṇo, Chaphassāyatanikā tayoti."], "app": []}], "443": [{"label": null, "lines": ["Gilānavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Gilānena duve vuttā, Rādhena apare tayo.", "Avijjāya ca dve vuttā, Bhikkhu Loko ca Phaggunoti."], "app": []}], "453": [{"label": null, "lines": ["Channavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Palokasuññā Saṁkhittaṁ, Channo Puṇṇo ca Bāhiyo.", "Ejena ca duve vuttā, Dvayehi apare duveti."], "app": []}], "454": [{"label": null, "lines": ["Paṭhamaṁ."], "app": []}], "463": [{"label": null, "lines": ["Saḷavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve saṁgayhā Parihānaṁ, Pamādavihārī ca Saṁvaro.", "Samādhi Paṭisallānaṁ, dve Natumhākena Uddakoti."], "app": []}, {"label": null, "lines": ["Saḷāyatanavagge dutiyapaṇṇasako samatto."], "app": []}, {"label": null, "lines": ["Paṭhamasatakaṁ."], "app": []}], "473": [{"label": null, "lines": ["Yogakkhemivaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Yogakkhemi Upādāya, Dukkhaṁ Loko ca Seyyo ca.", "Saṁyojanaṁ Upādānaṁ, dve Parijānaṁ Upassutīti."], "app": []}], "483": [{"label": null, "lines": ["Lokakāmaguṇāvaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Mārapāsena dve vuttā, Lokakāmaguṇena ca.", "Sakko Pañcasikho ceva, Sāriputto ca Rāhulo.", "Saṁyojanaṁ Upādānaṁ, vaggo tena pavuccatīti."], "app": []}], "493": [{"label": null, "lines": ["Gahapativaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Vesālī Vajji Nāḷandā, Bhāradvāja Soṇo ca Ghosito.", "Hāliddiko Nakulapitā, Lohicco Verahaccānīti."], "app": []}], "496": [{"label": null, "lines": ["Tatiyaṁ."], "app": []}], "505": [{"label": null, "lines": ["Devadahavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Devadaho Khaṇo Rūpā, dve Natumhākameva ca.", "Hetunāpi tayo vuttā, duve Ajjhattabāhirāti."], "app": []}], "515": [{"label": null, "lines": ["Navapurāṇavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kammaṁ cattāri Sappāyā, Anantevāsi Kimatthiyā.", "Atthi nu kho pariyāyo, Indriyakathikena cāti."], "app": []}, {"label": null, "lines": ["Saḷāyatanavagge tatiyapaṇṇāsako samatto."], "app": []}], "527": [{"label": null, "lines": ["Nandikkhayavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Nandikkhayena cattāro, Jīvakambavane duve.", "Koṭṭhikena tayo vuttā, Micchā Sakkāya attanoti."], "app": []}], "557": [{"label": null, "lines": ["Saṭṭhipeyyālo samatto."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Chandenaṭṭhārasa honti, Atītena ca dve nava.", "Yadaniccāṭṭhārasa vuttā, tayo Ajjhattabāhirā.", "Peyyālo saṭṭhiko vutto, Buddhenādiccabandhunāti."], "app": []}, {"label": null, "lines": ["Suttantāni saṭṭhi."], "app": []}], "558": [{"label": null, "lines": ["“Yo imaṁ samuddaṁ sagāhaṁ sarakkhasaṁ."], "app": []}, {"label": null, "lines": ["Sa-ūmiṁ sāvaṭṭaṁ sabhayaṁ duttaraṁ accatari."], "app": []}, {"label": null, "lines": ["Sa vedagū vusitabrahmacariyo."], "app": []}, {"label": null, "lines": ["Lokantagū pāragatoti vuccati”ti."], "app": []}, {"label": null, "lines": ["Paṭhamaṁ."], "app": []}], "559": [{"label": null, "lines": ["Dutiyaṁ."], "app": []}], "567": [{"label": null, "lines": ["Samuddavaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Samuddā Bāḷisiko, Khīrarukkhena Koṭṭhiko.", "Kāmabhū Udāyī ceva, Ādittena ca aṭṭhamaṁ.", "Hatthapādūpamā dveti, vaggo tena pavuccatīti."], "app": []}], "570": [{"label": null, "lines": ["Tatiyaṁ."], "app": []}], "578": [{"label": null, "lines": ["Āsīvisavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Āsīviso Ratho Kummo, dve Dārukkhandhā Avassuto.", "Dukkhadhammā Kiṁsukā Vīṇā, Chappāṇā Yavakalāpīti."], "app": []}, {"label": null, "lines": ["Saḷāyatanavagge catutthapaṇṇāsako samatto."], "app": []}, {"label": null, "lines": ["Saḷāyatanasaṁyuttaṁ samattaṁ."], "app": []}], "579": [{"label": null, "lines": ["Paṭhamaṁ."], "app": []}], "580": [{"label": null, "lines": ["Dutiyaṁ."], "app": []}], "581": [{"label": null, "lines": ["Tatiyaṁ."], "app": []}], "582": [{"label": null, "lines": ["Catutthaṁ."], "app": []}], "583": [{"label": null, "lines": ["Pañcamaṁ."], "app": []}], "584": [{"label": null, "lines": ["Chaṭṭhaṁ."], "app": []}], "588": [{"label": null, "lines": ["Vedanāsaṁyuttassa sagāthāvaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Samādhi Sukhaṁ Pahānena, Pātālaṁ Daṭṭhabbena ca.", "Sallena ceva Gelaññā, Anicca Phassamūlakāti."], "app": []}], "590": [{"label": null, "lines": ["Dutiyaṁ."], "app": []}], "598": [{"label": null, "lines": ["Rahogatavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Rahogataṁ dve Ākāsaṁ, Agāraṁ dve ca Ānandā.", "Sambahulā duve vuttā, Pañcakaṅgo ca Bhikkhunāti."], "app": []}], "599": [{"label": null, "lines": ["Paṭhamaṁ."], "app": []}], "609": [{"label": null, "lines": ["Aṭṭhasatapariyāyavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sīvaka Aṭṭhasataṁ Bhikkhu, Pubbe Ñāṇañca Bhikkhunā.", "Samaṇabrāhmaṇā tīṇi, Suddhikañca Nirāmisanti."], "app": []}, {"label": null, "lines": ["Vedanāsaṁyuttaṁ samattaṁ."], "app": []}], "623": [{"label": null, "lines": ["Paṭhamapeyyālavaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Mātugāmo Puriso ca, Āveṇikā Tidhammo ca1.", "Kodhano Upanāhī ca, Issukī Maccharena ca.", "Aticārī ca Dussīlo, Appassuto ca Kusīto.", "Muṭṭhassati Pañcaveraṁ, kaṇhapakkhe pakāsito."], "app": []}], "633": [{"label": null, "lines": ["Dutiyapeyyālavaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dutiye ca1 Akkodhano, Anupanāhī Anissukī.", "Amaccharī Anaticārī, Sīlavā ca Bahussuto.", "Vīriyaṁ Sati Sīlaṁ ca, sukkapakkhe pakāsito."], "app": []}], "643": [{"label": null, "lines": ["Dasamaṁ."], "app": []}, {"label": null, "lines": ["Balavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Visāradā Pasayha Abhibhuyya, Ekaṁ Aṅgena pañcamaṁ.", "Nāsenti Hetu Ṭhānañca, Visārado Vaḍḍhinā dasāti."], "app": []}, {"label": null, "lines": ["Mātugāmasaṁyuttaṁ samattaṁ."], "app": []}], "659": [{"label": null, "lines": ["Jambukhādakasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Nibbānaṁ Arahattañca, Dhammavādī Kimatthiyaṁ.", "Assāso Paramassāso, Vedanā Āsavāvijjā.", "Taṇhā Oghā Upādānaṁ, Bhavo Dukkhañca Sakkāyo.", "Imasmiṁ dhammavinaye Dukkaranti."], "app": []}], "661": [{"label": null, "lines": ["Purimakasadisaṁ uddānaṁ."], "app": []}, {"label": null, "lines": ["Sāmaṇḍakasaṁyuttaṁ samattaṁ."], "app": []}], "672": [{"label": null, "lines": ["Moggallānasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Savitakkāvitakkañca, sukhena ca upekkhako.", "Ākāsañceva Viññāṇaṁ, Ākiñcaṁ Nevasaññinā.", "Animitto ca Sakko ca, Candanekādasena cāti."], "app": []}], "682": [{"label": null, "lines": ["Cittasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Saṁyojanaṁ dve Isidattā, Mahako Kāmabhūpi ca.", "Godatto ca Nigaṇṭho ca, Acelena Gilānadassananti."], "app": []}], "695": [{"label": null, "lines": ["Gāmaṇisaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Caṇḍo Puṭo Yodhājīvo, Hatthasso Asibandhako.", "Desanā Saṅkhakulaṁ Maṇicūḷaṁ, Bhadrarāsiyapāṭalīti."], "app": []}], "706": [{"label": null, "lines": ["Asaṅkhatasaṁyuttassa paṭhamo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kāyo Samatho Savitakko, Suññato Satipaṭṭhānā.", "Sammappadhānā Iddhipādā, Indriya Bala Bojjhaṅgā.", "Maggena ekādasamaṁ, tassuddānaṁ pavuccati."], "app": []}], "710": [{"label": null, "lines": ["Dutiyo vaggo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Asaṅkhataṁ Anataṁ Anāsavaṁ,", "Saccañca Pāraṁ Nipuṇaṁ Sududdasaṁ.", "Ajajjaraṁ Dhuvaṁ Apalokitaṁ,", "Anidassanaṁ Nippapañca Santaṁ.", "Amataṁ Paṇītañca Sivañca Khemaṁ,", "Taṇhākkhayo Acchariyañca Abbhutaṁ.", "Anītikaṁ Anītikadhammaṁ,", "Nibbānametaṁ Sugatena desitaṁ.", "Abyābajjho Virāgo ca, Suddhi Mutti Anālayo.", "Dīpo Leṇañca Tāṇañca, Saraṇañca Parāyananti."], "app": []}, {"label": null, "lines": ["Asaṅkhatasaṁyuttaṁ samattaṁ."], "app": []}], "721": [{"label": null, "lines": ["Abyākatasaṁyuttaṁ samattaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Khemātherī Anurādho, Sāriputtoti Koṭṭhiko.", "Moggallāno ca Vaccho ca, Kutūhalasālānando.", "Sabhiyo ekādasamanti."], "app": []}, {"label": null, "lines": ["Saḷāyatanavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Saḷāyatanavedanā, Mātugāmo Jambukhādako.", "Sāmaṇḍako Moggallāno, Citto Gāmaṇi’saṅkhataṁ.", "Abyākatanti dasadhāti."], "app": []}, {"label": null, "lines": ["Saḷāyatanavaggasaṁyuttapāḷi niṭṭhitā."], "app": []}]}