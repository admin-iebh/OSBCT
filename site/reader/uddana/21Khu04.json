{"13": [{"label": null, "lines": ["Sakiṁsammajjakattherassāpadānaṁ paṭhamaṁ."], "app": []}], "34": [{"label": null, "lines": ["Ekadussadāyakattherassāpadānaṁ dutiyaṁ."], "app": []}], "59": [{"label": null, "lines": ["Ekāsanadāyakattherassāpadānaṁ tatiyaṁ."], "app": []}], "105": [{"label": null, "lines": ["Ekadhammassavaniyattherassāpadānaṁ sattamaṁ."], "app": []}], "119": [{"label": null, "lines": ["Ekūnavīsatimaṁ bhāṇavāraṁ."], "app": []}], "138": [{"label": null, "lines": ["Sucintitattherassāpadānaṁ aṭṭhamaṁ."], "app": []}], "168": [{"label": null, "lines": ["Sakiṁsammajjakavaggo tecattālīsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sakiṁsammajjako thero, Ekadussī Ekāsanī.", "Kadambakoraṇḍakado, Ghatassavanikopi ca.", "Sucintiko Kiṅkaṇiko, Soṇṇakontarikopi ca.", "Ekagāthāsatañcettha, ekasattatimeva ca."], "app": []}], "180": [{"label": null, "lines": ["Ekavihārikattherassāpadānaṁ paṭhamaṁ."], "app": []}], "193": [{"label": null, "lines": ["Ekasaṅkhiyattherassāpadānaṁ dutiyaṁ."], "app": []}], "211": [{"label": null, "lines": ["Ñāṇatthavikattherassāpadānaṁ catutthaṁ."], "app": []}], "248": [{"label": null, "lines": ["Ambapiṇḍiyattherassāpadānaṁ navamaṁ."], "app": []}], "255": [{"label": null, "lines": ["Ambaphaliyattherassāpadānaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Ekavihārivaggo catucattālīsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Thero Ekavihārī ca, Saṅkhiyo Pāṭihīrako.", "Thaviko Ucchukhaṇḍī ca, Kaḷamba-ambāṭakado.", "Harītakambapiṇḍī ca, Ambado dasamo yati.", "Chaḷasīti ca gāthāyo, gaṇitāyo vibhāvibhi."], "app": []}], "269": [{"label": null, "lines": ["Koladāyakattherassāpadānaṁ dutiyaṁ."], "app": []}], "276": [{"label": null, "lines": ["Billiyattherassāpadānaṁ tatiyaṁ."], "app": []}], "296": [{"label": null, "lines": ["Ambāṭakiyattherassāpadānaṁ chaṭṭhaṁ."], "app": []}], "304": [{"label": null, "lines": ["Sīhāsanikattherassāpadānaṁ sattamaṁ."], "app": []}], "315": [{"label": null, "lines": ["Pādapīṭhiyattherassāpadānaṁ aṭṭhamaṁ."], "app": []}], "323": [{"label": null, "lines": ["Vedikārakattherassāpadānaṁ navamaṁ."], "app": []}], "335": [{"label": null, "lines": ["Vibhītakavaggo pañcacattālīsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Vibhītakī Kolaphalī, Billabhallātakappado.", "Uttalambaṭakī ceva, Āsanī Pādapīṭhako.", "Vediko Bodhighariko, gāthāyo gaṇitāpi ca.", "Ekūnāsītikā sabbā, asmiṁ vagge pakittitā."], "app": []}], "343": [{"label": null, "lines": ["Jagatidāyakattherassāpadānaṁ paṭhamaṁ."], "app": []}], "351": [{"label": null, "lines": ["Morahatthiyattherassāpadānaṁ dutiyaṁ."], "app": []}], "356": [{"label": null, "lines": ["Sīhāsanabījiyattherassāpadānaṁ tatiyaṁ."], "app": []}], "371": [{"label": null, "lines": ["Vanakoraṇḍiyattherassāpadānaṁ chaṭṭhaṁ."], "app": []}, {"label": null, "lines": ["Vīsatimaṁ bhāṇavāraṁ."], "app": []}], "383": [{"label": null, "lines": ["Ekachattiyattherassāpadānaṁ sattamaṁ."], "app": []}], "392": [{"label": null, "lines": ["Jātipupphiyattherassāpadānaṁ aṭṭhamaṁ."], "app": []}], "397": [{"label": null, "lines": ["Paṭṭipupphiyattherassāpadānaṁ navamaṁ."], "app": []}], "402": [{"label": null, "lines": ["Gandhapūjakattherassāpadānaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Jagatidāyakavaggo chacattālīsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Jagatī Morahatthī ca, Āsanī Ukkadhārako.", "Akkami Vanakoraṇḍi, Chattado Jātipūjako.", "Paṭṭipupphī ca yo thero, dasamo Gandhapūjako.", "Sattasaṭṭhi ca gāthāyo, gaṇitāyo vibhāvibhi."], "app": []}], "407": [{"label": null, "lines": ["Sālakusumiyattherassāpadānaṁ paṭhamaṁ."], "app": []}], "412": [{"label": null, "lines": ["Citakapūjakattherassāpadānaṁ dutiyaṁ."], "app": []}], "422": [{"label": null, "lines": ["Setudāyakattherassāpadānaṁ catutthaṁ."], "app": []}], "433": [{"label": null, "lines": ["Avaṭaphaliyattherassāpadānaṁ chaṭṭhaṁ."], "app": []}], "441": [{"label": null, "lines": ["Labujaphaladāyakattherassāpadānaṁ sattamaṁ."], "app": []}], "460": [{"label": null, "lines": ["Sayaṁpaṭibhāniyattherassāpadānaṁ navamaṁ."], "app": []}], "474": [{"label": null, "lines": ["Sālakusumiyavaggo sattacattālīsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sālakusumiyo thero, Pūjā Nibbāpakopi ca.", "Setudo Tālavaṇṭī ca, Avaṭalabujappado.", "Pilakkhapaṭibhānī ca, Veyyākaraṇiyo dijo.", "Dvesattati ca gāthāyo, gaṇitāyo vibhāvibhi."], "app": []}], "481": [{"label": null, "lines": ["Naḷamāliyattherassāpadānaṁ paṭhamaṁ."], "app": []}], "503": [{"label": null, "lines": ["Maṇipūjakattherassāpadānaṁ dutiyaṁ."], "app": []}], "519": [{"label": null, "lines": ["Ukkāsatikattherassāpadānaṁ tatiyaṁ."], "app": []}], "544": [{"label": null, "lines": ["Vallikāraphaladāyakattherassāpadānaṁ aṭṭhamaṁ."], "app": []}], "569": [{"label": null, "lines": ["Naḷamālivaggo aṭṭhacattālīsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Naḷamālī Maṇidado, Ukkāsatikabījanī.", "Kummāso ca Kusaṭṭho ca, Giripunnāgiyopi ca.", "Vallikāro Pānadhido, atho Pulinacaṅkamo.", "Gāthāyo pañcanavuti, gaṇitāyo vibhāvibhi."], "app": []}], "595": [{"label": null, "lines": ["Buddhasaññakattherassāpadānaṁ dutiyaṁ."], "app": []}], "614": [{"label": null, "lines": ["Bhisadāyakattherassāpadānaṁ tatiyaṁ."], "app": []}], "623": [{"label": null, "lines": ["Ekavīsatimaṁ bhāṇavāraṁ."], "app": []}], "643": [{"label": null, "lines": ["Ñāṇathavikattherassāpadānaṁ catutthaṁ."], "app": []}], "679": [{"label": null, "lines": ["Dhātupūjakattherassāpadānaṁ chaṭṭhaṁ."], "app": []}], "716": [{"label": null, "lines": ["Pulinuppādakattherassāpadānaṁ sattamaṁ."], "app": []}], "732": [{"label": null, "lines": ["Taraṇiyattherassāpadānaṁ aṭṭhamaṁ."], "app": []}], "758": [{"label": null, "lines": ["Dhammaruciyattherassāpadānaṁ navamaṁ."], "app": []}], "789": [{"label": null, "lines": ["Itthaṁ sudaṁ āyasmā Sālamaṇḍapiyo thero imā gāthāyo abhāsitthāti."], "app": []}, {"label": null, "lines": ["Sālamaṇḍapiyattherassāpadānaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Paṁsukūlavaggo ekūnapaññāsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Paṁsukūlaṁ Buddhasaññī, Bhisado Ñāṇakittako.", "Candanī Dhātupūjī ca, Pulinuppādakopi ca.", "Taraṇo Dhammaruciko, Sālamaṇḍapiyo tathā.", "Satāni dve honti gāthā, ūnavīsatimeva ca."], "app": []}], "803": [{"label": null, "lines": ["Paṁsukūlapūjakattherassāpadānaṁ dutiyaṁ."], "app": []}], "813": [{"label": null, "lines": ["Koraṇḍapupphiyattherassāpadānaṁ tatiyaṁ."], "app": []}], "874": [{"label": null, "lines": ["Dvāvīsatimaṁ bhāṇavāraṁ."], "app": []}], "881": [{"label": null, "lines": ["Pulinathūpiyattherassāpadānaṁ aṭṭhamaṁ."], "app": []}], "898": [{"label": null, "lines": ["Kiṅkaṇipupphavaggo paññāsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kiṅkaṇī Paṁsukūlañca, Koraṇḍamatha Kiṁsukaṁ.", "Upaḍḍhadussī Ghatado, Udakaṁ Thūpakārako.", "Naḷakārī ca navamo, Piyālaphaladāyako.", "Satamekañca gāthānaṁ, navakañca taduttari.", "Atha vagguddānaṁ.", "Metteyyavaggo bhaddāli, Sakiṁsammajjakopi ca.", "Ekavihārī Vibhītakī, Jagatī Sālapupphiyo.", "Naḷāgāraṁ Paṁsukūlaṁ, Kiṅkaṇipupphiyo tathā.", "Asīti dve ca gāthāyo, catuddasasatāni ca.", "Metteyyavaggadasakaṁ.", "Pañcamasatakaṁ samattaṁ."], "app": []}], "948": [{"label": null, "lines": ["Ekapattadāyakattherassāpadānaṁ dutiyaṁ."], "app": []}], "960": [{"label": null, "lines": ["Avaṭaphaliyattherassāpadānaṁ catutthaṁ."], "app": []}], "965": [{"label": null, "lines": ["Pādaphaliyattherassāpadānaṁ pañcamaṁ."], "app": []}], "997": [{"label": null, "lines": ["Kaṇikāravaggo ekapaññāsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kaṇikārekapattā ca, Kāsumārī tathāvaṭā.", "Pādañca Mātuluṅgañca, Ajelīmodameva ca.", "Tālaṁ tathā Nāḷikeraṁ, gāthāyo gaṇitā viha.", "Ekaṁ gāthāsataṁ hoti, ūnādhikavivajjitaṁ."], "app": []}], "1013": [{"label": null, "lines": ["Kosambaphaliyattherassāpadānaṁ tatiyaṁ."], "app": []}], "1033": [{"label": null, "lines": ["Ajjunapupphiyattherassāpadānaṁ chaṭṭhaṁ."], "app": []}], "1047": [{"label": null, "lines": ["Ghosasaññakattherassāpadānaṁ aṭṭhamaṁ."], "app": []}], "1080": [{"label": null, "lines": ["Phaladāyakavaggo dvepaññāsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kurañciyaṁ Kapitthañca, Kosambamatha Ketakaṁ.", "Nāgapupphajjunañceva, Kuṭajī Ghosasaññako.", "Thero ca Sabbaphalado, tathā Padumadhāriko.", "Asīti cettha gāthāyo, tisso gāthā taduttari."], "app": []}], "1098": [{"label": null, "lines": ["Mañcadāyakattherassāpadānaṁ dutiyaṁ."], "app": []}], "1103": [{"label": null, "lines": ["Saraṇagamaniyattherassāpadānaṁ tatiyaṁ."], "app": []}], "1121": [{"label": null, "lines": ["Daṇḍadāyakattherassāpadānaṁ chaṭṭhaṁ."], "app": []}, {"label": null, "lines": ["Tevīsatimaṁ bhāṇavāraṁ."], "app": []}], "1127": [{"label": null, "lines": ["Girinelapūjakattherassāpadānaṁ sattamaṁ."], "app": []}], "1206": [{"label": null, "lines": ["Sugandhattherassāpadānaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Tiṇadāyakavaggo tepaññāsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Tiṇado Mañcado ceva, Saraṇabbhañjanappado.", "Supaṭo Daṇḍadāyī ca, Nelapūjī tatheva ca.", "Bodhisammajjako Maṇḍo, Sugandho dasamoti ca.", "Gāthāsataṁ satevīsaṁ, gaṇitaṁ cettha sabbaso."], "app": []}], "1233": [{"label": null, "lines": ["Mahākaccāyanattherassāpadānaṁ paṭhamaṁ."], "app": []}], "1271": [{"label": null, "lines": ["Vakkalittherassāpadānaṁ dutiyaṁ."], "app": []}], "1313": [{"label": null, "lines": ["Mahākappinattherassāpadānaṁ tatiyaṁ."], "app": []}], "1383": [{"label": null, "lines": ["Catuvīsatimaṁ bhāṇavāraṁ."], "app": []}], "1426": [{"label": null, "lines": ["Bāhiyattherassāpadānaṁ chaṭṭhaṁ."], "app": []}], "1456": [{"label": null, "lines": ["Mahākoṭṭhikattherassāpadānaṁ sattamaṁ."], "app": []}], "1532": [{"label": null, "lines": ["Rādhattherassāpadānaṁ navamaṁ."], "app": []}], "1568": [{"label": null, "lines": ["Mogharājattherassāpadānaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Kaccāyanavaggo catupaññāsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kaccāno Vakkalī thero, Mahākappinasavhayo.", "Dabbo Kumāranāmo ca, Bāhiyo Koṭṭhiko vasī.", "Uruveḷakassapo Rādho, Mogharājā ca paṇḍito.", "Tīṇi gāthāsatānettha, bāsaṭṭhi ceva piṇḍitā."], "app": []}], "1621": [{"label": null, "lines": ["Kaṅkhārevatattherassāpadānaṁ dutiyaṁ."], "app": []}], "1663": [{"label": null, "lines": ["Sīvalittherassāpadānaṁ tatiyaṁ."], "app": []}], "1691": [{"label": null, "lines": ["Pañcavīsatimaṁ bhāṇavāraṁ."], "app": []}], "1710": [{"label": null, "lines": ["Vaṅgīsattherassāpadānaṁ catutthaṁ."], "app": []}], "1732": [{"label": null, "lines": ["Nandakattherassāpadānaṁ pañcamaṁ."], "app": []}], "1762": [{"label": null, "lines": ["Kāḷudāyittherassāpadānaṁ chaṭṭhaṁ."], "app": []}], "1792": [{"label": null, "lines": ["Abhayattherassāpadānaṁ sattamaṁ."], "app": []}], "1876": [{"label": null, "lines": ["Cūḷasugandhattherassāpadānaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Bhaddiyavaggo pañcapaññāsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Bhaddiyo Revato thero, mahālābhī ca Sīvalī.", "Vaṅgīso Nandako ceva, Kāḷudāyī tathābhayo.", "Lomaso Vanavaccho ca, Sugandho ceva dasamo.", "Tīṇi gāthāsatā tattha, soḷasā ca taduttari."], "app": []}, {"label": "Atha vagguddānaṁ", "lines": ["Kaṇikāravhayo vaggo, Phalado Tiṇadāyako.", "Kaccāno Bhaddiyo vaggo, gāthāyo gaṇitā cimā.", "Navagāthāsatānīha, caturāsītiyeva ca.", "Sapaññāsaṁ pañcasataṁ, apadānā pakāsitā.", "Saha udānagāthāhi, chasahassāni hontimā.", "Dvesatāni ca gāthānaṁ, aṭṭhārasa taduttari."], "app": []}], "1904": [{"label": null, "lines": ["Yasattherassāpadānaṁ paṭhamaṁ."], "app": []}], "1910": [{"label": null, "lines": ["Nadīkassapattherassāpadānaṁ dutiyaṁ."], "app": []}], "1917": [{"label": null, "lines": ["Gayākassapattherassāpadānaṁ tatiyaṁ."], "app": []}], "1924": [{"label": null, "lines": ["Kimilattherassāpadānaṁ catutthaṁ."], "app": []}], "1930": [{"label": null, "lines": ["Vajjīputtattherassāpadānaṁ pacamaṁ."], "app": []}], "1968": [{"label": null, "lines": ["Uttarattherassāpadānaṁ chaṭṭhaṁ."], "app": []}], "1973": [{"label": null, "lines": ["Aparassa uttarattherassāpadānaṁ sattamaṁ."], "app": []}], "1992": [{"label": null, "lines": ["Bhaddajittherassāpadānaṁ aṭṭhamaṁ."], "app": []}], "1997": [{"label": null, "lines": ["Sivakattherassāpadānaṁ navamaṁ."], "app": []}], "2054": [{"label": null, "lines": ["Upavānattherassāpadānaṁ dasamaṁ."], "app": []}], "2071": [{"label": null, "lines": ["Raṭṭhapālattherassāpadānaṁ ekādasamaṁ."], "app": []}, {"label": null, "lines": ["Yasavaggo chapaññāsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Yaso Nadīkassapo ca, Gayākimilavajjino.", "Duve Uttarā Bhaddajī, Sivako Upavāhano.", "Raṭṭhapālo ekasataṁ, gāthānaṁ pañcanavuti.", "Therāpadānaṁ samattaṁ.", "Ettāvatā Buddhāpadānañca paccekāpadānañca therāpadānañca samattāni."], "app": []}], "2090": [{"label": null, "lines": ["Sumedhātheriyāpadānaṁ paṭhamaṁ."], "app": []}], "2096": [{"label": null, "lines": ["Mekhalādāyikātheriyāpadānaṁ dutiyaṁ."], "app": []}], "2101": [{"label": null, "lines": ["Maṇḍapadāyikātheriyāpadānaṁ tatiyaṁ."], "app": []}], "2107": [{"label": null, "lines": ["Saṅkamanatthātheriyāpadānaṁ catutthaṁ."], "app": []}], "2116": [{"label": null, "lines": ["Naḷamālikātheriyāpadānaṁ pañcamaṁ."], "app": []}], "2130": [{"label": null, "lines": ["Ekapiṇḍapātadāyikātheriyāpadānaṁ chaṭṭhaṁ."], "app": []}], "2161": [{"label": null, "lines": ["Sattuppalamālikātheriyāpadānaṁ aṭṭhamaṁ."], "app": []}], "2186": [{"label": null, "lines": ["Pañcadīpikātheriyāpadānaṁ navamaṁ."], "app": []}], "2201": [{"label": null, "lines": ["Udakadāyikātheriyāpadānaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Sumedhāvaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sumedhā Mekhalādāyī, Maṇḍapaṁ Saṅkamaṁ dadā.", "Naḷamālī Piṇḍadadā, Kaṭacchu Uppalappadā.", "Dīpadā dakadā ceva, gāthāyo gaṇitā iha.", "Ekagāthāsatañceva, tiṁsati ca taduttari2."], "app": []}], "2222": [{"label": null, "lines": ["Ekūposathikātheriyāpadānaṁ paṭhamaṁ."], "app": []}], "2230": [{"label": null, "lines": ["Saḷalapupphikātheriyāpadānaṁ dutiyaṁ."], "app": []}], "2237": [{"label": null, "lines": ["Modakadāyikātheriyāpadānaṁ tatiyaṁ."], "app": []}], "2297": [{"label": null, "lines": ["Naḷamālikātheriyāpadānaṁ chaṭṭhaṁ."], "app": []}], "2321": [{"label": null, "lines": ["Paṭhamaṁ bhāṇavāraṁ."], "app": []}], "2571": [{"label": null, "lines": ["Dutiyaṁ bhāṇavāraṁ."], "app": []}], "2584": [{"label": null, "lines": ["Khemātheriyāpadānaṁ aṭṭhamaṁ."], "app": []}], "2668": [{"label": null, "lines": ["Uppalavaṇṇātheriyāpadānaṁ navamaṁ."], "app": []}], "2712": [{"label": null, "lines": ["Paṭācārātheriyāpadānaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Ekūposathikavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Ekūposathikā ceva, Saḷalā cātha Modakā.", "Ekāsanā Pañcadīpā, Naḷamālī ca Gotamī.", "Khemā Uppalavaṇṇā ca, Paṭācārā ca bhikkhunī.", "Gāthā satāni pañceva, nava cāpi taduttari."], "app": []}], "2766": [{"label": null, "lines": ["Kuṇḍalakesātheriyāpadānaṁ paṭhamaṁ."], "app": []}], "2806": [{"label": null, "lines": ["Kisāgotamītheriyāpadānaṁ dutiyaṁ."], "app": []}], "2824": [{"label": null, "lines": ["Tatiyaṁ bhāṇavāraṁ."], "app": []}], "2842": [{"label": null, "lines": ["Dhammadinnātheriyāpadānaṁ tatiyaṁ."], "app": []}], "2877": [{"label": null, "lines": ["Sakulātheriyāpadānaṁ catutthaṁ."], "app": []}], "2931": [{"label": null, "lines": ["Nandātheriyāpadānaṁ pañcamaṁ."], "app": []}], "2955": [{"label": null, "lines": ["Soṇātheriyāpadānaṁ chaṭṭhaṁ."], "app": []}], "3025": [{"label": null, "lines": ["Bhaddakāpilānītheriyāpadānaṁ sattamaṁ."], "app": []}], "3081": [{"label": null, "lines": ["Catutthaṁ bhāṇavāraṁ."], "app": []}], "3122": [{"label": null, "lines": ["Yasodharātheriyāpadānaṁ aṭṭhamaṁ."], "app": []}], "3198": [{"label": null, "lines": ["Kuṇḍalakesīvaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kuṇḍalā Gotamī ceva, Dhammadinnā ca Sakulā.", "Varanandā ca Soṇā ca, Kāpilānī Yasodharā.", "Dasasahassabhikkhunī, aṭṭhārasasahassakā.", "Gāthāsatāni cattāri, cha ca sattatimeva ca2."], "app": []}], "3254": [{"label": null, "lines": ["Caturāsītibhikkhunīsahassāpadānaṁ dutiyaṁ."], "app": []}], "3279": [{"label": null, "lines": ["Uppaladāyikātheriyāpadānaṁ tatiyaṁ."], "app": []}], "3308": [{"label": null, "lines": ["Siṅgālamātutheriyāpadānaṁ catutthaṁ."], "app": []}], "3340": [{"label": null, "lines": ["Sukkātheriyāpadānaṁ pañcamaṁ."], "app": []}, {"label": null, "lines": ["Pañcamaṁ bhāṇavāraṁ."], "app": []}], "3365": [{"label": null, "lines": ["Abhirūpanandātheriyāpadānaṁ chaṭṭhaṁ."], "app": []}], "3381": [{"label": null, "lines": ["Aḍḍhakāsitheriyāpadānaṁ sattamaṁ."], "app": []}], "3401": [{"label": null, "lines": ["Puṇṇikātheriyāpadānaṁ aṭṭhamaṁ."], "app": []}], "3417": [{"label": null, "lines": ["Ambapālitheriyāpadānaṁ navamaṁ."], "app": []}], "3431": [{"label": null, "lines": ["Pesalātheriyāpadānaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Khattiyāvaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Khattiyā brāhmaṇī ceva, tathā Uppaladāyikā.", "Siṅgālamātā Sukkā ca, Abhirūpā Aḍḍhakāsikā.", "Puṇṇā ca Ambapālī ca, Pesalāti ca tā dasa.", "Gāthāyo dvisatānettha, dvicattālīsa cuttari."], "app": []}, {"label": "Atha vagguddānaṁ", "lines": ["Sumedhā Ekūposathā, Kuṇḍalakesī Khattiyā.", "Sahassaṁ tisatā gāthā, sattatālīsa piṇḍitā.", "Saha uddānagāthāhi, gaṇitāyo vibhāvibhi.", "Sahassaṁ tisataṁ gāthā, sattapaññāsameva cāti.", "Therikāpadānaṁ samattaṁ.", "Apadānapāḷi samattā."], "app": []}], "3512": [{"label": null, "lines": ["Ratanacaṅkamanakaṇḍo niṭṭhito."], "app": []}], "3699": [{"label": null, "lines": ["Sumedhapatthanākathā niṭṭhitā."], "app": []}], "3730": [{"label": null, "lines": ["Dīpaṅkarassa Bhagavato vaṁso paṭhamo."], "app": []}], "3768": [{"label": null, "lines": ["Koṇḍaññassa Bhagavato vaṁso dutiyo."], "app": []}], "3800": [{"label": null, "lines": ["Maṅgalassa Bhagavato vaṁso tatiyo."], "app": []}], "3834": [{"label": null, "lines": ["Sumanassa Bhagavato vaṁso catuttho."], "app": []}], "3863": [{"label": null, "lines": ["Revatassa Bhagavato vaṁso pañcamo."], "app": []}], "3893": [{"label": null, "lines": ["Sobhitassa Bhagavato vaṁso chaṭṭho."], "app": []}], "3922": [{"label": null, "lines": ["Anomadassissa Bhagavato vaṁso sattamo."], "app": []}], "3951": [{"label": null, "lines": ["Padumassa Bhagavato vaṁso aṭṭhamo."], "app": []}], "3984": [{"label": null, "lines": ["Nāradassa Bhagavato vaṁso navamo."], "app": []}], "4046": [{"label": null, "lines": ["Sumedhassa Bhagavato vaṁso ekādasamo."], "app": []}], "4082": [{"label": null, "lines": ["Sujātassa Bhagavato vaṁso dvādasamo."], "app": []}], "4109": [{"label": null, "lines": ["Piyadassissa Bhagavato vaṁso terasamo."], "app": []}], "4135": [{"label": null, "lines": ["Atthadassissa Bhagavato vaṁso cuddasamo."], "app": []}], "4184": [{"label": null, "lines": ["Siddhatthassa Bhagavato vaṁso soḷasamo."], "app": []}], "4212": [{"label": null, "lines": ["Tissassa Bhagavato vaṁso sattarasamo."], "app": []}], "4237": [{"label": null, "lines": ["Phussassa Bhagavato vaṁso aṭṭhārasamo."], "app": []}], "4274": [{"label": null, "lines": ["Vipassissa Bhagavato vaṁso ekūnavīsatimo."], "app": []}], "4302": [{"label": null, "lines": ["Sikhissa Bhagavato vaṁso vīsatimo."], "app": []}], "4483": [{"label": null, "lines": ["Buddhapakiṇṇakakaṇḍaṁ niṭṭhitaṁ."], "app": []}], "4501": [{"label": null, "lines": ["Dhātubhājanīyakathā niṭṭhitā."], "app": []}, {"label": null, "lines": ["Buddhavaṁso niṭṭhito."], "app": []}], "4511": [{"label": null, "lines": ["Akitticariyaṁ paṭhamaṁ."], "app": []}], "4520": [{"label": null, "lines": ["Saṅkhacariyaṁ dutiyaṁ."], "app": []}], "4528": [{"label": null, "lines": ["Kururājacariyaṁ tatiyaṁ."], "app": []}], "4537": [{"label": null, "lines": ["Mahāsudassanacariyaṁ catutthaṁ."], "app": []}], "4540": [{"label": null, "lines": ["Mahāgovindacariyaṁ pañcamaṁ."], "app": []}], "4545": [{"label": null, "lines": ["Nimirājacariyaṁ chaṭṭhaṁ."], "app": []}], "4551": [{"label": null, "lines": ["Candakumāracariyaṁ sattamaṁ."], "app": []}], "4567": [{"label": null, "lines": ["Sivirājacariyaṁ aṭṭhamaṁ."], "app": []}], "4625": [{"label": null, "lines": ["Vessantaracariyaṁ navamaṁ."], "app": []}], "4644": [{"label": null, "lines": ["Sasapaṇḍitacariyaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Akittivaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Akittibrāhmaṇo Saṅkho, Kururājā Dhanañcayo.", "Mahāsudassano rājā, Mahāgovindabrāhmaṇo.", "Nimi Candakumāro ca, Sivi Vessantaro Saso.", "Ahameva tadā āsiṁ, yo te dānavare adā.", "Ete dānaparikkhārā, ete dānassa pāramī.", "Jīvitaṁ yācake datvā, imaṁ pārami pūrayiṁ.", "Bhikkhāya upagataṁ disvā, sakattānaṁ pariccajiṁ.", "Dānena me samo natthi, esā me dānapāramīti.", "Dānapāraminiddeso niṭṭhito."], "app": []}], "4654": [{"label": null, "lines": ["Mātuposakacariyaṁ paṭhamaṁ."], "app": []}], "4663": [{"label": null, "lines": ["Bhūridattacariyaṁ dutiyaṁ."], "app": []}], "4669": [{"label": null, "lines": ["Campeyyanāgacariyaṁ tatiyaṁ."], "app": []}], "4680": [{"label": null, "lines": ["Cūḷabodhicariyaṁ catutthaṁ."], "app": []}], "4691": [{"label": null, "lines": ["Mahiṁsarājacariyaṁ pañcamaṁ."], "app": []}], "4703": [{"label": null, "lines": ["Rururājacariyaṁ chaṭṭhaṁ."], "app": []}], "4709": [{"label": null, "lines": ["Mātaṅgacariyaṁ sattamaṁ."], "app": []}], "4717": [{"label": null, "lines": ["Dhammadevaputtacariyaṁ aṭṭhamaṁ."], "app": []}], "4728": [{"label": null, "lines": ["Alīnasatthucariyaṁ navamaṁ."], "app": []}], "4735": [{"label": null, "lines": ["Saṅkhapālacariyaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Hatthināgavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Hatthināgo Bhūridatto, Campeyyo Bodhi Mahiṁso.", "Ruru Mātaṅgo Dhammo ca, atrajo ca Jayaddiso.", "Ete nava sīlabalā, parikkhārā padesikā.", "Jīvitaṁ parirakkhitvā, sīlāni anurakkhisaṁ.", "Saṅkhapālassa me sato, sabbakālampi jīvitaṁ.", "Yassa kassaci niyyattaṁ, tasmā sā sīlapāramīti.", "Sīlapāraminiddeso niṭṭhito."], "app": []}], "4741": [{"label": null, "lines": ["Yudhañjayacariyaṁ paṭhamaṁ."], "app": []}], "4758": [{"label": null, "lines": ["Somanassacariyaṁ dutiyaṁ."], "app": []}], "4768": [{"label": null, "lines": ["Ayogharacariyaṁ tatiyaṁ."], "app": []}], "4776": [{"label": null, "lines": ["Bhisacariyaṁ catutthaṁ."], "app": []}], "4782": [{"label": null, "lines": ["Soṇapaṇḍitacariyaṁ pañcamaṁ."], "app": []}], "4801": [{"label": null, "lines": ["Temiyacariyaṁ chaṭṭhaṁ."], "app": []}], "4805": [{"label": null, "lines": ["Kapirājacariyaṁ sattamaṁ."], "app": []}], "4806": [{"label": null, "lines": ["Saccatāpasacariyaṁ aṭṭhamaṁ."], "app": []}], "4817": [{"label": null, "lines": ["Vaṭṭapotakacariyaṁ navamaṁ."], "app": []}], "4826": [{"label": null, "lines": ["Maccharājacariyaṁ dasamaṁ."], "app": []}], "4839": [{"label": null, "lines": ["Kaṇhadīpāyanacariyaṁ ekādasamaṁ."], "app": []}], "4845": [{"label": null, "lines": ["Sutasomacariyaṁ dvādasamaṁ."], "app": []}], "4848": [{"label": null, "lines": ["Suvaṇṇasāmacariyaṁ terasamaṁ."], "app": []}], "4853": [{"label": null, "lines": ["Ekarājacariyaṁ cuddasamaṁ."], "app": []}], "4857": [{"label": null, "lines": ["Mahālomahaṁsacariyaṁ pannarasamaṁ."], "app": []}, {"label": null, "lines": ["Yudhañjayavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Yudhañjayo Somanasso, Ayogharabhisena ca.", "Soṇanando Mūgapakkho, Kapirājā Saccasavhayo.", "Vaṭṭako Maccharājā ca, Kaṇhadīpāyano isi.", "Sutasomo puna āsiṁ2, Sāmo ca Ekarājahu.", "Upekkhāpāramī āsi, iti vutthaṁ3 mahesinā.", "Evaṁ bahubbidhaṁ dukkhaṁ, sampattī ca bahubbidhā1.", "Bhavābhave anubhavitvā, patto sambodhimuttamaṁ.", "Datvā dātabbakaṁ dānaṁ, sīlaṁ pūretvā asesato.", "Nekkhamme pāramiṁ gantvā, patto sambodhimuttamaṁ.", "Paṇḍite paripucchitvā, vīriyaṁ katvāna muttamaṁ.", "Khantiyā pāramiṁ gantvā, patto sambodhimuttamaṁ.", "Katvā daḷhamadhiṭṭhānaṁ, saccavācānurakkhiya.", "Mettāya pāramiṁ gantvā, patto sambodhimuttamaṁ.", "Lābhālābhe yasāyase, sammānanāvamānane.", "Sabbattha samako hutvā, patto sambodhimuttamaṁ.", "Kosajjaṁ bhayato disvā, vīriyārambhañca khemato.", "Āraddhavīriyā hotha, esā Buddhānusāsanī.", "Vivādaṁ bhayato disvā, avivādañca khemato.", "Samaggā sakhilā hotha, esā Buddhānusāsanī.", "Pamādaṁ bhayato disvā, appamādañca khemato.", "Bhavethaṭṭhaṅgikaṁ maggaṁ, esā Buddhānusāsanī.", "Itthaṁ sudaṁ Bhagavā attano pubbacariyaṁ sambhāvayamāno", "Buddhāpadāniyaṁ nāma dhammapariyāyaṁ abhāsitthāti.", "Cariyāpiṭakaṁ niṭṭhitaṁ."], "app": []}]}