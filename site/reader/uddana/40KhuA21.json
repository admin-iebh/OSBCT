{"33": [{"label": null, "lines": ["Kiṁ chandajātakavaṇṇanā paṭhamā."], "app": []}], "64": [{"label": null, "lines": ["Kumbhajātakavaṇṇanā dutiyā."], "app": []}], "97": [{"label": null, "lines": ["Jayaddisajātakavaṇṇanā tatiyā."], "app": []}], "138": [{"label": null, "lines": ["Chaddantajātakavaṇṇanā catutthā."], "app": []}], "178": [{"label": null, "lines": ["Sambhavajātakavaṇṇanā pañcamā."], "app": []}], "225": [{"label": null, "lines": ["Mahākapijātakavaṇṇanā chaṭṭhā."], "app": []}], "226": [{"label": null, "lines": ["Dakarakkhasajātakavaṇṇanā sattamā."], "app": []}], "265": [{"label": null, "lines": ["Paṇḍaranāgarājajātakavaṇṇanā aṭṭhamā."], "app": []}], "300": [{"label": null, "lines": ["Ambulājātakavaṇṇanā navamā."], "app": []}], "338": [{"label": null, "lines": ["Gandhatindukajātakavaṇṇanā dasamā."], "app": []}, {"label": null, "lines": ["Kiṁchanda Kumbha Jayaddisa Chaddanta,"], "app": []}, {"label": null, "lines": ["Atha Paṇḍitasambhava Sirakapi."], "app": []}, {"label": null, "lines": ["Dakarakkhasa Paṇḍaranāgavaro,"], "app": []}, {"label": null, "lines": ["Atha Sambula Tindukadevasutoti."], "app": []}, {"label": null, "lines": ["Tiṁsanipātavaṇṇanā niṭṭhitā."], "app": []}], "352": [{"label": null, "lines": ["Vessantarapañho niṭṭhito."], "app": []}], "365": [{"label": null, "lines": ["Kuṇḍalinipañho niṭṭhito."], "app": []}], "390": [{"label": null, "lines": ["Tesakuṇajātakavaṇṇanā paṭhamā."], "app": []}], "435": [{"label": null, "lines": ["Sarabhaṅgajātakavaṇṇanā dutiyā."], "app": []}], "483": [{"label": null, "lines": ["Alambusājātakavaṇṇanā tatiyā."], "app": []}], "535": [{"label": null, "lines": ["Saṅkhapālajātakavaṇṇanā catutthā."], "app": []}], "586": [{"label": null, "lines": ["Cūḷasutasomajātakavaṇṇanā pañcamā."], "app": []}, {"label": "Jātakuddānaṁ", "lines": ["Suvapaṇḍitajambuka kuṇḍalino,", "Varakaññamalambusajātakaṁ ca.", "Pavaruttamasaṅkhasirīvhayako,", "Sutasoma-arindamarājavaro.", "Cattālīsanipātavaṇṇanā niṭṭhitā."], "app": []}], "643": [{"label": null, "lines": ["Niḷinikājātakavaṇṇanā paṭhamā."], "app": []}], "710": [{"label": null, "lines": ["Ummādantījātakavaṇṇanā dutiyā."], "app": []}], "769": [{"label": null, "lines": ["Mahābodhijātakavaṇṇanā tatiyā."], "app": []}, {"label": "Jātakuddānaṁ", "lines": ["Saniḷīnikamavhayano paṭhamo,", "Dutiyo pana Sa-ummadantivaro.", "Tatiyo pana Bodhisirīvhayano,", "Kathitā pana tīṇi Jinena subhāti.", "Paṇṇāsanipātavaṇṇanā niṭṭhitā."], "app": []}], "838": [{"label": null, "lines": ["Soṇakajātakavaṇṇanā paṭhamā."], "app": []}], "904": [{"label": null, "lines": ["Saṁkiccajātakavaṇṇanā dutiyā."], "app": []}, {"label": "Jātakuddānaṁ", "lines": ["Atha saṭṭhinipātamhi, suṇātha mama bhāsitaṁ.", "Jātakasavhayano pavaro,", "Soṇaka-arindamasavhayano.", "Tathā vuttarathesabhakiccavaroti.", "Saṭṭhinipātavaṇṇanā niṭṭhitā."], "app": []}], "996": [{"label": null, "lines": ["Kusarājajātakavaṇṇanā paṭhamā."], "app": []}], "1088": [{"label": null, "lines": ["Soṇanandajātakavaṇṇanā dutiyā."], "app": []}, {"label": "Jātakuddānaṁ", "lines": ["Atha sattatimamhi nipātavare,", "Sabhāvantu Kusāvatirājavaro.", "Atha Soṇasunandavaro ca puna,", "Abhivāsitasattatimamhi suteti.", "Sattatinipātavaṇṇanā niṭṭhitā."], "app": []}], "1177": [{"label": null, "lines": ["Cūḷahaṁsajātakavaṇṇanā paṭhamā."], "app": []}], "1280": [{"label": null, "lines": ["Mahāhaṁsajātakavaṇṇanā dutiyā."], "app": []}], "1376": [{"label": null, "lines": ["Sudhābhojanajātakavaṇṇanā tatiyā."], "app": []}], "1457": [{"label": null, "lines": ["Kuṇālajātakavaṇṇanā catutthā."], "app": []}], "1581": [{"label": null, "lines": ["Mahāsutasomajātakavaṇṇanā pañcamā."], "app": []}, {"label": "Jātakuddānaṁ", "lines": ["Sumukho pana haṁsavaro ca mahā,", "Sudhabhojaniko ca paro pavaro.", "Sakuṇāladijādhipativhayano,", "Sutasomavaruttamasavhayanoti.", "Asītinipātavaṇṇanā niṭṭhitā.", "(Pañcamo bhāgo niṭṭhito.)"], "app": []}]}