{"9": [{"label": null, "lines": ["Sekhabalavaggo paṭṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Saṁkhittaṁ Vitthataṁ Dukkhā, Bhataṁ Sikkhāya pañcamaṁ.", "Samāpatti ca Kāmesu, Cavanā dve Agāravāti."], "app": []}], "19": [{"label": null, "lines": ["Balavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Ananussutakūṭañca, Saṁkhittaṁ Vitthatena ca.", "Daṭṭhabbañca puna Kūṭaṁ, cattāropi Hitena cāti."], "app": []}], "29": [{"label": null, "lines": ["Pañcaṅgikavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Agāravupakkilesā, Dussīlānuggahitena ca.", "Vimuttisamādhipañcaṅgikā, Caṅkamaṁ Nāgitena cāti."], "app": []}], "38": [{"label": null, "lines": ["Navamaṁ."], "app": []}], "39": [{"label": null, "lines": ["Sumanavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sumanā Cundī Uggaho, Sīho Dānānisaṁsako.", "Kālabhojanasaddhā ca, Puttasālehi te dasāti."], "app": []}], "49": [{"label": null, "lines": ["Muṇḍarājavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Ādiyo Sappuriso Iṭṭhā, Manāpadāyībhisandaṁ.", "Sampadā ca Dhanaṁ Ṭhānaṁ, Kosalo Nāradena cāti."], "app": []}, {"label": null, "lines": ["Paṭhamo paṇṇāsako samatto."], "app": []}], "54": [{"label": null, "lines": ["Pañcamaṁ."], "app": []}], "59": [{"label": null, "lines": ["Nīvaraṇavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Āvaraṇaṁ Rāsi Aṅgāni, Samayaṁ Mātuputtikā.", "Upajjhā Ṭhānā Licchavi, Kumārā aparā duveti."], "app": []}], "69": [{"label": null, "lines": ["Saññāvaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve ca Saññā dve Vaḍḍhī ca, Sākacchena ca Sājīvaṁ.", "Iddhipādā ca dve vuttā, Nibbidā cāsavakkhayāti."], "app": []}], "79": [{"label": null, "lines": ["Yodhājīvavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Cetovimuttiphalā, dve ca Dhammavihārino.", "Yodhājīvā ca dve vuttā, cattāro ca Anāgatāti."], "app": []}], "89": [{"label": null, "lines": ["Theravaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Rajanīyo Vītarāgo, Kuhakāssaddha-akkhamā.", "Paṭisambhidā ca Sīlena, Thero Sekhā pare duveti."], "app": []}], "99": [{"label": null, "lines": ["Kakudhavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Sampadā Byākaraṇaṁ, Phāsu Akuppapañcamaṁ.", "Sutaṁ Kathā Āraññako, Sīho ca Kakudho dasāti."], "app": []}, {"label": null, "lines": ["Dutiyo paṇṇāsako samatto."], "app": []}], "109": [{"label": null, "lines": ["Phāsuvihāravaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sārajjaṁ Saṅkito Coro, Sukhumālaṁ Phāsu pañcamaṁ.", "Ānanda Sīlāsekhā ca, Cātuddiso Araññena cāti."], "app": []}], "119": [{"label": null, "lines": ["Andhakavindavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kulūpako Pacchāsamaṇo, Samādhi-andhakavindaṁ.", "Maccharī Vaṇṇanā Issā, Diṭṭhivācāya Vāyamāti."], "app": []}], "129": [{"label": null, "lines": ["Gilānavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Gilāno Satisūpaṭṭhi, dve Upaṭṭhākā duvāyusā.", "Vapakāsasamaṇasukhā, Parikuppaṁ Byasanena cāti."], "app": []}], "139": [{"label": null, "lines": ["Rājavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Cakkānuvattanā Rājā, Yassaṁdisaṁ dve ceva Patthanā.", "Appaṁsupati Bhattādo, Akkhamo ca Sotena cāti."], "app": []}], "149": [{"label": null, "lines": ["Tikaṇḍakīvaggo pañcamo."], "app": []}, {"label": null, "lines": ["Tassuddānaṁ."], "app": []}, {"label": null, "lines": ["Tatiyo paṇṇāsako samatto."], "app": []}], "159": [{"label": null, "lines": ["Saddhammavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Tayo Sammattaniyāmā, tayo Saddhammasammosā.", "Dukkathā ceva Sārajjaṁ, Udāyidubbinodayāti."], "app": []}], "169": [{"label": null, "lines": ["Āghātavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Āghātavinayā, Sākacchā Sājīvato Pañhaṁ.", "Pucchā Nirodho Codanā, Sīlaṁ Nisanti Bhaddajīti."], "app": []}], "173": [{"label": null, "lines": ["Catutthaṁ."], "app": []}], "179": [{"label": null, "lines": ["Upāsakavaggo tatiyo."], "app": []}, {"label": null, "lines": ["Tassuddānaṁ."], "app": []}], "189": [{"label": null, "lines": ["Araññavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Araññaṁ Cīvaraṁ Rukkha, Susānaṁ Abbhokāsikaṁ.", "Nesajjaṁ Santhataṁ Ekāsanikaṁ, Khalupacchāpiṇḍikena cāti."], "app": []}], "193": [{"label": null, "lines": ["“Namo Tassa Bhagavato Arahato Sammāsambuddhassa."], "app": []}, {"label": null, "lines": ["Namo Tassa Bhagavato Arahato Sammāsambuddhassa."], "app": []}, {"label": null, "lines": ["Namo Tassa Bhagavato Arahato Sammāsambuddhassā”ti."], "app": []}], "199": [{"label": null, "lines": ["Brāhmaṇavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Soṇo Doṇo Saṅgāravo, Kāraṇapālī ca Piṅgiyānī.", "Supinā ca Vassā Vācā, Kulaṁ Nissāraṇīyena cāti."], "app": []}, {"label": null, "lines": ["Catuttho paṇṇāsako samatto."], "app": []}], "209": [{"label": null, "lines": ["Kimilavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kimilo Dhammassavanaṁ, Ājānīyo Balaṁ Khilaṁ.", "Vinibandhaṁ Yāgu Kaṭṭhaṁ, Gītaṁ Muṭṭhassatinā cāti."], "app": []}], "219": [{"label": null, "lines": ["Akkosakavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Akkosabhaṇḍanasīlaṁ, Bahubhāṇī dve Akhantiyo.", "Apāsādikā dve vuttā, Aggasmiṁ Madhurena cāti."], "app": []}], "229": [{"label": null, "lines": ["Dīghacārikavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Dīghacārikā vuttā, Atinivāsamaccharī.", "Dve ca Kulūpakā Bhogā, Bhattaṁ Sappāpare duveti."], "app": []}], "239": [{"label": null, "lines": ["Āvāsikavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Āvāsiko Piyo ca Sobhano, Bahūpakāro Anukampako ca.", "Tayo Avaṇṇārahā ceva, Macchariyā duvepi cāti1."], "app": []}], "249": [{"label": null, "lines": ["Duccaritavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Duccaritaṁ Kāyaduccaritaṁ, Vacīduccaritaṁ Manoduccaritaṁ.", "Catūhi pare dve Sivathikā, Puggalappasādena cāti."], "app": []}, {"label": null, "lines": ["Pañcamo paṇṇāsako samatto."], "app": []}], "258": [{"label": null, "lines": ["Upasampadāvaggo chaṭṭho."], "app": []}], "260": [{"label": null, "lines": ["Sammutipeyyālaṁ niṭṭhitaṁ."], "app": []}], "264": [{"label": null, "lines": ["Sikkhāpadapeyyālaṁ niṭṭhitaṁ."], "app": []}], "270": [{"label": null, "lines": ["Rāgapeyyālaṁ niṭṭhitaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Abhiññāya Pariññāya Parikkhayāya, Pahānāya Khayāya Vayena ca.", "Virāganirodhā Cāgañca, Paṭinissaggo ime dasāti."], "app": []}, {"label": null, "lines": ["Pañcakanipāto niṭṭhito."], "app": []}, {"plain": true, "head": "Tatridaṁ vagguddānaṁ", "hk": "sutta", "lines": [], "app": []}, {"label": null, "lines": ["Sekhabalaṁ Balañceva, Pañcaṅgikañca Sumanaṁ.", "Muṇḍanīvaraṇañca Saññañca, Yodhājīvañca aṭṭhamaṁ.", "Theraṁ Kakudhaphāsuñca, Andhakavinda dvādasaṁ.", "Gilānarājatikaṇḍaṁ, Saddhammāghātupāsakaṁ.", "Araññabrāhmaṇañceva, Kimilakkosakaṁ tathā.", "Dīghācārāvāsikañca, Duccaritūpasampadanti."], "app": []}, {"label": null, "lines": ["Pañcakanipātapāḷi niṭṭhitā."], "app": []}], "280": [{"label": null, "lines": ["Āhuneyyavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Āhuneyyā Indriya, balāni tayo Ājānīyā.", "Anuttariya Anussatī, Mahānāmena te dasāti."], "app": []}], "290": [{"label": null, "lines": ["Sāraṇīyavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Sāraṇī Nissāraṇīyaṁ, Bhaddakaṁ Anutappiyaṁ.", "Nakulaṁ Soppamacchā ca, dve honti Maraṇassatīti."], "app": []}], "300": [{"label": null, "lines": ["Anuttariyavaggo4 tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sāmako Aparihāniyo, Bhayaṁ Himavānussati.", "Kaccāno dve ca Samayā, Udāyī Anuttariyenāti."], "app": []}], "312": [{"label": null, "lines": ["Devatāvaggo2 catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sekhā dve Aparihāni, Moggallānavijjābhāgiyā.", "Vivādadānattakārī Nidānaṁ, Kimiladārukkhandhena Nāgitoti."], "app": []}], "319": [{"label": null, "lines": ["Sattamaṁ."], "app": []}], "324": [{"label": null, "lines": ["Dvādasamaṁ."], "app": []}, {"label": null, "lines": ["Dhammikavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Nāgamigasālā Iṇaṁ, Cundaṁ dve Sandiṭṭhikā duve.", "Khema-indriya Ānanda, Khattiyā Appamādena Dhammikoti."], "app": []}, {"label": null, "lines": ["Paṭhamo paṇṇāsako samatto."], "app": []}], "334": [{"label": null, "lines": ["Mahāvaggo chaṭṭho3."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Soṇo Phagguno Bhijāti, Āsavā Dāruhatthi ca.", "Majje Ñāṇaṁ Nibbedhikaṁ, Sīhanādoti te dasāti."], "app": []}], "344": [{"label": null, "lines": ["Devatāvaggo sattamo1."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Anāgāmi Arahaṁ Mittā, Saṅgaṇikārāmadevatā.", "Samādhi Sakkhibhabbaṁ Balaṁ, Tajjhānā apare duveti."], "app": []}], "354": [{"label": null, "lines": ["Arahattavaggo aṭṭhamo1."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dukkhaṁ Arahattaṁ Uttari ca, Sukhaṁ Adhigamena ca.", "Mahantattaṁ dvayaṁ Niraye1, Aggadhammañca Rattiyoti."], "app": []}], "365": [{"label": null, "lines": ["Sītivaggo navamo2."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sītibhāvaṁ Āvaraṇaṁ, Voropitā Susūsati.", "Appahāya Pahīnā’bhabbo, taṭṭhānā caturopi cāti."], "app": []}], "376": [{"label": null, "lines": ["Ānisaṁsavaggo dasamo1."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Pātubhāvo Ānisaṁso, Aniccadukkha-anattato.", "Nibbānaṁ Anavatthi Ukkhittāsi Atammayo,", "Bhavā Taṇhāyekā dasāti."], "app": []}, {"label": null, "lines": ["Dutiyo paṇṇāsako samatto."], "app": []}], "386": [{"label": null, "lines": ["Tikavaggo ekādasamo1."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Rāgaduccaritavitakka, Saññā Dhātūti vuccati.", "Assāda-aratituṭṭhi, duve ca Uddhaccena vaggoti."], "app": []}], "390": [{"label": null, "lines": ["Sāmaññavaggo dvādasamo."], "app": []}], "395": [{"label": null, "lines": ["Rāgapeyyālaṁ niṭṭhitaṁ."], "app": []}, {"label": null, "lines": ["Chakkanipātapāḷi niṭṭhitā."], "app": []}], "398": [{"label": null, "lines": ["Tatiyaṁ."], "app": []}], "399": [{"label": null, "lines": ["Catutthaṁ."], "app": []}], "405": [{"label": null, "lines": ["Dhanavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Piyāni Balaṁ Dhanaṁ, Saṁkhittañceva Vitthataṁ.", "Uggaṁ Saṁyojanañceva, Pahānaṁ Macchariyena cāti."], "app": []}], "415": [{"label": null, "lines": ["Anusayavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Duve Anusayā Kulaṁ, Puggalaṁ Udakūpamaṁ.", "Aniccaṁ Dukkhaṁ Anattā ca, Nibbānaṁ Niddasavatthu cāti."], "app": []}], "424": [{"label": null, "lines": ["Navamaṁ."], "app": []}], "426": [{"label": null, "lines": ["Ekādasamaṁ."], "app": []}, {"label": null, "lines": ["Vajjisattakavaggo1 tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sāranda Vassakāro ca, Tisattakāni Bhikkhukā.", "Bodhisaññā dve ca Hāni, Vipatti ca Parābhavoti."], "app": []}], "438": [{"label": null, "lines": ["Devatāvaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Appamādo Hirī ceva, dve Suvacā duve Mittā.", "Dve Paṭisambhidā dve Vasā, duve Niddasavatthunāti."], "app": []}], "448": [{"label": null, "lines": ["Mahāyaññavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Ṭhiti ca Parikkhāraṁ dve, Aggī Saññā ca dve parā.", "Methunā Saṁyogo Dānaṁ, Nandamātena te dasāti."], "app": []}, {"label": null, "lines": ["Paṇṇāsako samatto."], "app": []}], "459": [{"label": null, "lines": ["Abyākatavaggo chaṭṭho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Abyākato Purisagati, Tissa Sīha Arakkhiyaṁ.", "Kimilaṁ Satta Pacalā, Mettā Bhariyā Kodhekādasāti."], "app": []}], "469": [{"label": null, "lines": ["Mahāvaggo sattamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Hirīsūriyaṁ Upamā, Dhammaññū Pārichattakaṁ.", "Sakkaccaṁ Bhāvanā Aggi, Sunetta-arakena cāti."], "app": []}], "479": [{"label": null, "lines": ["Vinayavaggo aṭṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Caturo Vinayadharā, caturo ceva Sobhanā.", "Sāsanaṁ Adhikaraṇa-samathenaṭṭhame dasāti."], "app": []}], "489": [{"label": null, "lines": ["Samaṇavaggo navamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Bhikkhuṁ Samaṇo Brāhmaṇo, Sottiyo ceva Nhātako.", "Vedagū Ariyo Arahā, Asaddhammā ca Saddhammāti."], "app": []}], "491": [{"label": null, "lines": ["Āhuneyyavaggo dasamo."], "app": []}], "496": [{"label": null, "lines": ["Rāgapeyyālaṁ niṭṭhitaṁ."], "app": []}, {"label": null, "lines": ["Sattakanipātapāḷi niṭṭhitā."], "app": []}]}