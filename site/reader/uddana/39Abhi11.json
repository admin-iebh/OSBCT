{"25": [{"label": null, "lines": ["Anulomaṁ."], "app": []}, {"plain": true, "lines": ["Kilesaṁ dhammaṁ saṁsaṭṭho kileso dhammo uppajjati nahetupaccayā. (Evaṁ nahetupañhā cattāri kātabbā.)"], "app": []}, {"plain": true, "lines": ["Nahetuyā cattāri, na-adhipatiyā nava, napurejāte nava, napacchājāte nava, na-āsevane nava, nakamme tīṇi, navipāke nava, najhāne ekaṁ, namagge ekaṁ, navippayutte nava."], "app": []}, {"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "lines": ["(Evaṁ Itare dve gaṇanāpi Sampayuttavāropi kātabbo.)"], "app": []}], "52": [{"label": null, "lines": ["Kilesadukaṁ niṭṭhitaṁ."], "app": []}], "54": [{"label": null, "lines": ["Saṁkilesikadukaṁ niṭṭhitaṁ."], "app": []}], "75": [{"label": null, "lines": ["Anulomaṁ."], "app": []}], "76": [{"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "lines": ["(Evaṁ itare dve gaṇanāpi Sampayuttavāropi kātabbo.)"], "app": []}], "102": [{"label": null, "lines": ["Saṁkiliṭṭhadukaṁ niṭṭhitaṁ."], "app": []}], "104": [{"label": null, "lines": ["Kilesasampayuttadukaṁ niṭṭhitaṁ."], "app": []}], "113": [{"label": null, "lines": ["Kilesasaṁkilesikadukaṁ niṭṭhitaṁ."], "app": []}], "139": [{"label": null, "lines": ["Kilesasaṁkiliṭṭhadukaṁ niṭṭhitaṁ."], "app": []}], "141": [{"label": null, "lines": ["Kilesakilesasampayuttadukaṁ niṭṭhitaṁ."], "app": []}], "143": [{"label": null, "lines": ["Kilesavippayuttasaṁkilesikadukaṁ niṭṭhitaṁ."], "app": []}, {"label": null, "lines": ["Kilesagocchakaṁ niṭṭhitaṁ."], "app": []}], "165": [{"label": null, "lines": ["Anulomaṁ."], "app": []}], "166": [{"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "lines": ["(Evaṁ itare dve gaṇanāpi Sampayuttavāropi kātabbo.)"], "app": []}], "192": [{"label": null, "lines": ["Dassanena pahātabbadukaṁ niṭṭhitaṁ."], "app": []}], "194": [{"label": null, "lines": ["Anulomaṁ."], "app": []}, {"plain": true, "lines": ["Bhāvanāya pahātabbaṁ dhammaṁ paṭicca bhāvanāya pahātabbo dhammo uppajjati nahetupaccayā. Uddhaccasahagate khandhe paṭicca uddhaccasahagato moho."], "app": []}, {"plain": true, "lines": ["Nabhāvanāya pahātabbaṁ dhammaṁ paṭicca nabhāvanāya pahātabbo dhammo uppajjati nahetupaccayā. Ahetukaṁ nabhāvanāya pahātabbaṁ ekaṁ khandhaṁ -pa-. (Yāva asaññasattā.) Vicikicchāsahagate khandhe paṭicca vicikicchāsahagato moho. (Saṁkhittaṁ.)"], "app": []}, {"plain": true, "lines": ["Nahetuyā dve -pa- novigate tīṇi."], "app": []}, {"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "lines": ["(Paccayavārapaccanīye nahetupaccaye uddhaccasahagate tīṇi, moho uddharitabbo, sabbepi vārā dassanadukasadisā, uddhaccapaccanīyampi nānaṁ.)"], "app": []}], "208": [{"label": null, "lines": ["Bhāvanāya pahātabbadukaṁ niṭṭhitaṁ."], "app": []}], "239": [{"label": null, "lines": ["Anulomaṁ."], "app": []}], "240": [{"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "head": "Hetuduka", "hk": "sutta", "lines": ["Hetupaccayā na-adhipatiyā cattāri, napurejāte cattāri -pa- navippayutte cattāri."], "app": []}, {"plain": true, "head": "Nahetuduka", "hk": "sutta", "lines": ["Nahetupaccayā ārammaṇe dve, anantare dve -pa- vipāke ekaṁ -pa- avigate dve."], "app": []}, {"plain": true, "lines": ["(Sampayuttavāro Saṁsaṭṭhavārasadiso.)"], "app": []}], "269": [{"label": null, "lines": ["Dassanena pahātabbahetukadukaṁ niṭṭhitaṁ."], "app": []}], "281": [{"label": null, "lines": ["Bhāvanāya pahātabbahetukadukaṁ niṭṭhitaṁ."], "app": []}], "306": [{"label": null, "lines": ["Anulomaṁ."], "app": []}, {"plain": true, "lines": ["Savitakkaṁ dhammaṁ saṁsaṭṭho savitakko dhammo uppajjati nahetupaccayā. (Evaṁ cha pañhā kātabbā, anulomasadisā, “ahetukā”ti niyāmetabbā. Tīṇiyeva, moho uddharitabbo.)"], "app": []}, {"plain": true, "lines": ["Nahetuyā cha, na-adhipatiyā cha, napurejāte cha, napacchājāte cha, na-āsevane cha, nakamme cattāri, navipāke cha, najhāne ekaṁ, namagge cha, navippayutte cha."], "app": []}, {"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "lines": ["(Evaṁ itare dve gaṇanāpi Sampayuttavāropi kātabbo.)"], "app": []}], "328": [{"label": null, "lines": ["Anulomaṁ."], "app": []}], "335": [{"label": null, "lines": ["Savitakkadukaṁ niṭṭhitaṁ."], "app": []}], "337": [{"label": null, "lines": ["Savicāradukaṁ niṭṭhitaṁ."], "app": []}], "349": [{"label": null, "lines": ["Anulomaṁ."], "app": []}, {"plain": true, "lines": ["Sappītikaṁ dhammaṁ paccayā sappītiko dhammo uppajjati nahetupaccayā. Tīṇi. (Paṭiccasadisā.)"], "app": []}, {"plain": true, "lines": ["Appītikaṁ dhammaṁ paccayā appītiko dhammo uppajjati nahetupaccayā. (Pavattipaṭisandhi kātabbā. Paṭiccavārasadisā. Yāva asaññasattā.) Cakkhāyatanaṁ paccayā cakkhuviññāṇaṁ -pa-. Kāyāyatanaṁ paccayā kāyaviññāṇaṁ. Vatthuṁ paccayā ahetukā appītikā khandhā pīti ca. Vicikicchāsahagate uddhaccasahagate khandhe ca vatthuñca paccayā vicikicchāsahagato uddhaccasahagato moho. (Anulomasadisā. Nava pañhā pavattiyeva. Paṭisandhi natthi. Ekoyeva moho.)"], "app": []}, {"plain": true, "lines": ["Nahetuyā nava, na-ārammaṇe tīṇi, na-adhipatiyā nava, na-anantare tīṇi -pa- na-upanissaye tīṇi, napurejāte nava, napacchājāte nava, na-āsevane nava, nakamme nava, navipāke nava, na-āhāre ekaṁ, na-indriye ekaṁ, najhāne ekaṁ, namagge nava, nasampayutte tīṇi, navippayutte cha, nonatthiyā tīṇi, novigate tīṇi."], "app": []}, {"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "lines": ["(Evaṁ itare dve gaṇanāpi Sissayavāropi kātabbo.)"], "app": []}], "351": [{"label": null, "lines": ["Anulomaṁ."], "app": []}, {"plain": true, "lines": ["Nahetuyā cha, na-adhipatiyā cha, napurejāte cha, napacchājāte cha, na-āsevane cha, nakamme cattāri, navipāke cha, najhāne ekaṁ, namagge cha, navippayutte cha."], "app": []}, {"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "lines": ["(Evaṁ itare dve gaṇanāpi Sampayuttavāropi kātabbo.)"], "app": []}], "369": [{"label": null, "lines": ["Anulomaṁ."], "app": []}], "372": [{"label": null, "lines": ["Sappītikadukaṁ niṭṭhitaṁ."], "app": []}], "374": [{"label": null, "lines": ["Pītisahagatadukaṁ niṭṭhitaṁ."], "app": []}], "376": [{"label": null, "lines": ["Anulomaṁ."], "app": []}], "377": [{"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"label": null, "lines": ["(Evaṁ itare dve gaṇanāpi Sahajātavāropi Paṭiccavārasadisā."], "app": []}, {"plain": true, "lines": ["Paccayavāre pavattipi paṭisandhipi vitthāretabbā, yathā"], "app": []}, {"plain": true, "lines": ["sappītikadukapaccavārapaccanīyepi pavatte vatthu ca vitthāretabbaṁ,"], "app": []}, {"plain": true, "lines": ["yathā sappītikaduke ekoyeva moho, evaṁ itare dve gaṇanāpi"], "app": []}, {"plain": true, "lines": ["Nissayavāropi Saṁsaṭṭhavāropi Sampayuttavāropi yathā"], "app": []}, {"plain": true, "lines": ["sappītikadukaṁ, evaṁ kātabbaṁ.)"], "app": []}], "387": [{"label": null, "lines": ["Sukhasahagatadukaṁ niṭṭhitaṁ."], "app": []}], "400": [{"label": null, "lines": ["Anulomaṁ."], "app": []}], "401": [{"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "lines": ["(Evaṁ itare dve gaṇanāpi Nissayavāropi kātabbo.)"], "app": []}], "403": [{"label": null, "lines": ["Anulomaṁ."], "app": []}, {"plain": true, "lines": ["Upekkhāsahagataṁ dhammaṁ saṁsaṭṭho upekkhāsahagato dhammo uppajjati nahetupaccayā. Ahetukaṁ upekkhāsahagataṁ ekaṁ khandhaṁ saṁsaṭṭhā dve khandhā. Dve khandhe -pa-. Ahetukapaṭisandhikkhaṇe -pa-. Vicikicchāsahagate uddhaccasahagate khandhe saṁsaṭṭho vicikicchāsahagato uddhaccasahagato moho. (Evaṁ pañca pañhā yathā savitakkaduke, evaṁ kātabbā.)"], "app": []}, {"plain": true, "lines": ["Nahetuyā cha, na-adhipatiyā cha, napurejāte cha, napacchājāte cha, na-āsevane cha, nakamme cattāri, navipāke cha, navippayutte cha."], "app": []}, {"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "lines": ["(Evaṁ itare dve gaṇanāpi Sampayuttavāropi kātabbo.)"], "app": []}], "414": [{"label": null, "lines": ["Upekkhāsahagatadukaṁ niṭṭhitaṁ."], "app": []}], "429": [{"label": null, "lines": ["Anulomaṁ."], "app": []}], "431": [{"plain": true, "head": "Suddha", "hk": "sutta", "lines": ["Nahetuyā ekaṁ, na-ārammaṇe tīṇi, na-adhipatiyā nava, na-anantare tīṇi, nasamanantare tīṇi, na-upanissaye tīṇi, napurejāte nava, napacchājāte nava, na-āsevane nava, nakamme cattāri, navipāke nava, na-āhāre ekaṁ, na-indriye ekaṁ, najhāne ekaṁ, namagge ekaṁ, nasampayutte tīṇi, navippayutte dve, nonatthiyā tīṇi, novigate tīṇi."], "app": []}, {"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "lines": ["(Evaṁ itare dve gaṇanāpi Nissayavāropi kātabbo.)"], "app": []}], "433": [{"label": null, "lines": ["Anulomaṁ."], "app": []}, {"plain": true, "lines": ["Kāmāvacaraṁ dhammaṁ saṁsaṭṭho kāmāvacaro dhammo uppajjati nahetupaccayā. Ahetukaṁ kāmāvacaraṁ ekaṁ khandhaṁ saṁsaṭṭhā tayo khandhā -pa- dve khandhe -pa-. Ahetukapaṭisandhikkhaṇe -pa-. Vicikicchāsahagate uddhaccasahagate khandhe saṁsaṭṭho vicikicchāsahagato uddhaccasahagato moho."], "app": []}, {"plain": true, "lines": ["Nahetuyā ekaṁ, na-adhipatiyā dve, napurejāte dve, napacchājāte dve, na-āsevane dve, nakamme dve, navipāke dve, najhāne ekaṁ, namagge ekaṁ, navippayutte dve."], "app": []}, {"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "lines": ["(Evaṁ itare dve gaṇanāpi Sampayuttavāropi kātabbo.)"], "app": []}], "457": [{"label": null, "lines": ["Kāmāvacaradukaṁ niṭṭhitaṁ."], "app": []}], "487": [{"label": null, "lines": ["Anulomaṁ."], "app": []}, {"plain": true, "lines": ["Narūpāvacaraṁ dhammaṁ saṁsaṭṭho narūpāvacaro dhammo uppajjati nahetupaccayā. (Saṁkhittaṁ.)"], "app": []}, {"plain": true, "lines": ["Nahetuyā ekaṁ, na-adhipatiyā dve, napurejāte dve, napacchājāte dve, na-āsevane dve, nakamme dve, navipāke dve, najhāne ekaṁ, namagge ekaṁ, navippayutte ekaṁ."], "app": []}, {"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "lines": ["(Evaṁ itare dve gaṇanāpi Sampayuttavāropi kātabbo.)"], "app": []}], "511": [{"label": null, "lines": ["Rūpāvacaradukaṁ niṭṭhitaṁ."], "app": []}], "560": [{"label": null, "lines": ["Arūpāvacaradukaṁ niṭṭhitaṁ."], "app": []}], "562": [{"label": null, "lines": ["Pariyāpannadukaṁ niṭṭhitaṁ."], "app": []}], "600": [{"label": null, "lines": ["Anulomaṁ."], "app": []}], "606": [{"label": null, "lines": ["Niyyānikadukaṁ niṭṭhitaṁ."], "app": []}], "627": [{"label": null, "lines": ["Niyatadukaṁ niṭṭhitaṁ."], "app": []}], "629": [{"label": null, "lines": ["Sa-uttaradukaṁ niṭṭhitaṁ."], "app": []}], "631": [{"label": null, "lines": ["Anulomaṁ."], "app": []}, {"plain": true, "lines": ["Saraṇaṁ dhammaṁ paṭicca saraṇo dhammo uppajjati nahetupaccayā. Vicikicchāsahagate uddhaccasahagate khandhe paṭicca vicikicchāsahagato uddhaccasahagato moho. (1)"], "app": []}, {"plain": true, "lines": ["Araṇaṁ dhammaṁ paṭicca araṇo dhammo uppajjati nahetupaccayā. Ahetukaṁ araṇaṁ ekaṁ khandhaṁ paṭicca tayo khandhā cittasamuṭṭhānañca rūpaṁ -pa- dve khandhe -pa-. Ahetukapaṭisandhikkhaṇe -pa-. (Yāva asaññasattā.) (1)"], "app": []}, {"plain": true, "lines": ["Nahetuyā dve, na-ārammaṇe tīṇi, na-adhipatiyā pañca, na-anantare tīṇi, na-upanissaye tīṇi, napurejāte cattāri, napacchājāte pañca, na-āsevane pañca, nakamme dve, navipāke pañca, na-āhāre ekaṁ, na-indriye ekaṁ, najhāne ekaṁ, namagge ekaṁ, nasampayutte tīṇi, navippayutte dve, nonatthiyā tīṇi, novigate tīṇi."], "app": []}, {"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "lines": ["(Evaṁ itare dve gaṇanāpi Sahajātavāropi kātabbo.)"], "app": []}], "633": [{"label": null, "lines": ["Anulomaṁ."], "app": []}], "634": [{"label": null, "lines": ["Paccanīyaṁ."], "app": []}, {"plain": true, "lines": ["(Evaṁ itare dve gaṇanāpi Nissayavāropi kātabbo, Saṁsaṭṭhavārepi dve pañhā kātabbā. Sabbattha.)"], "app": []}, {"plain": true, "lines": ["Hetuyā dve, ārammaṇe dve, (sabbattha dve.) Vipāke ekaṁ, avigate dve. (Anulomaṁ.)"], "app": []}, {"plain": true, "lines": ["Nahetuyā dve, na-adhipatiyā dve, napurejāte dve, napacchājāte dve, na-āsevane dve, nakamme dve, navipāke dve, najhāne ekaṁ, namagge ekaṁ, navippayutte dve.