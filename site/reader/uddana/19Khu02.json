 []}], "2104": [{"label": null, "lines": ["Abhibhūto thero."], "app": []}], "2107": [{"label": null, "lines": ["Gotamo thero."], "app": []}], "2110": [{"label": null, "lines": ["Hārito thero."], "app": []}], "2113": [{"label": null, "lines": ["Vimalo thero."], "app": []}, {"label": null, "lines": ["Tikanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Aṅgaṇiko Bhāradvājo, Paccayo Bākulo isi.", "Dhaniyo Mātaṅgaputto, Sobhito Vāraṇo isi.", "Vassiko ca Yasojo ca, Sāṭimattiyupāli ca.", "Uttarapālo Abhibhūto, Gotamo Hāritopi ca.", "Thero tikanipātamhi, nibbāne Vimalo kato.", "Aṭṭhatālīsa gāthāyo, thero soḷasa kittitāti."], "app": []}], "2117": [{"label": null, "lines": ["Nāgasamālo thero."], "app": []}], "2121": [{"label": null, "lines": ["Bhagutthero."], "app": []}], "2125": [{"label": null, "lines": ["Sabhiyo thero."], "app": []}], "2129": [{"label": null, "lines": ["Nandako thero."], "app": []}], "2133": [{"label": null, "lines": ["Jambuko thero."], "app": []}], "2137": [{"label": null, "lines": ["Senako thero."], "app": []}], "2141": [{"label": null, "lines": ["Sambhūto thero."], "app": []}], "2145": [{"label": null, "lines": ["Rāhulo thero."], "app": []}], "2149": [{"label": null, "lines": ["Candano thero."], "app": []}], "2153": [{"label": null, "lines": ["Dhammiko thero."], "app": []}], "2157": [{"label": null, "lines": ["Sappako thero."], "app": []}], "2161": [{"label": null, "lines": ["Mudito thero."], "app": []}, {"label": null, "lines": ["Catukkanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Nāgasamālo Bhagu ca, Sabhiyo Nandakopi ca.", "Jambuko Senako thero, Sambhūto Rāhulopi ca.", "Bhavati Candano thero, dasete1 Buddhasāvakā.", "Dhammiko Sappako thero, Mudito cāpi te tayo.", "Gāthāyo dve ca paññāsa, therā sabbepi terasāti2."], "app": []}], "2166": [{"label": null, "lines": ["Rājadatto thero."], "app": []}], "2171": [{"label": null, "lines": ["Subhūto thero."], "app": []}], "2176": [{"label": null, "lines": ["Girimānando thero."], "app": []}], "2181": [{"label": null, "lines": ["Sumano thero."], "app": []}], "2186": [{"label": null, "lines": ["Vaḍḍho thero."], "app": []}], "2191": [{"label": null, "lines": ["Nadīkassapo thero."], "app": []}], "2196": [{"label": null, "lines": ["Gayākassapo thero."], "app": []}], "2201": [{"label": null, "lines": ["Vakkalitthero."], "app": []}], "2206": [{"label": null, "lines": ["Vijitaseno thero."], "app": []}], "2211": [{"label": null, "lines": ["Yasadatto thero."], "app": []}], "2216": [{"label": null, "lines": ["Soṇo kuṭikaṇṇathero."], "app": []}], "2221": [{"label": null, "lines": ["Kosiyo thero."], "app": []}, {"label": null, "lines": ["Pañcakanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Rājadatto Subhūto ca, Girimānandasumanā.", "Vaḍḍho ca Kassapo thero, Gayākassapavakkalī.", "Vijito Yasadatto ca, Soṇo Kosiyasavhayo.", "Saṭṭhi ca pañca gāthāyo, therā ca ettha dvādasāti."], "app": []}], "2227": [{"label": null, "lines": ["Uruveḷakassapo thero."], "app": []}], "2233": [{"label": null, "lines": ["Tekicchakārī1 thero."], "app": []}], "2239": [{"label": null, "lines": ["Mahānāgo thero."], "app": []}], "2245": [{"label": null, "lines": ["Kullo thero."], "app": []}], "2251": [{"label": null, "lines": ["Mālukyaputto5 thero."], "app": []}], "2257": [{"label": null, "lines": ["Sappadāso thero."], "app": []}], "2263": [{"label": null, "lines": ["Kātiyāno thero."], "app": []}], "2269": [{"label": null, "lines": ["Migajālo thero."], "app": []}], "2275": [{"label": null, "lines": ["Jento purohitaputto thero."], "app": []}], "2281": [{"label": null, "lines": ["Sumano thero."], "app": []}], "2287": [{"label": null, "lines": ["Nhātakamunitthero."], "app": []}], "2293": [{"label": null, "lines": ["Brahmadatto thero."], "app": []}], "2299": [{"label": null, "lines": ["Sirimaṇḍo2 thero."], "app": []}], "2305": [{"label": null, "lines": ["Sabbakāmitthero."], "app": []}, {"label": null, "lines": ["Chakkanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Uruveḷakassapo ca, thero Tekicchakāri ca.", "Mahānāgo ca Kullo ca, Mālukyo1 Sappadāsako.", "Kātiyāno Migajālo, Jento Sumanasavhayo.", "Nhātamuni Brahmadatto, Sirimaṇḍo Sabbakāmī ca.", "Gāthāyo caturāsīti, therā cettha catuddasāti."], "app": []}], "2312": [{"label": null, "lines": ["Sundarasamuddo thero."], "app": []}], "2319": [{"label": null, "lines": ["Lakuṇḍakabhaddiyo thero."], "app": []}], "2326": [{"label": null, "lines": ["Bhaddo thero."], "app": []}], "2333": [{"label": null, "lines": ["Sopāko thero."], "app": []}], "2340": [{"label": null, "lines": ["Sarabhaṅgo thero."], "app": []}, {"label": null, "lines": ["Sattakanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Sundarasamuddo thero, thero Lakuṇḍabhaddiyo.", "Bhaddo thero ca Sopāko, Sarabhaṅgo mahā-isi.", "Sattake pañcakā therā, gāthāyo pañcatiṁsatīti."], "app": []}], "2348": [{"label": null, "lines": ["Mahākaccāyano thero."], "app": []}], "2356": [{"label": null, "lines": ["Sirimitto thero."], "app": []}], "2364": [{"label": null, "lines": ["Mahāpanthako thero."], "app": []}, {"label": null, "lines": ["Aṭṭhakanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Mahākaccāyano thero, Sirimitto Mahāpanthako.", "Ete aṭṭhanipātamhi, gāthāyo catuvīsatīti."], "app": []}], "2373": [{"label": null, "lines": ["Bhūto thero."], "app": []}, {"label": null, "lines": ["Navakanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Bhūto tathaddaso thero, eko khaggavisāṇavā.", "Navakamhi nipātamhi, gāthāyopi imā navāti."], "app": []}], "2383": [{"label": null, "lines": ["Kāḷudāyī thero."], "app": []}], "2393": [{"label": null, "lines": ["Ekavihāriyo thero."], "app": []}], "2403": [{"label": null, "lines": ["Mahākappino thero."], "app": []}], "2413": [{"label": null, "lines": ["Cūḷapanthako thero."], "app": []}], "2423": [{"label": null, "lines": ["Kappo thero."], "app": []}], "2433": [{"label": null, "lines": ["Upaseno Vaṅgantaputto thero."], "app": []}], "2443": [{"label": null, "lines": ["Gotamo thero."], "app": []}, {"label": null, "lines": ["Dasakanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Kāḷudāyī ca so thero, Ekavihārī ca Kappino.", "Cūḷapanthako Kappo ca, Upaseno ca Gotamo.", "Sattime dasake thero, gāthāyo cettha sattatīti."], "app": []}], "2454": [{"label": null, "lines": ["Saṁkicco thero."], "app": []}, {"label": null, "lines": ["Ekādasanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Saṁkiccathero ekova, katakicco anāsavo.", "Ekādasanipātamhi, gāthā ekādaseva cāti."], "app": []}], "2466": [{"label": null, "lines": ["Sīlavo thero."], "app": []}], "2478": [{"label": null, "lines": ["Sunīto thero."], "app": []}, {"label": null, "lines": ["Dvādasanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Sīlavā ca Sunīto ca, therā dve te mahiddhikā.", "Dvādasamhi nipātamhi, gāthāyo catuvīsatīti."], "app": []}], "2491": [{"label": null, "lines": ["Soṇo koḷiviso thero."], "app": []}, {"label": null, "lines": ["Terasanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Soṇo koḷiviso thero, ekoyeva mahiddhiko.", "Terasamhi nipātamhi, gāthāyo cettha terasāti."], "app": []}], "2505": [{"label": null, "lines": ["Khadiravaniyarevato thero."], "app": []}], "2519": [{"label": null, "lines": ["Godatto thero."], "app": []}, {"label": null, "lines": ["Cuddasakanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Revato ceva Godatto, therā dve te mahiddhikā.", "Cuddasamhi nipātamhi, gāthāyo aṭṭhavīsatīti."], "app": []}], "2535": [{"label": null, "lines": ["Aññāsikoṇḍañño1 thero."], "app": []}], "2551": [{"label": null, "lines": ["Udāyīthero."], "app": []}, {"label": null, "lines": ["Soḷasakanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Koṇḍañño ca Udāyī ca, therā dve te mahiddhikā.", "Soḷasamhi nipātamhi, gāthāyo dve ca tiṁsa cāti."], "app": []}], "2572": [{"label": null, "lines": ["Adhimutto thero."], "app": []}], "2593": [{"label": null, "lines": ["Pārāpariyo thero."], "app": []}], "2615": [{"label": null, "lines": ["Telakāni thero."], "app": []}], "2640": [{"label": null, "lines": ["Raṭṭhapālo thero."], "app": []}], "2664": [{"label": null, "lines": ["Mālukyaputto thero."], "app": []}], "2688": [{"label": null, "lines": ["Selo thero."], "app": []}], "2712": [{"label": null, "lines": ["Bhaddiyo Kāḷigodhāya putto thero."], "app": []}], "2738": [{"label": null, "lines": ["Aṅgulimālo thero."], "app": []}], "2766": [{"label": null, "lines": ["Anuruddho thero."], "app": []}], "2795": [{"label": null, "lines": ["Pārāpariyo1 thero."], "app": []}, {"label": null, "lines": ["Vīsatinipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Adhimutto Pārāpariyo, Telakāni Raṭṭhapālo.", "Mālukyaselo Bhaddiyo, Aṅguli dibbacakkhuko.", "Pārāpariyo dasete, vīsamhi parikittitā.", "Gāthāyo dve satā honti, pañcatālīsa2 uttarinti."], "app": []}], "2827": [{"label": null, "lines": ["Phusso thero."], "app": []}], "2863": [{"label": null, "lines": ["Sāriputto thero."], "app": []}], "2900": [{"label": null, "lines": ["Ānando thero."], "app": []}, {"label": null, "lines": ["Tiṁsanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Phussopatisso Ānando, tayotime pakittitā.", "Gāthāyo tattha saṅkhātā, sataṁ pañca ca uttarīti."], "app": []}], "2940": [{"label": null, "lines": ["Mahākassapo thero."], "app": []}, {"label": null, "lines": ["Cattālīsanipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Cattālīsanipātamhi, Mahākassapasavhayo.", "Ekova thero gāthāyo, cattālīsa duvepi cāti."], "app": []}], "2995": [{"label": null, "lines": ["Tālapuṭo thero."], "app": []}, {"label": null, "lines": ["Paññāsanipāto niṭṭhito."], "app": []}, {"label": null, "lines": ["Tatrūddānaṁ", "Paññāsamhi nipātamhi, eko Tālapuṭo suci.", "Gāthāyo tattha paññāsa, puna pañca ca uttarīti."], "app": []}], "3064": [{"label": null, "lines": ["Saṭṭhinipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Saṭṭhikamhi nipātamhi, Moggallāno mahiddhiko.", "Ekova theragāthāyo, aṭṭhasaṭṭhi bhavanti tāti."], "app": []}], "3135": [{"label": null, "lines": ["Mahānipāto niṭṭhito."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Sattatimhi nipātamhi, Vaṅgīso paṭibhāṇavā.", "Ekova thero natthañño, gāthāyo ekasattatīti.", "Niṭṭhitā theragāthāyo."], "app": []}, {"label": "Tatruddānaṁ", "lines": ["Sahassaṁ honti tā gāthā, tīṇi saṭṭhisatāni ca.", "Therā ca dve satā saṭṭhi, cattāro ca pakāsitā.", "Sīhanādaṁ naditvāna, Buddhaputtā anāsavā.", "Khemantaṁ pāpuṇitvāna, aggikhandhāva nibbutāti.", "Theragāthāpāḷi niṭṭhitā."], "app": []}], "3139": [{"label": null, "lines": ["Tissā therī."], "app": []}], "3140": [{"label": null, "lines": ["Aññatarā Tissā therī."], "app": []}], "3141": [{"label": null, "lines": ["Dhīrā therī."], "app": []}], "3142": [{"label": null, "lines": ["Vīrā therī."], "app": []}], "3143": [{"label": null, "lines": ["Mittā therī."], "app": []}], "3144": [{"label": null, "lines": ["Bhadrā therī."], "app": []}], "3145": [{"label": null, "lines": ["Upasamā therī."], "app": []}], "3146": [{"label": null, "lines": ["Muttā therī."], "app": []}], "3147": [{"label": null, "lines": ["Dhammadinnā therī."], "app": []}], "3148": [{"label": null, "lines": ["Visākhā therī."], "app": []}], "3149": [{"label": null, "lines": ["Sumanā therī."], "app": []}], "3150": [{"label": null, "lines": ["Uttarā therī."], "app": []}], "3151": [{"label": null, "lines": ["Sumanā vuḍḍhapabbajitā therī."], "app": []}], "3152": [{"label": null, "lines": ["Dhammā therī."], "app": []}], "3153": [{"label": null, "lines": ["Saṁghā therī."], "app": []}, {"label": null, "lines": ["Ekakanipāto niṭṭhito."], "app": []}], "3159": [{"label": null, "lines": ["Sumaṅgalamātā therī3."], "app": []}], "3161": [{"label": null, "lines": ["Aḍḍhakāsi therī."], "app": []}], "3163": [{"label": null, "lines": ["Cittā therī."], "app": []}], "3165": [{"label": null, "lines": ["Mettikā therī."], "app": []