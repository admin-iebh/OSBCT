abel": null, "lines": ["Iti vīsatimaparicchedavaṇṇanā."], "app": []}], "381": [{"label": null, "lines": ["Bhaṅgānupassanāñāṇaṁ niṭṭhitaṁ."], "app": []}], "383": [{"label": null, "lines": ["Bhayatupaṭṭhānañāṇaṁ niṭṭhitaṁ."], "app": []}], "385": [{"label": null, "lines": ["Ādīnavānupassanāñāṇaṁ niṭṭhitaṁ."], "app": []}], "386": [{"label": null, "lines": ["Nibbidānupassanāñāṇaṁ niṭṭhitaṁ."], "app": []}], "388": [{"label": null, "lines": ["Muñcitukamyatāñāṇaṁ niṭṭhitaṁ."], "app": []}], "391": [{"label": null, "lines": ["Paṭisaṅkhānupassanāñāṇaṁ niṭṭhitaṁ."], "app": []}], "409": [{"label": null, "lines": ["Saṅkhārupekkhāñāṇaṁ."], "app": []}], "433": [{"label": null, "lines": ["Saṅkhārupekkhāñāṇaṁ niṭṭhitaṁ."], "app": []}], "434": [{"label": null, "lines": ["Anulomañāṇaṁ niṭṭhitaṁ."], "app": []}], "435": [{"label": null, "lines": ["Paṭipadāñāṇadassanavisuddhiniddesavaṇṇanā niṭṭhitā."], "app": []}, {"label": null, "lines": ["Iti ekavīsatimaparicchedavaṇṇanā."], "app": []}], "440": [{"label": null, "lines": ["Paṭhamamaggañāṇaṁ niṭṭhitaṁ."], "app": []}], "443": [{"label": null, "lines": ["Dutiyañāṇaṁ niṭṭhitaṁ."], "app": []}], "444": [{"label": null, "lines": ["Tatiyañāṇaṁ niṭṭhitaṁ."], "app": []}], "445": [{"label": null, "lines": ["Catutthañāṇaṁ niṭṭhitaṁ."], "app": []}], "482": [{"label": null, "lines": ["Ñāṇadassanavisuddhiniddesavaṇṇanā niṭṭhitā."], "app": []}, {"label": null, "lines": ["Iti bāvīsatimaparicchedavaṇṇanā."], "app": []}], "518": [{"label": null, "lines": ["Paññābhāvanānisaṁsaniddesavaṇṇanā niṭṭhitā."], "app": []}, {"label": null, "lines": ["Iti tevīsatimaparicchedavaṇṇanā."], "app": []}], "520": [{"plain": true, "head": "Nigamanagāthāyo", "hk": "sutta", "lines": ["Ettāvatā ca–"], "app": []}, {"label": null, "lines": ["Suvisuddhasamācāro1, visuddhanayamaṇḍitaṁ.", "Visuddhimaggaṁ lokassa, yadaccantavisuddhiyā.", "Abhāsi karuṇāvega-samussāhitamānaso.", "Mahesi vipulodāta2-visuddhimatipāṭavo.", "Tassa atthaṁ pakāsetuṁ, kathāmaggaṁ purātanaṁ.", "Nissāya yā samāraddhā, atthasaṁvaṇṇanā mayā.", "Āyācito siddhagāma-pariveṇanivāsinā.", "Therena dāṭhanāgena, suddhācārena dhīmatā.", "Sā esā paramatthānaṁ, tattha tattha yathārahaṁ.", "Nidhānato paramattha-mañjūsā nāma nāmato.", "Sampattā pariniṭṭhānaṁ, anākulavinicchayā.", "Aṭṭhāsītippamāṇāya, pāḷiyā bhāṇavārato.", "Iti taṁ saṅkharontena, yaṁ taṁ adhigataṁ mayā.", "Puññaṁ tassānubhāvena, lokanāthassa sāsane.", "Ogāhetvā visuddhāya, sīlādipaṭipattiyā.", "Sabbepi dehino hontu, vimuttirasabhāgino.", "Ciraṁ tiṭṭhatu lokasmiṁ, sammāsambuddhasāsanaṁ.", "Tasmiṁ sagāravā niccaṁ, hontu sabbepi pāṇino.", "Sammā vassatu kālena, devo, rājā mahīpati.", "Saddhammanirato lokaṁ, dhammeneva pasāsatūti."], "app": []}, {"plain": true, "lines": ["Badaratitthavihāravāsinā ācariyadhammapālena katā paramatthamañjūsā nāma visuddhimaggamahāṭīkā samattā."], "app": []}, {"label": null, "lines": ["Visuddhimaggamahāṭīkā samattā."], "app": []}]}