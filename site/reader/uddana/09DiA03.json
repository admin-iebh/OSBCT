, "281": [{"label": null, "lines": ["Sumaṅgalavilāsiniyā Dīghanikāyaṭṭhakathāya"], "app": []}, {"label": null, "lines": ["Saṅgītisuttavaṇṇanā niṭṭhitā."], "app": []}], "283": [{"label": null, "lines": ["(Kha) Bhāvetabboti vaḍḍhetabbo."], "app": []}, {"label": null, "lines": ["(Ga)     Pariññeyyoti tīhi pariññāhi parijānitabbo."], "app": []}, {"label": null, "lines": ["(Gha) Pahātabboti pahānānupassanāya pajahitabbo."], "app": []}, {"label": null, "lines": ["(Ṅa)     Hānabhāgiyoti apāyagāmiparihānāya saṁvattanako."], "app": []}, {"label": null, "lines": ["(Ca)     Visesabhāgiyoti visesagāmivisesāya saṁvattanako."], "app": []}, {"label": null, "lines": ["(Cha)    Duppaṭivijjhoti duppaccakkhakaro."], "app": []}, {"label": null, "lines": ["(Ja)     Uppādetabboti nipphādetabbo."], "app": []}, {"label": null, "lines": ["(Jha)    Abhiññeyyoti ñatapariññāya abhijānitabbo."], "app": []}, {"label": null, "lines": ["(Ña)     Sacchikātabboti paccakkhaṁ kātabbo."], "app": []}, {"label": null, "lines": ["Iti tebhūmakadhammameva niyameti."], "app": []}, {"label": null, "lines": ["uppathamanasikāro."], "app": []}, {"label": null, "lines": ["phaladayakattā ānantariko cetosamādhīti adhippeto."], "app": []}, {"label": null, "lines": ["Idha paccavekkhaṇapaññā adhippetā."], "app": []}, {"label": null, "lines": ["Ekadhammavaṇṇanā niṭṭhitā."], "app": []}], "284": [{"label": null, "lines": ["sīlapūraṇādīsu appamādo viya sabbattha upakārakā hitāvahā."], "app": []}, {"label": null, "lines": ["kathitā. Imasmiṁ Dasuttarasutte pubbabhāgā kathitā."], "app": []}, {"label": null, "lines": ["dhātūti paccayehi akataṁ nibbānaṁ."], "app": []}, {"label": null, "lines": ["arahattaphalaṁ."], "app": []}, {"label": null, "lines": ["Dvedhammavaṇṇanā niṭṭhitā."], "app": []}], "285": [{"label": null, "lines": ["saṅkhatanirodhassa1 paccayattā nirodhoti vuttaṁ."], "app": []}, {"label": null, "lines": ["itaresupi esevanayo."], "app": []}, {"label": null, "lines": ["Tayodhammavaṇṇanā niṭṭhitā."], "app": []}], "286": [{"label": null, "lines": ["Cattārodhammavaṇṇanā niṭṭhitā."], "app": []}], "292": [{"label": null, "lines": ["Sumaṅgalavilāsiniyā Dīghanikāyaṭṭhakathāya"], "app": []}, {"label": null, "lines": ["Dasuttarasuttavaṇṇanā niṭṭhitā."], "app": []}, {"label": null, "lines": ["Niṭṭhitā ca Pāthikavaggassa vaṇṇanāti."], "app": []}, {"label": null, "lines": ["Pāthikavaggaṭṭhakathā niṭṭhitā."], "app": []}, {"plain": true, "head": "Nigamanakathā", "hk": "sutta", "lines": ["Ettāvatā ca–"], "app": []}, {"label": null, "lines": ["Āyācito Sumaṅgala, pariveṇanivāsinā thiraguṇena.", "Dāṭhānāgasaṁghattherena, theravaṁsanvayena1.", "Dīghāgamavarassa Dasabala, guṇagaṇaparidīpanassa aṭṭhakathaṁ.", "Yaṁ ārabhiṁ Sumaṅgala, vilāsiniṁ nāma nāmena.", "Sā hi mahāṭṭhakathāya, sāramādāya niṭṭhitā.", "Esā ekāsītipamāṇāya, pāḷiyā bhāṇavārehi.", "Ekūnasaṭṭhimatto, Visuddhimaggopi bhāṇavārehi.", "Atthappakāsanatthāya, āgamānaṁ kato yasmā.", "Tasmā tena sahā’yaṁ, aṭṭhakathā bhāṇavāragaṇanāya.", "Suparimitaparicchinnaṁ, cattālīsasataṁ hoti.", "Sabbaṁ cattālīsādhikasata, parimāṇaṁ bhāṇavārato evaṁ.", "Samayaṁ pakāsayantiṁ2, Mahāvihāre nivāsinaṁ.", "Mūlakaṭṭhakathāsāra, mādāya mayā imaṁ karontena.", "Yaṁ puññamupacitaṁ tena, hotu sabbo sukhī lokoti."], "app": []}, {"plain": true, "lines": ["Paramavisuddhasaddhābuddhivīriyapaṭimaṇḍitena sīlācārajjavamaddavādiguṇa samudayasamuditena sakasamayasamayantaragahanajjhogāhaṇasamatthena paññā veyyattiyasamannāgatena tipiṭakapariyattippabhede sāṭṭhakathe Satthusāsane appaṭihata ñāṇappabhāvena mahāveyyākaraṇena karaṇasampattijanitasukhaviniggatamadhurodāra vacanalāvaṇṇayuttena yuttamuttavādinā vādīvarena mahākavinā pabhinnapaṭisambhidā parivāre chaḷabhiññādippabhedaguṇapaṭimaṇḍite uttarimanussadhamme suppatiṭṭhita Buddhīnaṁ theravaṁsappadīpānaṁ therānaṁ Mahāvihāravāsīnaṁ vaṁsālaṅkārabhūtena vipulavisuddhabuddhinā Buddhaghosoti garūhi gahitanāmadheyyena therena katā ayaṁ Sumaṅgalavilāsinī nāma Dīghanikāyaṭṭhakathā– Tāva tiṭṭhatu lokasmiṁ, lokanittharaṇesinaṁ. Dassentī kulaputtānaṁ, nayaṁ diṭṭhivisuddhiyā. Yāva Buddhoti nāmampi, suddhacittassa tādino. Lokamhi Lokajeṭṭhassa, pavattati Mahesinoti."], "app": []}, {"label": null, "lines": ["Sumaṅgalavilāsinī nāma"], "app": []}, {"plain": true, "lines": ["Dīghanikāyaṭṭhakathā niṭṭhitā."], "app": []}]}