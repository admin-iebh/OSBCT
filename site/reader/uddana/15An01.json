{"9": [{"label": null, "lines": ["Rūpādivaggo paṭhamo."], "app": []}], "19": [{"label": null, "lines": ["Nīvaraṇappahānavaggo dutiyo."], "app": []}], "29": [{"label": null, "lines": ["Akammaniyavaggo tatiyo."], "app": []}], "39": [{"label": null, "lines": ["Adantavaggo catuttho."], "app": []}], "49": [{"label": null, "lines": ["Paṇihita-acchavaggo pañcamo."], "app": []}], "59": [{"label": null, "lines": ["Accharāsaṅghātavaggo chaṭṭho."], "app": []}], "69": [{"label": null, "lines": ["Vīriyārambhādivaggo sattamo."], "app": []}], "79": [{"label": null, "lines": ["Kalyāṇamittādivaggo aṭṭhamo."], "app": []}], "96": [{"label": null, "lines": ["Pamādādivaggo navamo."], "app": []}], "114": [{"label": null, "lines": ["Dutiyapamādādivaggo dasamo."], "app": []}], "117": [{"label": null, "lines": ["Adhammavaggo ekādasamo."], "app": []}], "123": [{"label": null, "lines": ["Anāpattivaggo dvādasamo."], "app": []}], "130": [{"label": null, "lines": ["Ekapuggalavaggo terasamo."], "app": []}], "140": [{"label": null, "lines": ["Vaggo paṭhamo."], "app": []}], "151": [{"label": null, "lines": ["Vaggo dutiyo."], "app": []}], "161": [{"label": null, "lines": ["Vaggo tatiyo."], "app": []}], "177": [{"label": null, "lines": ["Vaggo catuttho."], "app": []}], "190": [{"label": null, "lines": ["Vaggo pañcamo."], "app": []}], "200": [{"label": null, "lines": ["Vaggo chaṭṭho."], "app": []}], "210": [{"label": null, "lines": ["Vaggo sattamo. (Etadaggavaggo niṭṭhito.)"], "app": []}], "220": [{"label": null, "lines": ["Vaggo paṭhamo."], "app": []}], "226": [{"label": null, "lines": ["Vaggo dutiyo."], "app": []}], "232": [{"label": null, "lines": ["Vaggo tatiyo. Aṭṭhānapāḷi niṭṭhitā."], "app": []}], "234": [{"label": null, "lines": ["Vaggo paṭhamo."], "app": []}], "244": [{"label": null, "lines": ["Vaggo dutiyo."], "app": []}], "258": [{"label": null, "lines": ["Vaggo tatiyo."], "app": []}], "282": [{"label": null, "lines": ["Vaggo catuttho. (Jambudīpapeyyālo niṭṭhito.)"], "app": []}], "322": [{"label": null, "lines": ["Ekakanipātapāḷi niṭṭhitā."], "app": []}], "332": [{"label": null, "lines": ["Kammakaraṇavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Vajjā Padhānā dve Tapanīyā, Upaññātena pañcamaṁ.", "Saṁyojanañca Kaṇhañca, Sukkaṁ Cariyā Vassūpanāyikena vaggo."], "app": []}], "343": [{"label": null, "lines": ["Adhikaraṇavaggo dutiyo."], "app": []}], "354": [{"label": null, "lines": ["Bālavaggo tatiyo."], "app": []}], "364": [{"label": null, "lines": ["Samacittavaggo catuttho."], "app": []}], "374": [{"label": null, "lines": ["Parisavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Uttānā Vaggā Aggavatī, Ariyā Kasaṭo ca pañcamo.", "Okkācita-āmisañceva, Visamā Adhammādhammiyena cāti."], "app": []}, {"label": null, "lines": ["Paṭhamo paṇṇāsako samatto."], "app": []}], "386": [{"label": null, "lines": ["Puggalavaggo paṭhamo."], "app": []}], "399": [{"label": null, "lines": ["Sukhavaggo dutiyo."], "app": []}], "409": [{"label": null, "lines": ["Sanimittavaggo tatiyo."], "app": []}], "420": [{"label": null, "lines": ["Dhammavaggo catuttho."], "app": []}], "440": [{"label": null, "lines": ["Bālavaggo pañcamo."], "app": []}, {"label": null, "lines": ["Dutiyo paṇṇāsako samatto."], "app": []}], "452": [{"label": null, "lines": ["Āsāduppajahavaggo paṭhamo."], "app": []}], "463": [{"label": null, "lines": ["Āyācanavaggo dutiyo."], "app": []}], "473": [{"label": null, "lines": ["Dānavaggo tatiyo."], "app": []}], "485": [{"label": null, "lines": ["Santhāravaggo catuttho."], "app": []}], "502": [{"label": null, "lines": ["Samāpattivaggo pañcamo."], "app": []}, {"label": null, "lines": ["Tatiyo paṇṇāsako samatto."], "app": []}], "512": [{"label": null, "lines": ["Kodhapeyyālaṁ niṭṭhitaṁ."], "app": []}], "513": [{"label": null, "lines": ["Akusalapeyyālaṁ niṭṭhitaṁ."], "app": []}], "515": [{"label": null, "lines": ["Vinapeyyālaṁ niṭṭhitaṁ."], "app": []}], "517": [{"label": null, "lines": ["Rāgapeyyālaṁ niṭṭhitaṁ."], "app": []}, {"label": null, "lines": ["Dukanipātapāḷi niṭṭhitā."], "app": []}], "527": [{"label": null, "lines": ["Bālavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Bhayaṁ Lakkhaṇacintī ca, Accayañca Ayoniso.", "Akusalañca Sāvajjaṁ, Sabyābajjhakhataṁ Malanti."], "app": []}], "537": [{"label": null, "lines": ["Rathakāravaggo dutiyo."], "app": []}, {"label": null, "lines": ["Paṭhamabhāṇavāro niṭṭhito."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Ñāto1 Sāraṇīyo bhikkhu, Cakkavattī Sacetano.", "Apaṇṇakattā Devo ca, duve Pāpaṇikena cāti."], "app": []}], "547": [{"label": null, "lines": ["Puggalavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Samiddha3 Gilāna Saṅkhārā, Bahukārā Vajirena ca.", "Sevi Jiguccha Gūthabhāṇī, Andho ca Avakujjatāti."], "app": []}], "550": [{"label": null, "lines": ["Tatiyaṁ."], "app": []}], "552": [{"label": null, "lines": ["Pañcamaṁ."], "app": []}], "557": [{"label": null, "lines": ["Devadūtavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Brahma Ānanda Sāriputto, Nidānaṁ Hatthakena ca.", "Dūtā duve ca Rājāno, Sukhumālādhipateyyena cāti."], "app": []}], "562": [{"label": null, "lines": ["Pañcamaṁ."], "app": []}], "566": [{"label": null, "lines": ["Navamaṁ."], "app": []}], "568": [{"label": null, "lines": ["Cūḷavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sammukhī Ṭhānatthavasaṁ, Pavatti Paṇḍita Sīlavaṁ.", "Saṅkhataṁ Pabbatātappaṁ, Mahācorenekādasāti1."], "app": []}, {"label": null, "lines": ["Paṭhamo paṇṇāsako samatto."], "app": []}], "578": [{"label": null, "lines": ["Brāhmaṇavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Brāhmaṇā caññataro, Paribbājakena Nibbutaṁ.", "Palokavaccho Tikaṇṇo, Soṇi Saṅgāravena cāti."], "app": []}], "588": [{"label": null, "lines": ["Mahāvaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Titthabhayañca Venāgo, Sarabho Kesamuttiyā.", "Sāḷho cāpi Kathāvatthu, Titthiyamūluposathoti."], "app": []}], "598": [{"label": null, "lines": ["Ānandavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Channo Ājīvako Sakko, Nigaṇṭho ca Nivesako.", "Duve Bhavā Sīlabbataṁ, Gandhajātañca Cūḷanīti."], "app": []}], "608": [{"label": null, "lines": ["Dasamaṁ."], "app": []}], "609": [{"label": null, "lines": ["Samaṇavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Samaṇo Gadrabho Khettaṁ, Vajjiputto ca Sekkhakaṁ.", "Tayo ca Sikkhanā vuttā, dve Sikkhā Saṅkavāya cāti."], "app": []}], "620": [{"label": null, "lines": ["Loṇakapallavaggo1 pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Accāyikaṁ Pavivekaṁ, Sarado Parisā tayo.", "Ājānīyā Potthako ca, Loṇaṁ Dhovati Nimittānīti."], "app": []}, {"label": null, "lines": ["Dutiyo paṇṇāsako samatto."], "app": []}], "630": [{"label": null, "lines": ["Sambodhavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Pubbeva duve Assādā, Samaṇo Ruṇṇapañcamaṁ.", "Atitti dve ca vuttāni, Nidānāni apare duveti."], "app": []}], "639": [{"label": null, "lines": ["Navamaṁ."], "app": []}], "640": [{"label": null, "lines": ["Dasamaṁ."], "app": []}, {"label": null, "lines": ["Āpāyikavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Āpāyiko Dullabho Appameyyaṁ, Āneñjavipattisampadā.", "Apaṇṇako ca Kammanto, dve Soceyyāni Moneyyanti."], "app": []}], "645": [{"label": null, "lines": ["Pañcamaṁ."], "app": []}], "646": [{"label": null, "lines": ["Chaṭṭhaṁ."], "app": []}], "650": [{"label": null, "lines": ["Kusināravaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kusinārabhaṇḍanā ceva, Gotamabharaṇḍuhatthako.", "Kaṭuviyaṁ dve Anuruddhā, Paṭicchannaṁ Lekhena te dasāti."], "app": []}], "663": [{"label": null, "lines": ["Yodhājīvavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Yodho Parisamittañca, Uppādā Kesakambalo.", "Sampadā vuddhi tayo Assā, tayo Moranivāpinoti."], "app": []}], "673": [{"label": null, "lines": ["Maṅgalavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Akusalañca Sāvajjaṁ, Visamāsucinā saha.", "Caturo Khatā Vandanā, Pubbaṇhena ca te dasāti."], "app": []}, {"label": null, "lines": ["Tatiyo paṇṇāsako samatto."], "app": []}], "674": [{"label": null, "lines": ["Acelakavaggo chaṭṭho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Satipaṭṭhānaṁ sammappadhānaṁ, iddhipādindriyena ca.", "Balaṁ bojjhaṅgo maggo ca, paṭipadāya yojayeti."], "app": []}], "675": [{"label": null, "lines": ["Kammapathapeyyālaṁ niṭṭhitaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Pāṇaṁ adinnamicchā ca, musāvādī ca pisuṇā.", "Pharusā samphappalāpo ca, abhijjhā byāpādadiṭṭhi ca.", "Kammapathesu peyyālaṁ, tikakena niyojayeti."], "app": []}], "676": [{"label": null, "lines": ["Rāgapeyyālaṁ niṭṭhitaṁ."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["2 Rāgaṁ dosañca mohañca, kodhūpanāhapañcamaṁ.", "Makkhapaḷāsa-issā ca, maccharimāyāsāṭheyyā.", "Thambhasārambhamānañca, atimānamadassa ca.", "Pamādā sattarasa vuttā, rāgapeyyālanissitā.", "Ete opammayuttena, āpādena abhiññāya.", "Pariññāya parikkhayā, pahānakkhayabbayena.", "Virāganirodhacāgaṁ, paṭinissagge ime dasa.", "Suññato animitto ca, appaṇihito ca tayo.", "Samādhimūlakā peyyā-lesupi vavatthitā cāti."], "app": []}, {"label": null, "lines": ["Tikanipātapāḷi niṭṭhitā."], "app": []}], "683": [{"label": null, "lines": ["Sattamaṁ."], "app": []}], "685": [{"label": null, "lines": ["Navamaṁ."], "app": []}], "686": [{"label": null, "lines": ["Dasamaṁ."], "app": []}, {"label": null, "lines": ["Bhaṇḍagāmavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Anubuddhaṁ Papatitaṁ dve, Khatā Anusotapañcamaṁ.", "Appassuto ca Sobhanaṁ, Vesārajjaṁ Taṇhāyogena te dasāti."], "app": []}], "687": [{"label": null, "lines": ["Paṭhamaṁ."], "app": []}], "688": [{"label": null, "lines": ["Dutiyaṁ."], "app": []}], "690": [{"label": null, "lines": ["Catutthaṁ."], "app": []}], "691": [{"label": null, "lines": ["Pañcamaṁ."], "app": []}], "692": [{"label": null, "lines": ["Chaṭṭhaṁ."], "app": []}], "693": [{"label": null, "lines": ["Sattamaṁ."], "app": []}], "694": [{"label": null, "lines": ["Aṭṭhamaṁ."], "app": []}], "695": [{"label": null, "lines": ["Navamaṁ."], "app": []}], "696": [{"label": null, "lines": ["Caravaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Caraṁ Sīlaṁ Padhānāni, Saṁvaraṁ Paññattipañcamaṁ.", "Sokhummaṁ tayo Agatī, Bhattuddesena te dasāti."], "app": []}], "698": [{"label": null, "lines": ["Dutiyaṁ."], "app": []}], "699": [{"label": null, "lines": ["Tatiyaṁ."], "app": []}], "706": [{"label": null, "lines": ["Uruvelavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Uruvelā Loko Kāḷako5, Brahmacariyena pañcamaṁ.", "Kuhaṁ Santuṭṭhi Vaṁso ca, Dhammapadaṁ Paribbājakena cāti."], "app": []}], "709": [{"label": null, "lines": ["Tatiyaṁ."], "app": []}], "710": [{"label": null, "lines": ["Catutthaṁ."], "app": []}], "711": [{"label": null, "lines": ["Pañcamaṁ."], "app": []}], "712": [{"label": null, "lines": ["Chaṭṭhaṁ."], "app": []}], "713": [{"label": null, "lines": ["Sattamaṁ."], "app": []}], "714": [{"label": null, "lines": ["Aṭṭhamaṁ."], "app": []}], "715": [{"label": null, "lines": ["Navamaṁ."], "app": []}], "716": [{"label": null, "lines": ["Dasamaṁ."], "app": []}, {"label": null, "lines": ["Cakkavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Cakko Saṅgaho Sīho, Pasādo Vassakārena pañcamaṁ.", "Doṇo Aparihāniyo Patilīno, Ujjayo Udāyinā te dasāti."], "app": []}], "717": [{"label": null, "lines": ["Paṭhamaṁ."], "app": []}], "718": [{"label": null, "lines": ["Dutiyaṁ."], "app": []}], "719": [{"label": null, "lines": ["Tatiyaṁ."], "app": []}], "720": [{"label": null, "lines": ["Catutthaṁ."], "app": []}], "721": [{"label": null, "lines": ["Pañcamaṁ."], "app": []}], "722": [{"label": null, "lines": ["Chaṭṭhaṁ."], "app": []}], "723": [{"label": null, "lines": ["Sattamaṁ."], "app": []}], "724": [{"label": null, "lines": ["Aṭṭhamaṁ."], "app": []}], "725": [{"label": null, "lines": ["Navamaṁ."], "app": []}], "726": [{"label": null, "lines": ["Dasamaṁ."], "app": []}, {"label": null, "lines": ["Rohitassavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Samādhipañhā dve Kodhā, Rohitassāpare duve.", "Suvidūravisākhavipallāsā, Upakkilesena te dasāti."], "app": []}, {"label": null, "lines": ["Paṭhamo paṇṇāsako samatto."], "app": []}], "736": [{"label": null, "lines": ["Puññābhisandavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Puññābhisandā dve ca, Saṁvāsā Samajīvino.", "Suppavāsā Sudatto ca, Bhojanaṁ Gihisāmicīti."], "app": []}], "746": [{"label": null, "lines": ["Pattakammavaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Pattakammaṁ Ānaṇyako2, Sabrahmanirayā Rūpena pañcamaṁ.", "Sarāga-ahirājā Devadatto, Padhānaṁ Adhammikena cāti."], "app": []}], "756": [{"label": null, "lines": ["Apaṇṇakavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Padhānaṁ Diṭṭhisappurisa, Vadhukā dve ca honti Aggāni.", "Kusināra-acinteyyā, Dakkhiṇā ca Vaṇijjā Kambojanti."], "app": []}], "766": [{"label": null, "lines": ["Macalavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Pāṇātipāto ca Musā, Avaṇṇakodhatamoṇatā.", "Putto Saṁyojanañceva, Diṭṭhi Khandhena te dasāti."], "app": []}], "775": [{"label": null, "lines": ["Asuravaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Asuro tayo Samādhī, Chavālātena pañcamaṁ.", "Rāgo Nisanti Attahitaṁ, Sikkhā Potaliyena cāti."], "app": []}, {"label": null, "lines": ["Dutiyo paṇṇāsako samatto."], "app": []}], "784": [{"label": null, "lines": ["Valāhakavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Dve Valāhā Kumbha Udaka, Rahadā dve honti Ambāni.", "Mūsikā Balībaddhā Rukkhā, Āsīvisena te dasāti."], "app": []}], "794": [{"label": null, "lines": ["Kesivaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kesi Javo Patodo ca, Nāgo Ṭhānena pañcamaṁ.", "Appamādo ca Ārakkho, Saṁvejanīyañca dve Bhayāti."], "app": []}], "804": [{"label": null, "lines": ["Bhayavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Attānuvāda-ūmi ca, dve ca Nānā dve ca honti.", "Mettā dve ca Acchariyā, aparā ca Tathā duveti."], "app": []}], "814": [{"label": null, "lines": ["Puggalavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Saṁyojanaṁ Paṭibhāno, Ugghaṭitaññu Uṭṭhānaṁ.", "Sāvajjo dve ca Sīlāni, Nikaṭṭha Dhamma Vādī cāti."], "app": []}], "824": [{"label": null, "lines": ["Ābhāvaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Ābhā Pabhā ca Ālokā, Obhāsā ceva Pajjotā.", "Dve Kālā Caritā dve ca, honti Sārena te dasāti."], "app": []}, {"label": null, "lines": ["Tatiyo paṇṇāsako samatto."], "app": []}], "834": [{"label": null, "lines": ["Indriyavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Indriyāni Saddhā Paññā, Sati Saṅkhānapañcamaṁ.", "Kappo Rogo Parihāni, Bhikkhunī Sugatena cāti."], "app": []}], "844": [{"label": null, "lines": ["Paṭipadāvaggo dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Saṁkhittaṁ Vitthārāsubhaṁ, dve Khamā Ubhayena ca.", "Moggallāno Sāriputto, Sasaṅkhāraṁ Yuganaddhena cāti."], "app": []}], "854": [{"label": null, "lines": ["Sañcetaniyavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Cetanā Vibhatti Koṭṭhiko, Ānando Upavāṇapañcamaṁ.", "Āyācana Rāhula Jambālī, Nibbānaṁ Mahāpadesenāti."], "app": []}], "864": [{"label": null, "lines": ["Brāhmaṇavaggo1 catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Yodhā Pāṭibhogasutaṁ, Abhayaṁ Brāhmaṇasaccena pañcamaṁ.", "Ummaggavassakāro, Upako Sacchikiriyā ca Uposathoti."], "app": []}], "874": [{"label": null, "lines": ["Mahāvaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sotānugataṁ Ṭhānaṁ, Bhaddiya Sāmugiya Vappa Sāḷhā ca.", "Mallika Attantāpo, Taṇhā Pemena ca dasā teti."], "app": []}, {"label": null, "lines": ["Catuttho mahāpaṇṇāsako samatto."], "app": []}], "884": [{"label": null, "lines": ["Sappurisavaggo paṭhamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Sikkhāpadañca Assaddhaṁ, Sattakammaṁ atho ca Dasakammaṁ.", "Aṭṭhaṅgikañca Dasamaggaṁ, dve Pāpadhammo apare dveti."], "app": []}], "894": [{"label": null, "lines": ["Parisasobhanavaggo1 dutiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Parisā Diṭṭhi Akataññutā, Pāṇātipātāpi dve Maggā.", "Dve Vohārapathā vuttā, Ahirikaṁ Duppaññena cāti."], "app": []}], "904": [{"label": null, "lines": ["Duccaritavaggo tatiyo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Duccaritaṁ Diṭṭhi Akataññū ca, Pāṇātipātāpi dve Maggā.", "Dve Vohārapathā vuttā, Ahirikaṁ Duppaññakavinā cāti."], "app": []}], "915": [{"label": null, "lines": ["Kammavaggo catuttho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Saṁkhitta Vitthāra Soṇakāyana,", "Sikkhāpadaṁ Ariyamaggo Bojjhaṅgaṁ.", "Sāvajjañceva Abyābajjhaṁ,", "Samaṇo ca Sappurisānisaṁsoti."], "app": []}], "926": [{"label": null, "lines": ["Āpattibhayavaggo pañcamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": [], "app": []}], "936": [{"label": null, "lines": ["Abhiññāvaggo chaṭṭho."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Abhiññā Pariyesanā, Saṅgahaṁ Mālukyaputto.", "Kulaṁ dve ca Ājānīyā, Balaṁ Araññakammunāti."], "app": []}], "946": [{"label": null, "lines": ["Kammapathavaggo sattamo."], "app": []}], "951": [{"label": null, "lines": ["Rāgapeyyālaṁ niṭṭhitaṁ."], "app": []}, {"label": null, "lines": ["Catukkanipātapāḷi niṭṭhitā."], "app": []}]}