therassāpadānaṁ catutthaṁ."], "app": []}], "2696": [{"label": null, "lines": ["Pādapūjakattherassāpadānaṁ chaṭṭhaṁ."], "app": []}], "2701": [{"label": null, "lines": ["Desakittakattherassāpadānaṁ sattamaṁ."], "app": []}], "2705": [{"label": null, "lines": ["Saraṇagamaniyattherassāpadanaṁ aṭṭhamaṁ."], "app": []}], "2708": [{"label": null, "lines": ["Ambapiṇḍiyattherassāpadānaṁ navamaṁ."], "app": []}], "2712": [{"label": null, "lines": ["Citakapūjakavaggo tiṁsatimo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Citakaṁ Pārichatto ca, Saddagosīsasantharaṁ.", "Pādo Padesaṁ Saraṇaṁ, Ambo Saṁsāvakopi ca.", "Aṭṭhatālīsa gāthāyo, gaṇitāyo vibhāvibhi."], "app": []}, {"label": "Atha vagguddānaṁ", "lines": ["Kaṇikāro Hatthidado, Ālambaṇudakāsanaṁ.", "Tuvaraṁ Thomako ceva, ukkhepaṁ sīsupadhānaṁ.", "Paṇṇado Citapūjī ca, gāthāyo ceva sabbaso.", "Cattāri ca satānīha, ekapaññāsameva ca.", "Pañcavīsasatā sabbā, dvāsattati taduttari.", "Tisataṁ apadānānaṁ, gaṇitā atthadassibhi.", "Kaṇikāravaggadasakaṁ.", "Tatiyasatakaṁ samattaṁ."], "app": []}], "2724": [{"label": null, "lines": ["Paramannadāyakattherassāpadānaṁ tatiyaṁ."], "app": []}], "2731": [{"label": null, "lines": ["Dhammasaññakattherassāpadānaṁ catutthaṁ."], "app": []}], "2735": [{"label": null, "lines": ["Phaladāyakattherassāpadānaṁ pañcamaṁ."], "app": []}], "2743": [{"label": null, "lines": ["Sampasādakattherassāpadānaṁ chaṭṭhaṁ."], "app": []}], "2750": [{"label": null, "lines": ["Ārāmadāyakattherassāpadānaṁ sattamaṁ."], "app": []}], "2763": [{"label": null, "lines": ["Padumakesaravaggo ekatiṁsatimo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Kesaraṁ Gandhamannañca, Dhammasaññī Phalena ca.", "Pasādā’rāmadāyī ca, Lepako Buddhasaññako.", "Pabbhārado ca gāthāyo, ekapaññāsa kittitā."], "app": []}], "2772": [{"label": null, "lines": ["Bhojanadāyakattherassāpadānaṁ dutiyaṁ."], "app": []}], "2776": [{"label": null, "lines": ["Gatasaññakattherassāpadānaṁ tatiyaṁ."], "app": []}], "2782": [{"label": null, "lines": ["Sattapadumiyattherassāpadānaṁ catutthaṁ."], "app": []}], "2796": [{"label": null, "lines": ["Āsanasanthavikattherassāpadānaṁ chaṭṭhaṁ."], "app": []}], "2801": [{"label": null, "lines": ["Saddasaññakattherassāpadānaṁ sattamaṁ."], "app": []}], "2820": [{"label": null, "lines": ["Ārakkhadāyakavaggo bāttiṁsatimo1."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Ārakkhado Bhojanado, Gatasaññī Padumiyo.", "Pupphāsanī Santhaviko, Saddasaññī Tiraṁsiyo.", "Kandaliko Kumudī ca, sattapaññāsa gāthakāti."], "app": []}], "2826": [{"label": null, "lines": ["Umāpupphiyattherassāpadānaṁ paṭhamaṁ."], "app": []}], "2832": [{"label": null, "lines": ["Pulinapūjakattherassāpadānaṁ dutiyaṁ."], "app": []}], "2836": [{"label": null, "lines": ["Hāsajanakattherassāpadānaṁ tatiyaṁ."], "app": []}], "2847": [{"label": null, "lines": ["Yaññasāmikatterassāpadānaṁ catutthaṁ."], "app": []}], "2867": [{"label": null, "lines": ["Dvādasamaṁ bhāṇavāraṁ."], "app": []}], "2892": [{"label": null, "lines": ["Sumanāveḷiyattherassāpadānaṁ aṭṭhamaṁ."], "app": []}], "2901": [{"label": null, "lines": ["Pupphacchattiyattherassāpadānaṁ navamaṁ."], "app": []}], "2925": [{"label": null, "lines": ["Umāpupphiyavaggo tettiṁsatimo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Umāpupphañca Pulinaṁ, Hāso Yañño Nimittako.", "Saṁsāvako Nigguṇḍī ca, Sumanaṁ Pupphachattako.", "Saparivārachatto ca, gāthā sattasatuttarāti."], "app": []}], "2938": [{"label": null, "lines": ["Udakapūjakattherassāpadānaṁ dutiyaṁ."], "app": []}], "2962": [{"label": null, "lines": ["Ekadussadāyakattherassāpadānaṁ catutthaṁ."], "app": []}], "2977": [{"label": null, "lines": ["Phusitakampiyattherassāpadānaṁ pañcamaṁ."], "app": []}], "2998": [{"label": null, "lines": ["Pabhaṅkarattherassāpadānaṁ chaṭṭhaṁ."], "app": []}], "3035": [{"label": null, "lines": ["Uttareyyadāyakattherassāpadānaṁ aṭṭhamaṁ."], "app": []}], "3053": [{"label": null, "lines": ["Dhammasavaniyattherassāpādānaṁ navamaṁ."], "app": []}], "3067": [{"label": null, "lines": ["Gandhodakavaggo catutiṁsatimo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Gandhadhūpo Udakaṁ ca, Punnāga Ekadussakā.", "Phusito ca Pabhaṅkaro, Kuṭido Uttarīyako.", "Savanī Ekapadumī, gāthāyo sabbapiṇḍitā.", "Ekaṁ gāthāsatañceva, catutālīsameva ca."], "app": []}], "3086": [{"label": null, "lines": ["Tīṇuppalamāliyattherassāpadānaṁ dutiyaṁ."], "app": []}], "3093": [{"label": null, "lines": ["Dhajadāyakattherassāpadānaṁ tatiyaṁ."], "app": []}], "3105": [{"label": null, "lines": ["Naḷāgārikattherassāpadānaṁ pañcamaṁ."], "app": []}], "3114": [{"label": null, "lines": ["Terasamaṁ bhāṇavāraṁ."], "app": []}], "3125": [{"label": null, "lines": ["Tiṇamuṭṭhidāyakattherassāpadānaṁ aṭṭhamaṁ."], "app": []}], "3133": [{"label": null, "lines": ["Ekañjaliyattherassāpadānaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Ekapadumiyavaggo pañcatiṁsatimo."], "app": []}, {"label": "Tassudānaṁ", "lines": ["Padumī Uppalamālī, Dhajo Kiṅkaṇikaṁ Naḷaṁ4.", "Campako Padumo Muṭṭhi, Tindukekañjalī tathā.", "Cha ca saṭṭhi ca gāthāyo, gaṇitāyo vibhāvibhi."], "app": []}], "3138": [{"label": null, "lines": ["Saddasaññakattherassāpadānaṁ paṭhamaṁ."], "app": []}], "3143": [{"label": null, "lines": ["Yavakalāpiyattherassāpadānaṁ dutiyaṁ."], "app": []}], "3146": [{"label": null, "lines": ["Kiṁsukapūjakattherassāpadānaṁ tatiyaṁ."], "app": []}], "3166": [{"label": null, "lines": ["Mañcadāyakattherassāpadānaṁ aṭṭhamaṁ."], "app": []}], "3173": [{"label": null, "lines": ["Piṇḍapātikattherassāpadānaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Saddasaññakavaggo chattiṁsatimo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Saddasaññī Yavasiko, Kiṁsukoraṇḍapupphiyo.", "Ālambano Ambayāgu, Supuṭī Mañcadāyako.", "Saraṇaṁ Piṇḍapāto ca, gāthā tālīsameva ca."], "app": []}], "3184": [{"label": null, "lines": ["Bhisamuḷāladāyakattherassāpadānaṁ tatiyaṁ."], "app": []}], "3188": [{"label": null, "lines": ["Kesarapupphiyattherassāpadānaṁ catutthaṁ."], "app": []}], "3192": [{"label": null, "lines": ["Aṅkolapupphiyattherassāpadānaṁ pañcamaṁ."], "app": []}], "3213": [{"label": null, "lines": ["Mandāravapupphiyavaggo sattatiṁsatimo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Mandāravañca Kakkāru, Bhisakesarapupphiyo.", "Aṅkolako Kadambī ca, Uddālī Ekacampako.", "Timiraṁ Saḷalañceva, gāthā tālīsameva ca."], "app": []}], "3225": [{"label": null, "lines": ["Pāṭalipupphiyattherassāpadānaṁ dutiyaṁ."], "app": []}], "3234": [{"label": null, "lines": ["Tīṇuppalamāliyattherassāpādānaṁ tatiyaṁ."], "app": []}], "3240": [{"label": null, "lines": ["Paṭṭipupphiyattherassāpadānaṁ catutthaṁ."], "app": []}], "3245": [{"label": null, "lines": ["Sattapaṇṇiyattherassāpadānaṁ pañcamaṁ."], "app": []}], "3250": [{"label": null, "lines": ["Gandhamuṭṭhiyattherassāpadānaṁ chaṭṭhaṁ."], "app": []}], "3255": [{"label": null, "lines": ["Citakapūjakattherassāpadānaṁ sattamaṁ."], "app": []}], "3271": [{"label": null, "lines": ["Bodhivandanavaggo aṭṭhatiṁsatimo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Bodhi Pāṭali Uppalī, Paṭṭi ca Sattapaṇṇiyo.", "Gandhamuṭṭhi ca Citako, Tālaṁ Sumanadāmako.", "Kāsumāriphalī ceva, gāthā ekūnasaṭṭhikā."], "app": []}], "3285": [{"label": null, "lines": ["Labujadāyakattherassāpadānaṁ dutiyaṁ."], "app": []}], "3334": [{"label": null, "lines": ["Soṇakoṭivīsattherassāpadānaṁ navamaṁ."], "app": []}], "3337": [{"label": null, "lines": ["(1)"], "app": []}], "3340": [{"label": null, "lines": ["(2)"], "app": []}], "3343": [{"label": null, "lines": ["(3)"], "app": []}], "3348": [{"label": null, "lines": ["(4)"], "app": []}], "3350": [{"label": null, "lines": ["(5)"], "app": []}], "3352": [{"label": null, "lines": ["(6)"], "app": []}], "3354": [{"label": null, "lines": ["(7)"], "app": []}], "3356": [{"label": null, "lines": ["(8)"], "app": []}], "3358": [{"label": null, "lines": ["(9)"], "app": []}], "3360": [{"label": null, "lines": ["(10)"], "app": []}], "3361": [{"label": null, "lines": ["(11)"], "app": []}], "3362": [{"label": null, "lines": ["(12)"], "app": []}], 