], "4046": [{"label": null, "lines": ["Upasīvattherassāpadānaṁ pañcamaṁ."], "app": []}], "4068": [{"label": null, "lines": ["Nandakattherassāpadānaṁ chaṭṭhaṁ."], "app": []}], "4109": [{"label": null, "lines": ["Hemakattherassāpadānaṁ sattamaṁ."], "app": []}, {"label": null, "lines": ["Sattarasamaṁ bhāṇavāraṁ."], "app": []}], "4161": [{"label": null, "lines": ["Todeyyattherassāpadānaṁ aṭṭhamaṁ."], "app": []}], "4215": [{"label": null, "lines": ["Jatukaṇṇittherassāpadānaṁ navamaṁ."], "app": []}], "4264": [{"label": null, "lines": ["Udenattherassāpadānaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Metteyyavaggo ekacattālīsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Metteyyo Puṇṇako thero, Mettagū Dhotakopi ca.", "Upasivo ca Nando ca, Hemako sattamo tahiṁ.", "Todeyyo Jatukaṇṇī ca, Udeno ca Mahāyaso.", "Tīṇi gāthāsatānettha, asīti tīṇi cuttariṁ."], "app": []}], "4295": [{"label": null, "lines": ["Bhaddālittherassāpadānaṁ paṭhamaṁ."], "app": []}], "4342": [{"label": null, "lines": ["Ekachattiyattherassāpadānaṁ dutiyaṁ."], "app": []}], "4361": [{"label": null, "lines": ["Aṭṭhārasamaṁ bhāṇavāraṁ."], "app": []}], "4387": [{"label": null, "lines": ["Nāgapallavattherassāpadānaṁ pañcamaṁ."], "app": []}], "4405": [{"label": null, "lines": ["Ekadīpiyattherassāpadānaṁ chaṭṭhaṁ."], "app": []}], "4412": [{"label": null, "lines": ["Ucchaṅgapupphiyattherassāpadānaṁ sattamaṁ."], "app": []}], "4415": [{"label": null, "lines": ["2", "Piṇḍāya te na gacchanti, oruddhanaditāya hi ."], "app": []}], "4433": [{"label": null, "lines": ["Yāgudāyakattherassāpadānaṁ aṭṭhamaṁ."], "app": []}], "4460": [{"label": null, "lines": ["Mañcadāyakattherassāpadānaṁ dasamaṁ."], "app": []}, {"label": null, "lines": ["Bhaddālivaggo bācattālīsamo."], "app": []}, {"label": "Tassuddānaṁ", "lines": ["Bhaddālī Ekachatto ca, Tiṇasūlo ca Maṁsado.", "Nāgapallaviko Dīpī, Ucchaṅgi Yāgudāyako.", "Patthodanī Mañcadado, gāthāyo gaṇitā ciha.", "Dvesatāni ca gāthānaṁ, gāthā cekā taduttari."], "app": []}]}