{"3": [{"l": "1. Khandhavibhaṅga", "k": "sutta"}, {"l": "1. Suttantabhājanīyavaṇṇanā", "k": "sutta"}, {"l": "Catusaccadaso Nātho, catudhā Dhammasaṅgaṇiṁ.\nPakāsayitvā Sambuddho, tass’eva samanantaraṁ.\nUpeto Buddhadhammehi, aṭṭhārasahi nāyako.\nAṭṭhārasannaṁ Khandhādi-vibhaṅgānaṁ vasena yaṁ.\nVibhaṅgaṁ desayī Satthā, tassa saṁvaṇṇanākkamo.\nIdāni yasmā sampatto, tasmā tass’atthavaṇṇanaṁ.\nKarissāmi vigāhetvā, Porāṇaṭṭhakathānayaṁ.\nSaddhamme gāravaṁ katvā, taṁ suṇātha samāhitāti.", "k": "gatha"}], "4": [{"l": "1. Rūpakkhandhaniddesa", "k": "sutta"}], "8": [{"l": "2. Vedanākkhandhaniddesa", "k": "sutta"}], "11": [{"l": "3. Saññākkhandhaniddesa", "k": "sutta"}], "13": [{"l": "4. Saṅkhārakkhandhaniddesa", "k": "sutta"}], "14": [{"l": "5. Viññāṇakkhandhaniddesa", "k": "sutta"}], "15": [{"l": "Pakiṇṇakakathā", "k": "sutta"}, {"l": "Kamādivinicchayakathā", "k": "sutta"}, {"l": "2. Abhidhammabhājanīyavaṇṇanā", "k": "sutta"}], "17": [{"l": "3. Pañhipucchakavaṇṇanā", "k": "sutta"}], "18": [{"l": "2. Āyatanavibhaṅga", "k": "sutta"}, {"l": "1. Suttantabhājanīyavaṇṇanā", "k": "sutta"}], "19": [{"l": "2. Abhidhammabhājanīyavaṇṇanā", "k": "sutta"}], "22": [{"l": "3. Pañhāpucchakavaṇṇanā", "k": "sutta"}], "23": [{"l": "3. Dhātuvibhaṅga", "k": "sutta"}, {"l": "1. Suttantabhājanīyavaṇṇanā", "k": "sutta"}], "33": [{"l": "2. Abhidhammabhājanīyavaṇṇanā", "k": "sutta"}], "35": [{"l": "3. Pañhāpucchakavaṇṇanā", "k": "sutta"}], "36": [{"l": "4. Saccavibhaṅga", "k": "sutta"}, {"l": "1. Suttantabhājanīyavaṇṇanā", "k": "sutta"}], "37": [{"l": "1. Dukkhasaccaniddesavaṇṇanā", "k": "sutta"}, {"l": "Jātiniddesa", "k": "sutta"}], "39": [{"l": "Jarāniddesa", "k": "sutta"}], "40": [{"l": "Maraṇaniddesa", "k": "sutta"}], "41": [{"l": "Sokaniddesa", "k": "sutta"}], "42": [{"l": "Paridevaniddesa", "k": "sutta"}], "43": [{"l": "Dukkhadomanassaniddesa", "k": "sutta"}], "44": [{"l": "Upāyāsaniddesa", "k": "sutta"}], "45": [{"l": "Appiyasampayoganiddesa", "k": "sutta"}], "46": [{"l": "Piyavippayoganiddesa