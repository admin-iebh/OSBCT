{"0": [{"l": "3. Tatiyapārājika", "k": "sutta"}, {"l": "Tatiyaṁ tīhi suddhena, yaṁ Buddhena vibhāvitaṁ.\nPārājikaṁ tassa dāni, patto saṁvaṇṇanākkamo.\nYasmā tasmā suviññeyyaṁ, yaṁ pubbe ca pakāsitaṁ.\nTaṁ vijjayitvā assāpi, hoti saṁvaṇṇanā ayaṁ.", "k": "gatha"}, {"l": "Paṭhamapaññattinidānavaṇṇanā", "k": "sutta"}], "3": [{"l": "Ānāpānassatisamādhikathā", "k": "sutta"}], "7": [{"l": "Padabhājanīyavaṇṇanā", "k": "sutta"}], "14": [{"l": "Pakiṇṇakakathāvaṇṇanā", "k": "sutta"}, {"l": "Vinītavatthuvaṇṇanā", "k": "sutta"}], "24": [{"l": "4. Catutthapārājika", "k": "sutta"}, {"l": "Vaggumudātīriyabhikkhuvatthuvaṇṇanā", "k": "sutta"}], "27": [{"l": "Adhimānavatthuvaṇṇanā", "k": "sutta"}], "28": [{"l": "Savibhaṅgasikkhāpadavaṇṇanā", "k": "sutta"}], "30": [{"l": "Padabhājanīyavaṇṇanā", "k": "sutta"}], "31": [{"l": "Suddhikavārakathāvaṇṇanā", "k": "sutta"}], "33": [{"l": "Vattukāmavārakathā", "k": "sutta"}], "34": [{"l": "Paccayapaṭisaṁyuttavārakathā", "k": "sutta"}], "35": [{"l": "Anāpattibhedakathā", "k": "sutta"}], "36": [{"l": "Vinītavatthuvaṇṇanā", "k": "sutta"}], "46": [{"l": "Nigamanavaṇṇanā", "k": "sutta"}], "47": [{"l": "2. Saṁghādisesakaṇḍa", "k": "sutta"}, {"l": "1. Sukkavissaṭṭhisikkhāpadavaṇṇanā", "k": "sutta"}], "59": [{"l": "2. Kāyasaṁsaggasikkhāpadavaṇṇanā", "k": "sutta"}], "73": [{"l": "3. Duṭṭhullavācāsikkhāpadavaṇṇanā", "k": "sutta"}], "79": [{"l": "4. Attakāmapāricariyasikkhāpadavaṇṇanā", "k": "sutta"}], "81": [{"l": "5. Sañcarittasikkhāpadavaṇṇanā", "k": "sutta"}], "92": [{"l": "6. Kuṭikārasikkhāpadavaṇṇanā", "k": "sutta"}], "105": [{"l": "7. Vihārakārasikkhāpadavaṇṇanā", "k": "sutta"}], "107": [{"l": "8. Paṭhamaduṭṭhadosasikkhāpadavaṇṇanā", "k": "sutta"}], "114": [{"l": "9. Dutiyaduṭṭhadosasikkhāpadavaṇṇanā", "k": "sutta"}], "121": [{"l": "10. Paṭhamasaṁghabhedasikkhāpadavaṇṇanā", "k": "sutta"}], "127": [{"l": "11. Dutiyasaṁghabhedasikkhāpadavaṇṇanā", "k": "sutta"}], "128": [{"l": "12. Dubbacasikkhāpadavaṇṇanā", "k": "sutta"}], "130": [{"l": "13. Kuladūsak