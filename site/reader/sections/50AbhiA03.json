{"2": [{"l": "Aṭṭhārasahi bhedehi, Vibhaṅgaṁ mārabhañjano.\nDesayitvā Mahāvīro, yaṁ tasseva anantaraṁ.\nAdesayi Dhātukathaṁ, dhātubhedappakāsano.\nTassatthaṁ dīpayissāmi, taṁ suṇātha samāhitāti.", "k": "gatha"}, {"l": "1. Mātikāvaṇṇanā", "k": "sutta"}, {"l": "1. Nayamātikāvaṇṇanā", "k": "sutta"}], "3": [{"l": "2. Abbhantaramātikāvaṇṇanā", "k": "sutta"}], "4": [{"l": "3. Nayamukhamātikāvaṇṇanā", "k": "sutta"}], "5": [{"l": "4. Lakkhaṇamātikāvaṇṇanā", "k": "sutta"}], "6": [{"l": "5. Bāhiramātikāvaṇṇanā", "k": "sutta"}], "7": [{"l": "2. Niddesavaṇṇanā", "k": "sutta"}, {"l": "1. Paṭhamanaya saṅgahāsaṅgahapadavaṇṇanā", "k": "sutta"}, {"l": "1. Khandhapadavaṇṇanā", "k": "sutta"}], "8": [{"l": "2. Āyatanapadādivaṇṇanā", "k": "sutta"}], "11": [{"l": "6. Paṭiccasamuppādavaṇṇanā", "k": "sutta"}], "15": [{"l": "7. Tikapadavaṇṇanā", "k": "sutta"}], "16": [{"l": "2. Dutiyanaya saṅgahitena-asaṅgahitapadavaṇṇanā", "k": "sutta"}], "24": [{"l": "3. Tatiyanaya asaṅgahitenasaṅgahitapadavaṇṇanā", "k": "sutta"}], "30": [{"l": "4. Catutthanaya saṅgahitenasaṅgahitapadavaṇṇanā", "k": "sutta"}], "31": [{"l": "5. Pañcamanaya asaṅgahitena-asaṅgahitapadavaṇṇanā", "k": "sutta"}], "34": [{"l": "6. Chaṭṭhanaya sampayogavippayogapadavaṇṇanā", "k": "sutta"}], "48": [{"l": "7. Sattamanaya sampayuttenavippayuttapadavaṇṇanā", "k": "sutta"}], "51": [{"l": "8. Aṭṭhamanaya vippayuttenasampayuttapadavaṇṇanā", "k": "sutta"}], "53": [{"l": "9. Navamanaya sampayuttenasampayuttapadavaṇṇanā", "k": "sutta"}], "55": [{"l": "10. Dasamanaya vippayuttenavippayuttapadavaṇṇanā", "k": "sutta"}], "57": [{"l": "11. Ekādasamanaya saṅgahitenasampayuttavippayuttapadavaṇṇanā", "k": "sutta"}], "59": [{"l": "12. Dvādasamanaya sampayuttenasaṅgahitāsaṅgahitapadavaṇṇanā", "k": "sutta"}], "61": [{"l": "13. Terasamanaya asaṅgahitenasampayuttavippayuttapadavaṇṇanā", "k": "sutta"}], "63": [{"l": "14. Cuddasamanaya vippayuttenasaṅgahitāsaṅgahitapadavaṇṇanā", "k": "sutta"}], "65": [{"l": "Nipuṇatthaṁ pakaraṇaṁ, dhātubhedappakāsano.\nSatthā Dhātukathaṁ nāma, desayitvā surālaye.\nAnantaraṁ tassa Jino, paññattibhedadīpanaṁ.\nĀha Puggalapaññattiṁ, yaṁ loke aggapuggalo.\nTassā saṁvaṇṇanokāso, yasmā dāni upāgato.\nTasmā naṁ vaṇṇayissāmi, taṁ suṇātha samāhitāti.", "k": "gatha"}, {"l": "1. Mātikāvaṇṇanā", "k": "sutta"}], "72": [{"l": "2. Niddesavaṇṇanā", "k": "sutta"}, {"l": "1. Ekakaniddesavaṇṇanā", "k": "sutta"}], "110": [{"l": "2. Dukaniddesavaṇṇanā", "k": "sutta"}], "121": [{"l": "3. Tikaniddesavaṇṇanā", "k": "sutta"}], "153": [{"l": "4. Catukkaniddesavaṇṇanā", "k": "sutta"}], "198": [{"l": "5. Pañcakaniddesavaṇṇanā", "k": "sutta"}], "206": [{"l": "6. Chakkaniddesavaṇṇanā", "k": "sutta"}], "207": [{"l": "7. Sattakaniddesavaṇṇanā", "k": "sutta"}], "209": [{"l": "10. Dasakaniddesavaṇṇanā", "k": "sutta"}], "211": [{"l": "Nisinno devalokasmiṁ, devasaṁghapurakkhato.\nSadevakassa lokassa, Satthā appaṭipuggalo.\nSabbapaññattikusalo, paññattiparidīpanaṁ.\nVatvā Puggalapaññattiṁ, loke uttamapuggalo.\nYaṁ puggalakathādīnaṁ, kathānaṁ vatthubhāvato.\nKathāvatthuppakaraṇaṁ, saṅkhepena adesayī.\nMātikāṭhapaneneva, ṭhapitassa surālaye.\nTassa Moggaliputtena, vibhattassa mahītale.\nIdāni yasmā sampatto, attasaṁvaṇṇanākkamo.\nTasmā naṁ vaṇṇayissāmi, taṁ suṇātha samāhitāti.", "k": "gatha"}, {"l": "Nidānakathā", "k": "sutta"}], "212": [{"l": "1. Puggalakathā", "k": "sutta"}, {"l": "1. Suddhasaccikaṭṭha", "k": "sutta"}, {"l": "1. Anulomapaccanīkavaṇṇanā", "k": "sutta"}], "217": [{"l": "2. Paccanīkānulomavaṇṇanā", "k": "sutta"}], "219": [{"l": "2. Okāsasaccikaṭṭha", "k": "sutta"}, {"l": "1. Anulomapaccanīkavaṇṇanā", "k": "sutta"}], "220": [{"l": "3. Kālasaccikaṭṭha", "k": "sutta"}, {"l": "1. Anulomapaccanīkavaṇṇanā", "k": "sutta"}], "221": [{"l": "4. Avayavasaccikaṭṭha", "k": "sutta"}, {"l": "1. Anulomapaccanīkavaṇṇanā", "k": "sutta"}], "222": [{"l": "Okāsādisaccikaṭṭha", "k": "sutta"}, {"l": "2. Paccanīkānulomavaṇṇanā", "k": "sutta"}], "223": [{"l": "5. Suddhikasaṁsandanavaṇṇanā", "k": "sutta"}], "224": [{"l": "6. Opam