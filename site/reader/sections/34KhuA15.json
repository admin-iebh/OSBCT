{"4": [{"l": "Ganthārambhakathā", "k": "sutta"}, {"l": "Anantañāṇaṁ karuṇālayaṁ layaṁ,\nMalassa Buddhaṁ susamāhitaṁ hitaṁ.\nNamāmi dhammaṁ bhavasaṁvaraṁ varaṁ,\nGuṇākarañceva niraṅgaṇaṁ gaṇaṁ.\nPaññāya seṭṭho Jinasāvakānaṁ,\nYaṁ Dhammasenāpati Dhammarājaṁ.\nApucchi Satthāramapārapāraguṁ,\nNiraṅgaṇaṁ ñātigaṇassa majjhe.\nSubuddhavaṁsenidha Buddhavaṁso,\nVisuddhavaṁsena vināyakena.\nHatāvakāsena1 pakāsito yo2,\nSamādhivāsena3 Tathāgatena.", "k": "gatha"}], "11": [{"l": "Nidānakathā", "k": "sutta"}, {"l": "Bāhiranidāna", "k": "sutta"}], "12": [{"l": "Abbhantaranidāna", "k": "sutta"}, {"l": "1. Ratanacaṅkamanakaṇḍavaṇṇanā", "k": "sutta"}], "94": [{"l": "2. Sumedhapatthanākathāvaṇṇanā", "k": "sutta"}], "129": [{"l": "Dvattiṁsa pubbanimitta", "k": "sutta"}], "283": [{"l": "3. Dīpaṅkarabuddhavaṁsavaṇṇanā", "k": "sutta"}], "309": [{"l": "4. Koṇḍaññabuddhavaṁsavaṇṇanā", "k": "sutta"}], "343": [{"l": "5. Maṅgalabuddhavaṁsavaṇṇanā", "k": "sutta"}], "371": [{"l": "6. Sumanabuddhavaṁsavaṇṇanā", "k": "sutta"}], "407": [{"l": "7. Revatabuddhavaṁsavaṇṇanā", "k": "sutta"}], "433": [{"l": "8. Sobhitabuddhavaṁsavaṇṇanā", "k": "sutta"}], "459": [{"l": "9. Anomadassībuddhavaṁsavaṇṇanā", "k": "sutta"}], "484": [{"l": "10. Padumabuddhavaṁsavaṇṇanā", "k": "sutta"}], "509": [{"l": "11. Nāradabuddhavaṁsavaṇṇanā", "k": "sutta"}], "538": [{"l": "12. Padumuttarabuddhavaṁsavaṇṇanā", "k": "sutta"}], "565": [{"l": "13. Sumedhabuddhavaṁsavaṇṇanā", "k": "sutta"}], "592": [{"l": "14. Sujātabuddhavaṁsavaṇṇanā", "k": "sutta"}], "623": [{"l": "15. Piyadassībuddhavaṁsavaṇṇanā", "k": "sutta"}], "648": [{"l": "16. Atthadassībuddhavaṁsavaṇṇanā", "k": "sutta"}], "670": [{"l": "17. Dhammadassībuddhavaṁsavaṇṇanā", "k": "sutta"}], "691": [{"l": "18. Siddhatthabuddhavaṁsavaṇṇanā", "k": "sutta"}], "711": [{"l": "19. Tissabuddhavaṁsavaṇṇanā", "k": "sutta"}], "735": [{"l": "20. Phussabuddhavaṁsavaṇṇanā", "k": "sutta"}], "753": [{"l": "21. Vipassībuddhavaṁsavaṇṇanā", "k": "sutta"}], "784": [{"l": "22. Sikhībuddhavaṁ