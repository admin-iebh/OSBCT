o vā gatā, tiriyaṁ vā gatā, vidisaṁ vā gatā”ti, so hetu natthi, paccayo natthi, kāraṇaṁ natthi, yena saṅkhaṁ gaccheyyāti atthaṁ paleti na upeti saṅkhaṁ.","v":"25Khu08","n":43,"p":108,"s":null,"w":3,"k":["","sankh","upet"]},{"l":"Na upeti saṅkhan","g":"anupādisesāya nibbānadhātuyā parinibbuto saṅkhaṁ na upeti, uddesaṁ na upeti, gaṇanaṁ na upeti, paṇṇattiṁ na upeti “khattiyo”ti vā “brāhmaṇo”ti vā “vesso”ti vā “suddo”ti vā “gahaṭṭho”ti vā “pabbajito”ti vā “devo”ti vā “manusso”ti vā “rūpī”ti vā “arūpī”ti vā “saññī”ti vet “asaññī”ti vā “nevasaññīnāsaññī”ti vā, so hetu natthi, paccayo natthi, kāraṇaṁ natthi, yena saṅkhaṁ gaccheyyāti atthaṁ paleti na upeti saṅkhaṁ.","v":"25Khu08","n":43,"p":108,"s":null,"w":3,"k":["","sankh","upet"]},{"l":"Na upeti saṅkhan","g":"“asukaṁ nāma disaṁ gato”ti vohāraṁ na gacchati.","v":"26KhuA07","n":1081,"p":309,"s":"Suttanipātaṭṭhakathā","w":3,"k":["","sankh","upet"]},{"l":"Na upeti saṅkhan","g":"“asukaṁ nāma disaṁ gato”ti vohāraṁ na gacchati.","v":"44KhuA25","n":43,"p":29,"s":"Upasīvamāṇavasuttaniddesavaṇṇanā","w":3,"k":["","sankh","upet"]}],"Saṅkhāne":[{"l":"Saṅkhāne","g":"gaṇanāya.","v":"13MaA04","n":74,"p":46,"s":"Gaṇakamoggallānasuttavaṇṇanā","w":1,"k":["sankh"]}],"Saṅkhāna":[{"l":"Saṅkhāne","g":"gaṇanāya.","v":"13MaA04","n":74,"p":46,"s":"Gaṇakamoggallānasuttavaṇṇanā","w":1,"k":["sankh"]}],"Saṅkhānasippan":[{"l":"Saṅkhānasippan","g":"saṅkalanapaṭuppādanādivasena piṇḍagaṇanasippaṁ.","v":"23KhuA04","n":29,"p":184,"s":"Sippasuttavaṇṇanā","w":1,"k":["sankhanasip"]}],"Saṅkhānasippaṁ":[{"l":"Saṅkhānasippan","g":"saṅkalanapaṭuppādanādivasena piṇḍagaṇanasippaṁ.","v":"23KhuA04","n":29,"p":184,"s":"Sippasuttavaṇṇanā","w":1,"k":["sankhanasip"]}],"saṅkhānan":[{"l":"tañca saṅkhānan","g":"yaṁ “paṭhamaṁ ekan”ti-ādikaṁ saṅkhānaṁ, tañca saṅkhāmukhena gahetabbarūpaṁ.","v":"24AbhiT03","n":1,"p":35,"s":null,"w":2,"k":["sankh","tanc"]}],"saṅkhānaṁ":[{"l":"tañca saṅkhānan","g":"yaṁ “paṭhamaṁ ekan”ti-ādikaṁ saṅkhānaṁ, tañca saṅkhāmukhena gahetabbarūpaṁ.","v":