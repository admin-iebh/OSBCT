{"n":1869,"pages":16,"page":9,"rows":[{"l":"Yathābhūtaṁ jānaṁ passaṁ antakaro hotī","g":"yathāsabhāvaṁ maggapaññāya jānitvā passitvā vaṭṭa dukkhassa antaṁ katvā ṭhito nāma hotīti arahattanikūṭena pañhaṁ niṭṭhapesi.","v":"18AnA02","n":175,"p":351,"s":"Upavāṇasuttavaṇṇanā","w":5,"k":["antakar","hot","j","pas","yathabhut"]},{"l":"Kaṅkhī hotī","g":"Buddhadhammasaṁghaguṇesu ceva sikkhāya ca pubbante ca aparante ca pubbantāparante ca paṭicca samuppāde cāti aṭṭhasu ṭhānesu kaṅkhāya samannāgato hoti.","v":"18AnA02","n":184,"p":358,"s":"Abhayasuttavaṇṇanā","w":2,"k":["hot","kankh"]},{"l":"Anuddayāya anukampāya paṭipanno hotī","g":"anuddayatthāya ca anukampatthāya ca yā paṭipadā, taṁ paṭipanno hoti, pūretvā ṭhitoti attho.","v":"18AnA02","n":185,"p":359,"s":"Brāhmaṇasaccasuttavaṇṇanā","w":4,"k":["anudayay","anukampay","hot","patip"]},{"l":"Dhammānudhammappaṭipanno hotī","g":"lokuttaradhammassa anucchavikadhammaṁ saha sīlena pubbabhāgappaṭipadaṁ paṭipanno hoti.","v":"18AnA02","n":186,"p":360,"s":"Ummaggasuttavaṇṇanā","w":2,"k":["dhamanudhamapatip","hot"]},{"l":"Anupapādento gārayho hotī","g":"kusalaṁ dhammaṁ uppādetuṁ asakkonto attano ca vacanaṁ upapannaṁ anucchavikaṁ kātuṁ asakkonto gārayho hoti.","v":"18AnA02","n":188,"p":362,"s":"Upakasuttavaṇṇanā","w":3,"k":["anupapadent","garayh","hot"]},{"l":"Evaṁ kho bhikkhave bhikkhu devappatto hotī","g":"evaṁ rūpāvacaracatutthajjhāne ṭhatvā cittaṁ vivaṭṭetva arahattaṁ patto devappatto nāma hoti, catūsu brahmavihāresu ṭhatvā cittaṁ vivaṭṭetvā arahattaṁ patto brahmappatto nāma, catūsu arūpajjhānesu ṭhatvā cittaṁ vivaṭṭetvā arahattaṁ patto āneyyañjappatto nāma.","v":"18AnA02","n":190,"p":363,"s":"Uposathasuttavaṇṇanā","w":6,"k":["bhikh","bhikhav","devapat","ev","hot","kh"],"h":1},{"l":"Neva sumano hotī","g":"iṭṭhārammaṇe rāgavasena na somanassajāto hoti.","v":"18AnA02","n":195,"p":367,"s":"Vappasuttavaṇṇanā","w":3,"k":["hot","nev","s"]},{"l":"sammāsamādhi hotī","g":"maggasamādhinā ca phalasamādhinā ca samāhito hotīti ayamettha attho.","v":"18AnA02","n":196,"p":370,"s":"Sāḷhasuttavaṇṇanā","w":2,"k":["hot","samasamadh"]},{"l":"Na dātā hotī","g":"na dāyikā hoti.","v":"18AnA02","n":197,"p":372,"s":"Mallikādevīsuttavaṇṇanā","w":3,"k":["","dat","hot"]},{"l":"So santuṭṭho hotī","g":"svāyaṁ bhikkhu heṭṭhā vuttena catūsu paccayesu dvādasavidhena itarītarapaccayasantosena samannāgato hoti.","v":"18AnA02","n":198,"p":373,"s":"Attantapasuttavaṇṇanā","w":3,"k":["hot","s","santuth"]},{"l":"Sampajānakārī hotī","g":"sātthakasampajaññaṁ sappāyasampajaññaṁ gocarasampajaññaṁ asammohasampajaññanti imesaṁ catunnaṁ satisampayuttānaṁ sampajaññānaṁ vasena satiṁ upaṭṭhapetvā ñāṇena paricchinditvāyeva tāni abhikkantapaṭikkantāni karoti.","v":"18AnA02","n":198,"p":373,"s":"Attantapasuttavaṇṇanā","w":2,"k":["hot","sampajanakar"]},{"l":"Santi hotī","g":"evamādīsu ahaṁ siyanti hotīti evamattho veditabbo.","v":"18AnA02","n":199,"p":385,"s":"Taṇhāsuttavaṇṇanā","w":2,"k":["hot","sant"]},{"l":"Ajjhattaṁyeva sati sūpaṭṭhiyā hotī","g":"niyakajjhatteyeva sati suṭṭhu upaṭṭhitā hoti.","v":"18AnA02","n":245,"p":394,"s":"Sikkhānisaṁsasuttavaṇṇanā","w":4,"k":["ajhatamyev","hot","sat","supathiy"]},{"l":"Anattamano hotī","g":"tejussadattā sīho migarājā dve purimapāde ekasmiṁ, pacchimapāde ekasmiṁ ṭhāne ṭhapetvā naṅguṭṭhaṁ antarasatthimhi pakkhipitvā purimapādapacchimapādanaṅguṭṭhānaṁ ṭhitokāsaṁ sallakkhetvā dvinnaṁ purimapādānaṁ matthake sīsaṁ ṭhapetvā sayati.","v":"18AnA02","n":246,"p":395,"s":"Seyyāsuttavaṇṇanā","w":2,"k":["anat","hot"]},{"l":"Nānappakārappaṭivedhasamattho hotī","g":"etena vakkhamānassa suttassa nānappakārataṁ duppaṭivijjhatañca dasseti.","v":"18AnT01","n":1,"p":23,"s":null,"w":2,"k":["hot","nanapakarapativedhasamath"]},{"l":"Suttanikkhepaṁ vicāretvāva vuccamānā pākaṭā hotī","g":"sāmaññato bhagavato desanāya samuṭṭhānassa vibhāgaṁ dassetvā “etthāyaṁ desanā evaṁsamuṭṭhānā”ti desanāya samuṭṭhāne dassite suttassa sammadeva nidānaparijānanena vaṇṇanāya suviññeyyattā vuttaṁ.","v":"18AnT01","n":1,"p":23,"s":null,"w":5,"k":["hot","pakat","sutanikhep","vicaretvav","vuc"]},{"l":"ayaṁ na sabbāsaṁ hotī","g":"Tiracchānagatāya itthiyā ekaccāya ca manussitthiyā sarīragandhassa ativiya assādetabbabhāvadassanato puna tampi avisesena anujānanto “","v":"18AnT01","n":3,"p":70,"s":null,"w":4,"k":["","ay","hot","sabas"],"t":1,"q":1,"h":1},{"l":"Dhutaṅgadharo hotī","g":"vuttamevatthaṁ pakāseti “","v":"18AnT01","n":10,"p":72,"s":null,"w":2,"k":["dhutangadhar","hot"],"t":1},{"l":"upanissayakoṭiyā pana hotī","g":"vuttaṁ, upanissayakoṭiyā paccayo hotīti attho.","v":"18AnT01","n":13,"p":76,"s":null,"w":3,"k":["hot","p","upanisayakotiy"],"q":1},{"l":"suttante rakkhite sante, paṭipatti hoti rakkhitā","g":"iminā vacanena paṁsukūlikatthere appaṭibhāne akaṁsu.","v":"18AnT01","n":130,"p":118,"s":null,"w":6,"k":["hot","patipat","rakhit","rakhit","sant","sutant"],"q":1},{"l":"niccaṁ na hotī","g":"abhiṇhappavattikaṁ na hoti kadācideva sambhavato.","v":"18AnT01","n":172,"p":136,"s":null,"w":3,"k":["","hot","nic"]},{"l":"Pātubhāvo hotī","g":"tathāgatassa pātubhāvā tappaṭibaddhattā tabbisayattā ca pātubhāvo hoti.","v":"18AnT01","n":175,"p":138,"s":null,"w":2,"k":["hot","patubhav"]},{"l":"Sacchikiriyā hotī","g":"paccakkhakaraṇaṁ hoti.","v":"18AnT01","n":175,"p":138,"s":null,"w":2,"k":["hot","sachikiriy"]},{"l":"rūpāvacare paṭisandhi nāma na hotī","g":"bodhisambhārasambharaṇassa anokāsabhāvato vuttaṁ.","v":"18AnT01","n":188,"p":142,"s":null,"w":5,"k":["","","hot","patisandh","rupavacar"]},{"l":"Avitakkena dutiyajjhānena ābhassarūpago hotī","g":"so puggalo tathā katvā paṭiladdhena dutiyena jhānena ābhassarabrahmalokūpago hoti.","v":"18AnT01","n":188,"p":142,"s":null,"w":4,"k":["abhasarupag","avitak","dutiyajh","hot"]},{"l":"Pākaṭova hotī","g":"satipaññāvepullappattito pākaṭo vibhūto hoti.","v":"18AnT01","n":188,"p":142,"s":null,"w":2,"k":["hot","pakatov"]},{"l":"Puthujjanasseva taṁ dinnaṁ hotī","g":"etthāyamadhippāyo–yathā vadhakacetanā paccuppannārammaṇāpi pabandhavicchedanavasena jīvitindriyaṁ ārammaṇaṁ katvā pavattati, na evaṁ cāgacetanā.","v":"18AnT01","n":275,"p":212,"s":null,"w":4,"k":["d","hot","puthujanasev","t"]},{"l":"Bhedo ca hotī","g":"saṁghassa bhedo ca hoti.","v":"18AnT01","n":275,"p":212,"s":null,"w":3,"k":["bhed","c","hot"]},{"l":"Duvidhaṁ hotī","g":"payojanavasena duvidhaṁ hoti.","v":"18AnT01","n":296,"p":222,"s":null,"w":2,"k":["duvidh","hot"]},{"l":"Ayaṁ tividhā saggāvaraṇā ceva hotī","g":"kammapathappattiyā mahāsāvajjabhāvato vuttaṁ.","v":"18AnT01","n":304,"p":225,"s":null,"w":5,"k":["ay","cev","hot","sagavar","tividh"]},{"l":"Satthā ca sabbaññū hotī","g":"asabbaññuno niyyānikabhāvena kathetuṁ asakkuṇeyyattā.","v":"18AnT01","n":313,"p":229,"s":null,"w":4,"k":["c","hot","sab","sath"]},{"l":"Cakkhubhūto hotī","g":"mahājanassa cakkhu viya hoti.","v":"18AnT01","n":315,"p":230,"s":null,"w":2,"k":["cakhubhut","hot"]},{"l":"kathaṁ anuppannānaṁ -pa- ṭhitiyā bhāvanā hotī","g":"pucchati.","v":"18AnT01","n":394,"p":239,"s":null,"w":6,"k":["anup","bhav","hot","kath","p","thitiy"],"q":1},{"l":"Subhantveva adhimutto hotī","g":"ayaṁ tatiyavimokkho idha suparisuddhanīlādivaṇṇakasiṇajjhānavasena vuttoti dassetvā idāni paṭisambhidāpāḷiyaṁ tassa brahmavihārajjhānavasena āgatabhāvaṁ dassetuṁ “","v":"18AnT01","n":435,"p":269,"s":null,"w":3,"k":["adhimut","hot","subhantvev"],"t":1},{"l":"Neva sumano hoti na dummano","g":"iṭṭhārammaṇe rāgasahagatena somanassena sumano vā aniṭṭhārammaṇe dosasahagatena domanassena dummano vā na hoti.","v":"19AnA03","n":1,"p":87,"s":"Paṭhama-āhuneyyasuttavaṇṇanā","w":5,"k":["","d","hot","nev","s"]},{"l":"Vimokkho hoti cetaso","g":"tassa imehi balehi samannāgatassa khīṇāsavassa dīpanibbānaṁ viya carimakacittassa vatthārammaṇehi vimokkho hoti, gataṭṭhānaṁ na paññāyati.","v":"19AnA03","n":1,"p":145,"s":null,"w":3,"k":["cetas","hot","vimokh"]},{"l":"saddho hotī","g":"pañcakanipāte vaṇṇitāneva.","v":"19AnA03","n":1,"p":145,"s":null,"w":2,"k":["hot","sadh"],"h":1},{"l":"Kusalī tena hotī","g":"tena mettāyanena kusalo hoti.","v":"19AnA03","n":1,"p":193,"s":"Mettāsuttavaṇṇanā","w":3,"k":["hot","kusal","t"]},{"l":"Vuddho hotī","g":"mahallako hoti.","v":"19AnA03","n":7,"p":2,"s":"Kāmasuttavaṇṇanā","w":2,"k":["hot","vudh"]},{"l":"Saddhāya akataṁ hotī","g":"yaṁ saddhāya kusalesu dhammesu kātuṁ yuttaṁ, taṁ na kataṁ hoti.","v":"19AnA03","n":7,"p":2,"s":"Kāmasuttavaṇṇanā","w":3,"k":["akat","hot","sadhay"]},{"l":"ājānīyajhāyitaṁ hotī","g":"kathaṁ kāraṇākāraṇaṁ jānantassa sindhavassa jhāyitaṁ hoti.","v":"19AnA03","n":9,"p":343,"s":"Saddhasuttavaṇṇanā","w":2,"k":["ajaniyajhayit","hot"]},{"l":"Pathaviyaṁ pathavisaññā vibhūtā hotī","g":"pathavārammaṇe uppannā catukkapañcakajjhānasaññā vibhūtā pākaṭā hoti.","v":"19AnA03","n":9,"p":343,"s":"Saddhasuttavaṇṇanā","w":4,"k":["hot","pathavis","pathaviy","vibhut"]},{"l":"Nātidūraṁ hoti nāccāsannan","g":"yañhi atidūre hoti, piṇḍāya caritvā tattha gacchantassa kāyacittadaratho hoti, tato anuppannaṁ vā samādhiṁ uppādetuṁ uppannaṁ vā thiraṁ kātuṁ na sakkoti.","v":"19AnA03","n":11,"p":289,"s":"Senāsanasuttavaṇṇanā","w":3,"k":["hot","nacas","natidur"]},{"l":"Nisinno hotī","g":"sesarājūnaṁ parisāya antarantare āsanāni paññāpayiṁsu, Sīhassa pana majjhe ṭhāneti tasmiṁ paññatte mahārahe rājāsane nisinno hoti.","v":"19AnA03","n":12,"p":208,"s":"Sīhasuttavaṇṇanā","w":2,"k":["hot","nis"]},{"l":"Sādhu hotī","g":"sundaro hoti.","v":"19AnA03","n":12,"p":208,"s":"Sīhasuttavaṇṇanā","w":2,"k":["hot","sadh"]},{"l":"Tassaṁ disāyaṁ jāto hotī","g":"tassaṁ Sindhunadītīradisāyaṁ jāto hoti.","v":"19AnA03","n":13,"p":215,"s":"Assājānīyasuttavaṇṇanā","w":4,"k":["disay","hot","jat","tas"]},{"l":"Paṭigādhappatto hotī","g":"uṭṭhāya viloketvā pataritvā ekasmiṁ ṭhāne patiṭṭhāpatto nāma hoti, tiṭṭhati na punāgacchati.","v":"19AnA03","n":15,"p":148,"s":"Udakūpamāsuttavaṇṇanā","w":2,"k":["hot","patigadhapat"]},{"l":"Manussānaṁ piyo hotī","g":"ure āmukkamuttāhāro viya sīse piḷandhitamālā viya ca manussānaṁ piyo hoti manāpo.","v":"19AnA03","n":15,"p":345,"s":"Mettasuttavaṇṇanā","w":3,"k":["hot","manus","piy"]},{"l":"Amanussānaṁ piyo hotī","g":"yatheva manussānaṁ, amanussānampi piyo hoti Visākhatthero viya.","v":"19AnA03","n":15,"p":345,"s":"Mettasuttavaṇṇanā","w":3,"k":["amanus","hot","piy"]},{"l":"Suvaco hotī","g":"sukhena vattabbo hoti, sukhena anusāsitabbo.","v":"19AnA03","n":17,"p":290,"s":"Paṭhamanāthasuttavaṇṇanā","w":2,"k":["hot","suvac"]},{"l":"Na rūpaññū hotī","g":"gaṇanato vā vaṇṇato vā rūpaṁ na jānāti.","v":"19AnA03","n":17,"p":348,"s":"Gopālasuttavaṇṇanā","w":3,"k":["","hot","rup"]},{"l":"Na vaṇaṁ paṭicchādetā hotī","g":"gunnaṁ vuttanayeneva sañjāto vaṇo1 bhesajjaṁ datvā vākena vā cīrakena vā bandhitvā paṭicchādetabbo hoti.","v":"19AnA03","n":17,"p":348,"s":"Gopālasuttavaṇṇanā","w":4,"k":["","hot","patichadet","v"]},{"l":"Na dhūmaṁ kattā hotī","g":"antovasse ḍaṁsamakasādīnaṁ ussannakāle gogaṇe vajaṁ paviṭṭhe tattha tattha dhūmo kātabbo hoti.","v":"19AnA03","n":17,"p":348,"s":"Gopālasuttavaṇṇanā","w":4,"k":["","dh","hot","kat"]},{"l":"Na gocarakusalo hotī","g":"gopālakena hi gocarakusalena bhavitabbaṁ, pañcāhikacāro vā sattāhikacāro vā jānitabbo.","v":"19AnA03","n":17,"p":348,"s":"Gopālasuttavaṇṇanā","w":3,"k":["","gocarakusal","hot"]},{"l":"Anavasesadohī ca hotī","g":"paṇḍitagopālakena hi yāva vacchakassa maṁsalohitaṁ saṇṭhāti, tāva ekaṁ dve thane ṭhapetvā sāvasesadohinā bhavitabbaṁ.","v":"19AnA03","n":17,"p":348,"s":"Gopālasuttavaṇṇanā","w":3,"k":["anavasesadoh","c","hot"]},{"l":"Na rūpaññū hotī","g":"“cattāri mahābhūtāni catunnañca mahābhūtānaṁ upādāyarūpan”ti evaṁ vuttaṁ rūpaṁ dvīhākārehi na jānāti gaṇanato vā samuṭṭhānato vā.","v":"19AnA03","n":17,"p":348,"s":"Gopālasuttavaṇṇanā","w":3,"k":["","hot","rup"]},{"l":"Na lakkhaṇakusalo hotī","g":"“kammalakkhaṇo bālo, kammalakkhaṇo paṇḍito”ti evaṁ vuttaṁ kusalākusalakammaṁ paṇḍitabālalakkhaṇanti na jānāti.","v":"19AnA03","n":17,"p":348,"s":"Gopālasuttavaṇṇanā","w":3,"k":["","hot","lakhanakusal"]},{"l":"Na āsāṭikaṁ hāretā hotī","g":"“uppannaṁ kāmavitakkan”ti evaṁ vutte kāmavitakkādayo na vinodeti.","v":"19AnA03","n":17,"p":348,"s":"Gopālasuttavaṇṇanā","w":4,"k":["","asatik","haret","hot"]},{"l":"Na vaṇaṁ paṭicchādetā hotī","g":"“cakkhunā rūpaṁ disvā nimittaggāhī hotī”ti-ādinā nayena sabbārammaṇesu nimittaṁ gaṇhanto yathā so gopālako vaṇaṁ na paṭicchādeti, evaṁ saṁvaraṁ na sampādeti.","v":"19AnA03","n":17,"p":348,"s":"Gopālasuttavaṇṇanā","w":4,"k":["","hot","patichadet","v"]},{"l":"Na dhūmaṁ kattā hotī","g":"so gopālako dhūmaṁ viya dhammadesanādhūmaṁ na karoti, dhammakathaṁ vā sarabhaññaṁ vā upanisinnakakathaṁ vā anumodanaṁ vā na karoti, tato naṁ manussā “bahussuto guṇavā”ti na jānanti.","v":"19AnA03","n":17,"p":348,"s":"Gopālasuttavaṇṇanā","w":4,"k":["","dh","hot","kat"]},{"l":"Na gocarakusalo hotī","g":"so gopālako pañcāhikasattāhikacāre viya cattāro satipaṭṭhāne “ime lokiyā, ime lokuttarā”ti yathābhūtaṁ nappajānāti.","v":"19AnA03","n":17,"p":348,"s":"Gopālasuttavaṇṇanā","w":3,"k":["","gocarakusal","hot"]},{"l":"Anavasesadohī hotī","g":"paṭiggahaṇe mattaṁ ajānanto anavasesaṁ duhati.","v":"19AnA03","n":17,"p":348,"s":"Gopālasuttavaṇṇanā","w":2,"k":["anavasesadoh","hot"]},{"l":"Te na atirekapūjāya pūjetā hotī","g":"so gopālako mahā-usabhe viya there bhikkhū imāya āvi ceva raho ca mettākāyakammādikāya atirekapūjāya na pūjeti.","v":"19AnA03","n":17,"p":348,"s":"Gopālasuttavaṇṇanā","w":5,"k":["","atirekapujay","hot","pujet","t"]},{"l":"Sikkhāsamādāne tibbacchando hotī","g":"sikkhāttayapūraṇe balavacchando hoti.","v":"19AnA03","n":20,"p":150,"s":"Niddasavatthusuttavaṇṇanā","w":3,"k":["hot","sikhasamad","tibachand"]},{"l":"nisinno hotī","g":"uposathakaraṇatthāya upāsikāya ratanapāsāde nisinno.","v":"19AnA03","n":20,"p":221,"s":"Uposathasuttavaṇṇanā","w":2,"k":["hot","nis"]},{"l":"Evaṁ kho bhikkhave bhikkhu chaḷaṅgasamannāgato hotī","g":"chaḷaṅgupekkhāya samannāgato hoti.","v":"19AnA03","n":20,"p":292,"s":"Dutiya-ariyāvāsasuttavaṇṇanā","w":6,"k":["bhikh","bhikhav","chalangasamanagat","ev","hot","kh"]},{"l":"Idamassa hoti sīhanādasmin","g":"ayamassa sīhanādo.","v":"19AnA03","n":21,"p":293,"s":"Sīhanādasutt