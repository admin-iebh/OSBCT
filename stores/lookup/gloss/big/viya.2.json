ay","vath","viy"]},{"l":"Piyaṅkaramātādīnaṁ viyā","g":"piyaṅkaramātā kira yakkhinī paccūsasamaye anuruddhattherassa dhammaṁ sajjhāyato sutvā– “Mā saddamakarī piyaṅkara, bhikkhu dhammapadāni bhāsati. Api dhammapadaṁ vijāniya, paṭipajjema hitāya no siyā. Pāṇesu ca saṁyamāmase, sampajānamusā na bhaṇāmase. Sikkhema susīlyamattano, api muccema pisācayoniyā”ti1– evaṁ puttakaṁ saññāpetvā taṁ divasaṁ sotāpattiphalaṁ pattā.","v":"20AnT03","n":44,"p":167,"s":"Sattaviññāṇaṭṭhitisuttavaṇṇanā","w":2,"k":["piyankaramatad","viy"]},{"l":"Yuttayānaṁ viya katā","g":"yathā yuttamājaññayānaṁ chekena sārathinā adhiṭṭhitaṁ yathāruci pavattati, evaṁ yathāruci pavattirahataṁ gamitā.","v":"20AnT03","n":70,"p":251,"s":"Bhūmicālasuttavaṇṇanā","w":3,"k":["kat","viy","yutay"]},{"l":"Vatthu viya katā","g":"sabbaso upakkilesavisodhanena iddhivisayatāya1 patiṭṭhānabhāvato suvisodhitaparissayavatthu viya katā.","v":"20AnT03","n":70,"p":251,"s":"Bhūmicālasuttavaṇṇanā","w":3,"k":["kat","vath","viy"]},{"l":"Pariyāyanaṁ viyā","g":"parito aparāparaṁ yāyanaṁ viya.","v":"20AnT03","n":71,"p":194,"s":"Bhāvanāsuttavaṇṇanā","w":2,"k":["pariyay","viy"]},{"l":"Haranti viyā","g":"saṁharanti viya vighātuppādanena.","v":"20AnT03","n":99,"p":352,"s":"Uttiyasuttavaṇṇanā","w":2,"k":["harant","viy"]},{"l":"ghasanti viyā","g":", bhayasantāsuppādanena khādituṁ āgatā yakkharakkhasapisācādayo viyāti adhippāyo.","v":"20AnT03","n":99,"p":352,"s":"Uttiyasuttavaṇṇanā","w":2,"k":["ghasant","viy"],"q":1},{"l":"Cakkhu viya bhūto","g":"dassanapariṇāyakaṭṭhena cakkhu viya bhūto.","v":"20AnT03","n":113,"p":353,"s":null,"w":3,"k":["bhut","cakh","viy"]},{"l":"Bodhisattamātā viya puttapaṭilābhanimittan","g":"tadā kira pure puṇṇamāya sattamadivasato paṭṭhāya vigatasurāpānaṁ mālāgandhādivibhūtisampannaṁ nakkhattakīḷaṁ anubhavamānā bodhisattamātā sattame divase pātova uṭṭhāya gandhodakena nahāyitvā sabbālaṅkārabhūsitā varabhojanaṁ bhuñjitvā uposathaṅgāni adhiṭṭhāya sirigabbhaṁ pavisitvā sirisayane nipannāniddaṁ okkamamānā imaṁ supinaṁ addasa–cattāro kira naṁ mahārājāno sayaneneva saddhiṁ ukkhipitvā anotattadahaṁ netvā nahāpetvā dibbavatthaṁ nivāsetvā dibbagandhehi vilimpetvā dibbapupphāni piḷandhetvā tato avidūre rajatapabbato, tassa anto kanakavimānaṁ atthi, tasmiṁ pācīnato sīsaṁ katvā nipajjāpesuṁ.","v":"20AnT03","n":196,"p":61,"s":"Mahāsupinasuttavaṇṇanā","w":3,"k":["bodhisatamat","putapatilabhanimit","viy"]},{"l":"Kosalarājā viya soḷasa supine","g":"– “Usabhā rukkhā gāviyo gavā ca, Asso kaṁso siṅgālī ca kumbho. Pokkharaṇī ca apākacandanaṁ, Lābūni sīdanti silā plavanti. Maṇḍūkiyo kaṇhasappe gilanti, Kākaṁ suvaṇṇā parivārayanti. Tasā vakā eḷakānaṁ bhayā hī”ti1– ime soḷasa supine passanto kosalarājā viya.","v":"20AnT03","n":196,"p":61,"s":"Mahāsupinasuttavaṇṇanā","w":4,"k":["kosalaraj","solas","sup","viy"]},{"l":"taṁ mahogho parittaṁ udakaṁ viyā","g":"Ito paraṁ sabbattha uttānameva.","v":"20AnT03","n":211,"p":356,"s":null,"w":5,"k":["mahogh","parit","t","udak","viy"],"q":1,"h":1},{"l":"ayaṁ gāthā viyā","g":"“kāmandhā jālasañchannā, manopubbaṅgamā dhammā, uddhaṁ adho sabbadhi vippamutto, yassa selūpamaṁ cittan”ti- ādinā idha udāhaṭagāthā viya.","v":"21KhuT01","n":89,"p":128,"s":null,"w":3,"k":["ay","gath","viy"]},{"l":"sattiyā viya omaṭṭho","g":"Devaputta sattiyā omaṭṭho puriso sattippahānāya vīriyaṁ ārabhati viya, agginā matthake ḍayhamāno ādittasiro puriso agginibbāpanatthāya vīriyaṁ ārabhati iva, evaṁ sakkāyadiṭṭhiyā abhibhūto bhikkhu sakkāyadiṭṭhiyā pahānāya maggena samucchedappahānāya appamatto vāyamamāno sato satisampanno hutvā paribbaje vihareyyāti bhagavā avocāti yojanā.","v":"21KhuT01","n":101,"p":299,"s":"Nayehi tīhi niddise suttan”ti1–","w":3,"k":["omath","satiy","viy"],"q":1,"h":1},{"l":"Mahācorasamo viyā","g":"kāyasārāgavasena duccaritānesanehi kusalabhaṇḍacchedanā.","v":"22AbhiT01","n":null,"p":24,"s":null,"w":2,"k":["mahacoras","viy"]},{"l":"Suvaṇṇavisuddhi viyā","g":"yathā suvaṇṇavisuddhi alaṅkāravikativiniyogakkhamā, evaṁ ayampi hitakiriyāviniyogakkhamā.","v":"22AbhiT01","n":null,"