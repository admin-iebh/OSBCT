{"n":3031,"pages":26,"page":21,"rows":[{"l":"Chandasā vā dhanena vā","g":"attano vā chandena ruciyā pemena, bhativasena laddhadhanena vā yaṁ purisaṁ etā itthiyo upasevanti bhajanti.","v":"37KhuA18","n":36,"p":295,"s":null,"w":4,"k":["chandas","dh","v","v"]},{"l":"Cirappavutthā atha vā na te ime","g":"kiṁ nu kho ime ciraṁ vippavasitvā dīghassa addhuno accayena āgatattāmaṁ “soyeva ayan”ti na sañjānanti, udāhu ye amhesu abhinibbutacittā5, na te ime, aññeva āgantukapakkhino, ime kena6 maṁ na upasaṅkamantīti pucchati.","v":"37KhuA18","n":80,"p":343,"s":null,"w":6,"k":["","","ath","cirapavuth","t","v"]},{"l":"Bhayā ukkaṁsayanti vā","g":"imassa gāhassa vissaṭṭhapaccayā tumhākaṁ idañcidañca bhayaṁ uppajjissati, mā vissajjayittha, na ete bāhusaccakulaparivārādīhi tumhe sampāpuṇantīti evaṁ vissajjanapaccayā bhayaṁ dassetvā ukkhipanti.","v":"37KhuA18","n":87,"p":349,"s":null,"w":3,"k":["bhay","ukamsayant","v"]},{"l":"Sukhena vā dukkhan","g":"jhānasukhena vā taṁ dukkhaṁ panuditvā.","v":"38KhuA19","n":12,"p":13,"s":null,"w":3,"k":["dukh","sukh","v"]},{"l":"Jātiyā vinayena vā","g":"“ayaṁ khattiyo brāhmaṇo”ti vā “sīlavā bahussuto guṇasampanno”ti vā evaṁ yattha jātiyā vinayena vā na jānantīti attho.","v":"38KhuA19","n":16,"p":16,"s":null,"w":3,"k":["jatiy","v","vinay"]},{"l":"Kā vā tvan","g":"“kā ca tvaṁ, ayameva vā pāṭho. Taṁ sutvā Kāḷakaṇṇī dutiyaṁ gāthamāha–","v":"38KhuA19","n":40,"p":243,"s":null,"w":3,"k":["k","tv","v"],"t":1},{"l":"Yuvā sapati hanti vā","g":"taruṇadārako akkosatipi paharatipi.","v":"38KhuA19","n":48,"p":36,"s":null,"w":4,"k":["hant","sapat","v","yuv"]},{"l":"sutaṁ vā diṭṭhaṁ vā","g":"mayā ito pubbe evarūpaṁ diṭṭhaṁ vā sutaṁ vā natthi.","v":"38KhuA19","n":53,"p":172,"s":null,"w":4,"k":["dith","sut","v","v"]},{"l":"sutaṁ vā diṭṭhaṁ vā","g":"mayā ito pubbe evarūpaṁ diṭṭhaṁ vā sutaṁ vā natthi.","v":"38KhuA19","n":53,"p":172,"s":null,"w":4,"k":["dith","sut","v","v"]},{"l":"Maṁsāni vā yānī","g":"yāni vā susānamajjhe maṁsāni, tehi na tussasi.","v":"38KhuA19","n":77,"p":497,"s":null,"w":3,"k":["mams","v","y"]},{"l":"ayaṁ vā","g":"vibhāvanatthe vā-saddo.","v":"38KhuA19","n":106,"p":368,"s":null,"w":2,"k":["ay","v"]},{"l":"migassa vā","g":"imasmiṁ ṭhāne sabbepi tiracchānā “migā”ti vuttā.","v":"38KhuA19","n":108,"p":368,"s":null,"w":2,"k":["migas","v"]},{"l":"Kāle akāle vā","g":"3 vattuṁ yuttakāle ca akāle ca vācaṁ rakkheyya, ativelaṁ na bhāseyya api attanā same ninnānākaraṇepi puggaleti attho.","v":"38KhuA19","n":124,"p":95,"s":null,"w":3,"k":["akal","kal","v"]},{"l":"Nāṅgaputtapinena vā","g":"1 aṅgasarikkhakena vā puttapinenapi2 na pamocito.","v":"38KhuA19","n":127,"p":205,"s":null,"w":2,"k":["nangaputap","v"]},{"l":"Nayīdha naccagītaṁ vā","g":"3 imasmiṁ ṭhāne kassaci naccantassa naccaṁ vā gāyantassa gītaṁ vā hatthe susamāhite katvā vādentassa susamāhitaṁ hatthatālaṁ vā natthi, kaṁ4 disvā tvaṁ haseyyāsīti dīpeti.","v":"38KhuA19","n":130,"p":208,"s":null,"w":3,"k":["nacagit","nayidh","v"]},{"l":"Tadā hi calitā sākhā manussena migena vā","g":"na paññāyati, tasmā tato maṁ bhayaṁ āgamissati.","v":"38KhuA19","n":154,"p":397,"s":null,"w":7,"k":["calit","h","manus","mig","sakh","tad","v"]},{"l":"mano vā","g":"manodvāraṁ vā.","v":"39KhuA20","n":23,"p":14,"s":null,"w":2,"k":["","v"]},{"l":"Sarīraṁ vā","g":"kāyadvāraṁ vā, vacīdvārampi etesaṁ gahaṇena gahitamevāti veditabbaṁ.","v":"39KhuA20","n":23,"p":14,"s":null,"w":2,"k":["sarir","v"]},{"l":"Dhanena vā","g":"koṭisatasaṅkhyenapi dhanena vā.","v":"39KhuA20","n":174,"p":87,"s":null,"w":2,"k":["dh","v"]},{"l":"santaṁ vā yadi vā asan","g":"sappurisaṁ vā asappurisaṁ vā.","v":"39KhuA20","n":185,"p":438,"s":null,"w":5,"k":["as","sant","v","v","yad"]},{"l":"santaṁ vā yadi vā asan","g":"sappurisaṁ vā asappurisaṁ vā.","v":"39KhuA20","n":185,"p":438,"s":null,"w":5,"k":["as","sant","v","v","yad"]},{"l":"suddhī vā","g":"mahārāja aññatra manussalokā amatamahānibbānasaṅkhātā suddhi vā sīlasaṁyamo vā natthi.","v":"39KhuA20","n":278,"p":470,"s":null,"w":2,"k":["sudh","v"]},{"l":"Ko vā jānāti kiñcanan","g":"ko vā etassa palibodhakāraṇaṁ jānātīti attho.","v":"39KhuA20","n":288,"p":473,"s":null,"w":4,"k":["janat","k","kinc","v"]},{"l":"Kissa vā","g":"kissa vā kāraṇā idhāgatāsīti pucchati.","v":"40KhuA21","n":10,"p":4,"s":null,"w":2,"k":["kis","v"]},{"l":"Rūpapaṭṭapalimaṭṭhī vā","g":"suṭṭhu parimajjitakañcanapaṭṭasadisī.","v":"40KhuA21","n":10,"p":4,"s":null,"w":2,"k":["rupapatapalimath","v"]},{"l":"gacche vā","g":"mahārāja ahaṁ ito gaccheyyaṁ vā na vā, nāhaṁ tena gamanena vā agamanena vā amaro siyaṁ, ahañhi ito gatopi agatopi maraṇato amuttova, ito pubbe pana sukhitaṁ taṁ upāsitvā idāni dukkhitaṁ taṁ kathaṁ jaheyyanti vadati.","v":"40KhuA21","n":24,"p":362,"s":null,"w":2,"k":["gach","v"]},{"l":"Maraṇaṁ vā","g":"mama agacchantassa vā tayā saddhiṁ maraṇaṁ bhaveyya, gacchantassa vā tayā vinā jīvitaṁ.","v":"40KhuA21","n":24,"p":362,"s":null,"w":2,"k":["mar","v"]},{"l":"Kissa vā niviṭṭho","g":"kena nāma kāraṇena tasmiṁ mātugāme mittasaññāya niviṭṭho, so migiyā kucchismiṁ nibbattitvā araññe vaḍḍhitattā “kutomhi āgato”ti attano āgataṭṭhānamattampi na jānāti, pageva ñātimitteti.","v":"40KhuA21","n":56,"p":219,"s":null,"w":3,"k":["kis","nivith","v"]},{"l":"Dārukaṭallako vā","g":"dārumayayantarūpakaṁ viya.","v":"40KhuA21","n":59,"p":19,"s":null,"w":2,"k":["darukatalak","v"]},{"l":"Ciraṁ passeyya vā","g":"idheva vasāpetvā muhuttampi avippavāsanto ciraṁ tumhe passeyyanti esa me chandoti vadati.","v":"40KhuA21","n":80,"p":374,"s":null,"w":3,"k":["cir","pasey","v"]},{"l":"Ko vā tvan","g":"idaṁ tassā itthibhāvaṁ jānanto6 purisavohāravasena pucchati.","v":"40KhuA21","n":119,"p":166,"s":null,"w":3,"k":["k","tv","v"]},{"l":"Kissa vā","g":"kissa hetu kena kāraṇena, kiṁ nāma tava mayā saddhiṁ veranti adhippāyo.","v":"40KhuA21","n":124,"p":52,"s":null,"w":2,"k":["kis","v"]},{"l":"Kassa vā","g":"kassa vā aññassa ayaṁ payogo, kena payojito maṁ avadhīti attho.","v":"40KhuA21","n":124,"p":52,"s":null,"w":2,"k":["kas","v"]},{"l":"Dosā vā","g":"duṭṭhacittatāya vā.","v":"40KhuA21","n":132,"p":287,"s":null,"w":2,"k":["dos","v"]},{"l":"Jeṭṭhaṁ vā","g":"sāmikassa jeṭṭhabhātaraṁ.","v":"40KhuA21","n":132,"p":287,"s":null,"w":2,"k":["jeth","v"]},{"l":"Puna vā","g":"tathā karissāmi, yathā puna vā tādiso bhavissāmi, naṭṭhaṁ jhānaṁ uppādetvā vītarāgo bhavissāmi, maraṇaṁ vā me bhavissatīti.","v":"40KhuA21","n":135,"p":170,"s":null,"w":2,"k":["p","v"]},{"l":"Akaraṇīyaṁ vā karaṇīyaṁ vāpī","g":"akattabbaṁ pāpaṁ vā kattabbaṁ kusalaṁ vā.","v":"40KhuA21","n":141,"p":250,"s":null,"w":4,"k":["akaraniy","karaniy","v","vap"]},{"l":"Kicchaṁ vā so","g":"iti dhanaṁ vā tassa nassati, dukkhaṁ vā so puriso nigacchati.","v":"40KhuA21","n":183,"p":352,"s":null,"w":3,"k":["kich","s","v"]},{"l":"So’hitthiyā vā","g":"so ahaṁ itthiyā vā.","v":"40KhuA21","n":232,"p":423,"s":null,"w":2,"k":["so’hithiy","v"]},{"l":"Atha vā tvamevā","g":"udāhu tvaṁyeva.","v":"40KhuA21","n":266,"p":82,"s":null,"w":3,"k":["ath","tvamev","v"]},{"l":"Sahāyā vā","g":"suhadayamittā vā.","v":"40KhuA21","n":271,"p":83,"s":null,"w":2,"k":["sahay","v"]},{"l":"Āsīvisā vā riva sattusaṅghā","g":"2 ettha","v":"40KhuA21","n":278,"p":85,"s":null,"w":4,"k":["asivis","riv","satusangh","v"],"t":1},{"l":"vā","g":"nipātamattaṁ, āsīvisā sattusaṅghā rivāti3 attho.","v":"40KhuA21","n":278,"p":85,"s":null,"w":1,"k":["v"]},{"l":"Kā vā tvan","g":"kā nāma vā tvaṁ bhavasi.","v":"40KhuA21","n":298,"p":93,"s":null,"w":3,"k":["k","tv","v"]},{"l":"Khaṇaṁ vā raho vā","g":"pāpakaraṇatthāya okāsaṁ vā paṭicchannaṭṭhānaṁ vā.","v":"40KhuA21","n":310,"p":469,"s":null,"w":4,"k":["kh","rah","v","v"]},{"l":"Khaṇaṁ vā raho vā","g":"pāpakaraṇatthāya okāsaṁ vā paṭicchannaṭṭhānaṁ vā.","v":"40KhuA21","n":310,"p":469,"s":null,"w":4,"k":["kh","rah","v","v"]},{"l":"taṁ vā","g":"sā evaṁ aticarantī taṁ vā assabandhaṁ taṁ vā aggamahesiṭṭhānanti ubhayampi nājjhagā, ubhato bhaṭṭhā ahosi.","v":"40KhuA21","n":313,"p":480,"s":null,"w":2,"k":["t","v"]},{"l":"Chandasā vā","g":"piyasaṁvāsena vā.","v":"40KhuA21","n":350,"p":488,"s":null,"w":2,"k":["chandas","v"]},{"l":"Dhanena vā","g":"dhanahetu vā.","v":"40KhuA21","n":350,"p":488,"s":null,"w":2,"k":["dh","v"]},{"l":"sambhameyya raveyya vā","g":"bhameyya vā viraveyya vā.","v":"40KhuA21","n":363,"p":111,"s":null,"w":3,"k":["ravey","sambhamey","v"]},{"l":"Dhanena vā","g":"dhanahetu vā.","v":"40KhuA21","n":369,"p":492,"s":null,"w":2,"k":["dh","v"]},{"l":"Aḍḍharatte vā","g":"majjhimaratte vā.","v":"41KhuA22","n":320,"p":99,"s":null,"w":2,"k":["adharat","v"]},{"l":"Ratte vā","g":"pacchimaratte vā.","v":"41KhuA22","n":320,"p":99,"s":null,"w":2,"k":["rat","v"]},{"l":"Yena vā","g":"yena maggena gantvā yattha pāpakammantā vasanti, taṁ ṭhānaṁ sakkā daṭṭhuṁ, yena vā gantvā ye puññakammā narā vasanti, tesaṁ ṭhānaṁ1 sakkā daṭṭhuṁ, etesu dvīsu kena maggena taṁ nemi.","v":"41KhuA22","n":448,"p":130,"s":null,"w":2,"k":["v","y"]},{"l":"Kassa vā","g":"kena vā pesito tvaṁ idhāgatoti.","v":"41KhuA22","n":618,"p":264,"s":null,"w":2,"k":["kas","v"]},{"l":"raṭṭhaṁ vā","g":"ekaṁsena tayā jīvitaṁ vā raṭṭhaṁ vā cattaṁ.","v":"42KhuA23","n":787,"p":7,"s":null,"w":2,"k":["rath","v"]},{"l":"kismiṁ vā tvaṁ paratthaddho","g":"tvaṁ kismiṁ vā upatthaddho hutvā kiṁ nissayaṁ katvā uragaṁ āsīvisaṁ na apacāyasi jeṭṭhakaṁ akatvā avajānāsīti pucchati.","v":"42KhuA23","n":831,"p":26,"s":null,"w":4,"k":["kis","parathadh","tv","v"]},{"l":"pettikaṁ vā","g":"pitarā vā gahetvā khāditaṁ, attanā vā kataṁ iṇaṁ nāma hoti, kiṁ mama pitarā tava hatthato gahitaṁ atthi, udāhu mayā, kiṁ kāraṇā maṁ evaṁ bahuṁ dhanaṁ yācasīti.","v":"42KhuA23","n":876,"p":39,"s":null,"w":2,"k":["petik","v"]},{"l":"Atha vā no dāse sāvehī","g":"atha vā no asaddahanto sabbaseniyo sannipātetvā rāsimajjhe amhe dāse sāvehi, mayaṁ te dāsattaṁ paṭissuṇissāmāti.","v":"42KhuA23","n":992,"p":77,"s":null,"w":5,"k":["","ath","das","saveh","v"]},{"l":"Natthi deva pitaro vā","g":"deva ayyakapeyyakādayo vā natthi, tesu asantesu kuto mātā kuto pitā.","v":"42KhuA23","n":1191,"p":112,"s":null,"w":4,"k":["dev","nath","pitar","v"]},{"l":"santaṁ vā","g":"sappurisaṁ vā.","v":"