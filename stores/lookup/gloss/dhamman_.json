:null,"w":5,"k":["dh","p","v","y","y"]},{"l":"Ariyānaṁ dhamman","g":"cārittavārittabhedaṁ sīlācāraṁ.","v":"21KhuT01","n":90,"p":130,"s":null,"w":2,"k":["ariy","dh"]},{"l":"dhamman","g":"yaṁ kiñci kusalādidhammaṁ sutte jino deseti, tassa sutte jinena desitassa kusalādidhammassa yañca padaṭṭhānaṁ niddhāretabbaṁ, taṁ taṁ padaṭṭhānañcāti evaṁ vuttanayena yāva yattakā sabbe dhammā sutte jinena desitā, tatthakānaṁ sabbesaṁ dhammānaṁ yañca padaṭṭhānaṁ niddhāretabbaṁ, tassa ca padaṭṭhānassa yañca padaṭṭhānaṁ niddhāretabbaṁ, taṁ taṁ padaṭṭhānañca, iti evaṁ vuttanayena yāva yattakā sabbe padaṭṭhānadhammā niddhāretabbāva, tattakāni sabbāni dhammapadaṭṭhānāni yathānurūpaṁ niddhāretvā yena saṁvaṇṇanāvisesena kathitāni, eso saṁvaṇṇanāviseso “padaṭṭhāno hāro”ti niddiṭṭhoti atthayojanā.","v":"21KhuT01","n":4,"p":32,"s":null,"w":1,"k":["dh"]},{"l":"piyaṁ vā ñātiṁ, piyaṁ vā dhamman","g":"Tattha “","v":"21KhuT01","n":37,"p":184,"s":null,"w":6,"k":["dh","nat","piy","piy","v","v"],"t":1,"q":1,"h":1},{"l":"Kañci dhamman","g":"chandādīsu ekampi sahajātaṁ.","v":"22AbhiT01","n":429,"p":122,"s":"Suttantikadukamātikāpadavaṇṇanā","w":2,"k":["dh","kanc"]},{"l":"Hīnaṁ dhamman","g":"imaṁ dhammadesanaṁ Satthā Jetavane viharanto aññataraṁ daharabhikkhuṁ ārabbha kathesi.","v":"22KhuA03","n":null,"p":104,"s":null,"w":2,"k":["dh","h"]},{"l":"hīnaṁ dhamman","g":"pañcakāmaguṇaṁ dhammaṁ.","v":"22KhuA03","n":167,"p":105,"s":null,"w":2,"k":["dh","h"]},{"l":"Ekaṁ dhamman","g":"imaṁ dhammadesanaṁ Satthā Jetavane viharanto Ciñcamāṇavikaṁ ārabbha kathesi.","v":"22KhuA03","n":175,"p":115,"s":null,"w":2,"k":["dh","ek"]},{"l":"ekaṁ dhamman","g":"saccaṁ.","v":"22KhuA03","n":176,"p":119,"s":null,"w":2,"k":["dh","ek"]},{"l":"yaṁ yaṁ dhamman","g":"vuttanti dasseti, pacchimena “yaṁ yan”ti vacanena rūpādibhedadīpanatthanti.","v":"24AbhiT03","n":2,"p":180,"s":null,"w":3,"k":["dh","y","y"],"q":1,"h":1},{"l":"Upakārakaṁ dhamman","g":"paccayadhammaṁ āha.","v":"24AbhiT03","n":1,"p":239,"s":null,"w":2,"k":["dh","upakarak"]},